#!/bin/bash

# wsquashfs-launcher — Lance un jeu .wsquashfs sur machine physique ou Docker
#
# Modes de montage (sélection automatique) :
#   overlay  squashfuse + fuse-overlayfs — sauvegardes isolées dans SAVES_DIR
#   copy     squashfuse ou unsquashfs   — copie de travail persistante (cache)

# Aucun privilège requis (27/09) : squashfuse et fuse-overlayfs montent
# l'image en utilisateur (FUSE, comme les AppImage), et les fichiers
# root:root restrictifs des paquets Batocera se lisent tels quels —
# vérifié sur Blade Strangers (game/RConfig.exe, root rw-r-----). Lancé en
# utilisateur, tout (montages, Wine, sauvegardes) lui appartient ; plus de
# fichiers root dans les sauvegardes ni de dossiers de cache inaccessibles.
# Toujours utilisable sous sudo (frontends qui l'élèvent) : voir ci-dessous.
# Lancé par un simple "sudo" (sans -E) : sudo remet HOME=/root et efface
# XDG_RUNTIME_DIR/WAYLAND_DISPLAY — montages et sauvegardes partaient dans
# /root, inaccessible à Wine relancé en utilisateur ("wine: cannot use
# directory /root/.cache/wsquashfs/…: Permission denied", 26/09). On repart
# de l'utilisateur d'origine (SUDO_USER) ; une valeur conservée par sudo -E
# n'est jamais remplacée.
if [[ "${EUID}" -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    _sudo_home=$(getent passwd "${SUDO_USER}" | cut -d: -f6)
    if [[ -n "${_sudo_home}" && "${HOME:-/root}" == "/root" ]]; then
        export HOME="${_sudo_home}"
    fi
    _sudo_runtime="/run/user/$(id -u "${SUDO_USER}")"
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "${_sudo_runtime}" ]]; then
        export XDG_RUNTIME_DIR="${_sudo_runtime}"
    fi
    if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/wayland-0" ]]; then
        export WAYLAND_DISPLAY=wayland-0
    fi
    unset _sudo_home _sudo_runtime
fi

# Pile limitée à 8 Mo si elle est illimitée (30/09) — cas de Docker sur
# Unraid. Pile illimitée, Linux passe à la disposition mémoire « legacy »
# (bibliothèques vers 0x14… au lieu de 0x7f…) : proton-cachyos ne démarrait
# pas (son émulation seccomp tue les processus enfants chargés sous
# 0x7001_0000_0000 : wineboot en SIGSYS), et les jeux 32 bits sous wine-tkg
# n'obtenaient plus leurs grosses réservations (GTI Club, 450 Mo refusés).
# Limite souple seulement : toujours permise, héritée par Wine et Proton.
if [[ "$(ulimit -s)" == "unlimited" ]]; then
    ulimit -S -s 8192 2>/dev/null || true
fi

# ============================================================
# CONFIGURATION
# ============================================================

SAVES_DIR="${WSQUASHFS_SAVES_DIR:-$HOME/.local/share/wsquashfs/saves}"
CACHE_DIR="${WSQUASHFS_CACHE:-$HOME/.cache/wsquashfs}"

# Certains paquets Batocera sont root:root avec des permissions parfois
# restrictives — un frontend peut donc élever ce script via `sudo -E`
# (inutile : voir en tête de fichier, mais toujours pris en charge). Mais root n'a pas le cookie
# X11 (~/.Xauthority) de la session graphique de l'utilisateur réel :
# lancer Wine tel quel donne "Authorization required, but no authorization
# protocol specified" puis "no driver could be loaded" — confirmé en direct.
# On garde donc le montage/l'extraction en root (si c'est ainsi qu'on a été
# lancé), mais on repasse sur SUDO_USER (positionné automatiquement par sudo)
# juste avant d'exécuter Wine. ALLOW_OTHER_OPT n'est utile que dans ce cas :
# sans lui, un montage fait en root reste invisible à SUDO_USER ensuite
# (FUSE : seul le monteur ou root — ici l'inverse — peut y accéder sans
# allow_other), ce qui cascade en "Permission denied" au lancement suivant.
RUN_AS_ROOT=false
[[ "$(id -u)" -eq 0 ]] && RUN_AS_ROOT=true
TARGET_USER="${SUDO_USER:-}"
ALLOW_OTHER_OPT=""
[[ "$RUN_AS_ROOT" == true ]] && ALLOW_OTHER_OPT="allow_other"

# Le contenu des .wsquashfs Batocera appartient à root:root (755/644) et
# fuse-overlayfs applique ces droits (default_permissions) : Wine, qui tourne
# en TARGET_USER, ne pouvait alors RIEN modifier dans le jeu — confirmé en
# direct sur Initial D 8 (segare) : "UnauthorizedAccessException: Access to
# the path C:\game\...\teknoparrot.ini is denied", et C:\users\<user>
# impossible à créer. squash_to_uid/gid fait apparaître toute l'arborescence
# fusionnée comme appartenant à l'utilisateur qui lance Wine.
WINE_UID=$(id -u)
WINE_GID=$(id -g)
if [[ "$RUN_AS_ROOT" == true && -n "$TARGET_USER" ]]; then
    WINE_UID=$(id -u "$TARGET_USER")
    WINE_GID=$(id -g "$TARGET_USER")
fi
OVERLAY_SQUASH_OPT="squash_to_uid=${WINE_UID},squash_to_gid=${WINE_GID}"

# Exécute une commande en tant que l'utilisateur qui lance Wine.
as_wine_user() {
    if [[ "$RUN_AS_ROOT" == true && -n "$TARGET_USER" ]]; then
        sudo -u "$TARGET_USER" "$@"
    else
        "$@"
    fi
}

# ============================================================
# FONCTIONS
# ============================================================

detect_env() {
    if [[ -f /.dockerenv ]] || grep -qE 'docker|lxc' /proc/1/cgroup 2>/dev/null; then
        echo "Docker"
    else
        echo "Physical"
    fi
}

# Wine par défaut (prefix non Proton : jeux arcade Batocera). Priorité
# (27/09) : wine-tkg → wine-ge/lutris → wine-proton → wine système. wine-tkg
# d'abord, comme le runner par défaut de Batocera : meilleure compatibilité
# avec les jeux arcade. Les prefixes créés par Proton (Heroic, Steam) ont
# leur propre choix de runner, voir find_proton_runner.
find_wine_binary() {
    local candidates=("/usr/wine/wine-tkg/bin/wine") d w
    # Chemins installés par notre installeur ou manuellement
    for d in "$HOME/.local/share/wsquashfs/wine" "/opt"; do
        [[ -d "$d" ]] || continue
        while IFS= read -r -d '' w; do
            [[ -x "$w" ]] && candidates+=("$w")
        done < <(find "$d" -maxdepth 3 -name "wine" -path "*/bin/wine" -print0 2>/dev/null \
            | grep -z -i 'tkg')
    done
    candidates+=("/usr/wine/ge-custom/bin/wine")
    for d in "$HOME/.local/share/wsquashfs/wine" "/opt"; do
        [[ -d "$d" ]] || continue
        while IFS= read -r -d '' w; do
            [[ -x "$w" ]] && candidates+=("$w")
        done < <(find "$d" -maxdepth 3 -name "wine" -path "*/bin/wine" -print0 2>/dev/null \
            | grep -z -iE '/(wine-ge|lutris-|wine-lutris)')
    done
    candidates+=("/usr/wine/wine-proton/bin/wine")
    for c in "${candidates[@]}"; do
        [[ -x "$c" ]] || continue
        # Vérifier que l'interpréteur ELF est présent (wine est souvent un stub 32-bit
        # qui requiert /lib/ld-linux.so.2 absent des systèmes 64-bit purs)
        local interp
        interp=$(readelf -l "$c" 2>/dev/null | grep 'interpreter' \
                 | sed 's/.*interpreter: \(.*\)\]/\1/')
        if [[ -z "$interp" || -x "$interp" ]]; then
            echo "$c" && return
        fi
        # Fallback : wine64 dans le même répertoire bin/
        local wine64="${c%wine}wine64"
        if [[ -x "$wine64" ]]; then
            local interp64
            interp64=$(readelf -l "$wine64" 2>/dev/null | grep 'interpreter' \
                       | sed 's/.*interpreter: \(.*\)\]/\1/')
            if [[ -z "$interp64" || -x "$interp64" ]]; then
                echo "$wine64" && return
            fi
        fi
    done
    command -v wine
}

# Vrai si ce binaire Wine sait exécuter un prefix win32 (build classique avec
# i386-unix ; un build WoW64 seul n'a que x86_64-unix).
wine_supports_win32() {
    local root
    root=$(dirname "$(dirname "$(readlink -f "$1")")")
    [[ -d "${root}/lib/wine/i386-unix" || -d "${root}/lib32/wine/i386-unix" ]]
}

# Détecte l'architecture réelle du prefix depuis system.reg (comme setPrefixArch de Batocera).
# Format réel : ligne "#arch=win32" en tête de system.reg/userdef.reg — l'ancien
# motif '"#arch"="win32"' ne correspondait jamais (tout prefix vu en win64).
detect_prefix_arch() {
    if grep -qs '^#arch=win32' "${WINEPOINT}/system.reg" "${WINEPOINT}/userdef.reg"; then
        echo "win32"
    else
        echo "win64"
    fi
}

# Détecte le nom d'utilisateur Wine dans le prefix (profiles packagés par Batocera, ex: steamuser).
# Retourne le premier utilisateur trouvé (hors Public/All Users/Default User).
detect_wine_username() {
    local users_dir="${WINEPOINT}/drive_c/users"
    [[ -d "$users_dir" ]] || return
    local name
    for d in "$users_dir"/*/; do
        name=$(basename "$d")
        case "$name" in
            Public|"All Users"|"Default User"|LocalService|NetworkService) continue ;;
        esac
        [[ -d "$d" ]] && echo "$name" && return
    done
}

getWine_var() {
    local winepoint="$1" winevar="$2" default="$3"
    if [[ -e "${winepoint}/autorun.cmd" ]]; then
        local val
        val=$(grep "^${winevar}=" "${winepoint}/autorun.cmd" | sed "s/^${winevar}=//" | head -1 | tr -d '\r')
        echo "${val:-$default}"
    else
        echo "$default"
    fi
}

# Retire une paire de guillemets entourant une valeur de chemin de
# l'autorun.cmd (DIR="Mon Jeu/Bin/", 27/09 : Kingdom Hearts III). Le format
# Batocera n'en met pas — les espaces passent tels quels —, mais le réflexe
# est naturel. CMD n'est pas concerné : c'est une ligne de commande, ses
# guillemets sont interprétés normalement.
unquote() {
    local v="$1"
    if [[ ${#v} -ge 2 && ( ( "${v:0:1}" == '"' && "${v: -1}" == '"' ) || ( "${v:0:1}" == "'" && "${v: -1}" == "'" ) ) ]]; then
        v="${v:1:${#v}-2}"
    fi
    echo "$v"
}

# Version du jeu packagé : GAME_VERSION= de l'autorun.cmd (29/09). Batocera
# ne lit que les clés qu'il connaît (grep "^CLE=" dans batocera-wine), une
# clé en plus y est ignorée — l'image reste compatible. Lue dans l'image
# même (unsquashfs -cat, sans montage : une modification de l'autorun.cmd
# restée dans les sauvegardes ne compte pas) ou dans un dossier installé.
game_version() {
    local v
    if [[ -d "$1" ]]; then
        v=$(grep -m1 '^GAME_VERSION=' "${1}/autorun.cmd" 2>/dev/null)
    else
        v=$(unsquashfs -cat "$1" autorun.cmd 2>/dev/null | grep -m1 '^GAME_VERSION=')
    fi
    v="${v#GAME_VERSION=}"
    unquote "${v%$'\r'}"
}

do_umount() {
    fusermount -u "$1" 2>/dev/null || fusermount3 -u "$1" 2>/dev/null || umount "$1" 2>/dev/null || true
}

# Démontage de fin de partie : juste après wineserver -k, les processus du jeu
# tiennent encore des fichiers ouverts quelques instants ("busy") — un seul
# essai laissait le montage en place (confirmé en campagne de test). Quelques
# essais, puis démontage différé en dernier recours, comme safe_umount() de
# batocera-wine (umount -l).
umount_retry() {
    local i
    for ((i = 0; i < 5; i++)); do
        mountpoint -q "$1" 2>/dev/null || return 0
        fusermount -u "$1" 2>/dev/null || fusermount3 -u "$1" 2>/dev/null || umount "$1" 2>/dev/null
        mountpoint -q "$1" 2>/dev/null || return 0
        sleep 1
    done
    fusermount3 -uz "$1" 2>/dev/null || fusermount -uz "$1" 2>/dev/null || umount -l "$1" 2>/dev/null || true
}

# Balaie TOUS les montages wsquashfs actifs sous CACHE_DIR, pas seulement
# celui du jeu qu'on lance — un jeu qui plante ou qu'on ferme brutalement
# (SIGKILL, déconnexion Moonlight) ne passe jamais par cleanup() ; sans ce
# balayage à chaque lancement, ces montages orphelins s'accumulent
# indéfiniment au fil des jeux essayés (confirmé en direct : 10 montages
# fantômes après 10 jeux testés une fois chacun). Best-effort : un jeu
# ACTIVEMENT en cours (fichier ouvert dans son montage) échoue juste
# silencieusement à se démonter ("busy") et n'est donc jamais perturbé.
unmount_all_stale() {
    # mount(8) affiche toujours le chemin CANONIQUE (symlinks résolus) —
    # CACHE_DIR peut être un chemin symlinké (ex: $HOME/.cache/... quand
    # $HOME lui-même est un lien, comme /home/arcade -> /config sur
    # SteamBox) : un grep -F sur CACHE_DIR brut ne matcherait alors jamais
    # rien, confirmé en direct (fonction silencieusement no-op).
    # Seulement les montages ABANDONNÉS (27/09) : démonter aussi ceux d'un
    # jeu en cours coupait ce jeu dès qu'un autre était lancé — plusieurs
    # parties interrompues ainsi le 27/09 (Kingdom Hearts III, DBZ).
    local real_cache_dir m
    real_cache_dir=$(readlink -f "$CACHE_DIR" 2>/dev/null || echo "$CACHE_DIR")
    mount 2>/dev/null | grep -F "${real_cache_dir}/wine/" | sed -E 's/^[^ ]+ on (.*) type .*/\1/' \
        | while IFS= read -r m; do game_in_use "$(basename "$m")" || do_umount "$m"; done
    mount 2>/dev/null | grep -F "${real_cache_dir}/mnt/" | sed -E 's/^[^ ]+ on (.*) type .*/\1/' \
        | while IFS= read -r m; do game_in_use "$(basename "$m")" || do_umount "$m"; done
}

# Vrai si un processus tourne dans le prefix de ce jeu : WINEPREFIX (Wine,
# Proton, umu et son runtime l'héritent tous) pointe vers
# .../wsquashfs/wine/<jeu>, avec ou sans / final (Proton : .../<jeu>/pfx/).
game_in_use() {
    local re
    re=$(printf '%s' "$1" | sed 's/[][\.*^$(){}?+|/]/\\&/g')
    grep -qszE "^WINEPREFIX=.*/wsquashfs/wine/${re}(/.*)?$" /proc/[0-9]*/environ 2>/dev/null
}

# Auto-correction de propriété sur le cache : un dossier créé par un autre
# UID (session sudo antérieure, ancien PUID de conteneur avant remap
# usermod, etc.) bloque ensuite mkdir/rm/unsquashfs pour TOUS les jeux
# dont le cache vit sous ce même chemin. On corrige la racine en une
# passe récursive (skip si déjà correct — pas de chown -R inutile à
# chaque lancement) plutôt que de rustiner un jeu à la fois.
# sudo -n : jamais de prompt interactif (le script peut tourner sans TTY,
# ex. lancé depuis un frontend). Sans sudo (dé)configuré, no-op silencieux.
#
# Propriétaire visé = l'utilisateur qui lance Wine (pas root quand on a été
# élevé via sudo, sinon Wine refuse ensuite le prefix). find -xdev, jamais
# chown -R : ce dernier traversait les overlays encore montés sous CACHE_DIR
# et chaque chown y déclenchait un copy-up du fichier — confirmé en direct,
# le jeu ENTIER recopié dans SAVES_DIR (7 Go par jeu).
fix_ownership() {
    local path="$1"
    [[ -e "$path" ]] || return 0
    [[ "$(stat -c '%u' "$path" 2>/dev/null)" == "$WINE_UID" ]] && return 0
    local chown_cmd=(chown)
    if [[ "$(id -u)" -ne 0 ]]; then
        command -v sudo &>/dev/null || return 0
        chown_cmd=(sudo -n chown)
    fi
    find "$path" -xdev ! -user "$WINE_UID" -print0 2>/dev/null \
        | xargs -0r "${chown_cmd[@]}" -h "${WINE_UID}:${WINE_GID}" 2>/dev/null || true
}

# Quand ce script monte/extrait en root (voir RUN_AS_ROOT plus haut), tout ce
# qu'il crée (dossiers de cache, prefix extrait) appartient à root — Wine
# refuse ensuite de démarrer dans un WINEPREFIX qui ne lui appartient pas
# ("... is not owned by you", confirmé en direct), même une fois relancé en
# TARGET_USER. No-op si on ne tourne pas en root avec un utilisateur cible
# connu (chemin normal, non élevé).
chown_to_target() {
    [[ "$RUN_AS_ROOT" == true ]] || return 0
    [[ -n "$TARGET_USER" ]] || return 0
    [[ -e "$1" ]] || return 0
    # Jamais à travers un montage FUSE (overlay encore monté d'une session
    # précédente...) : chaque chown y déclenche un copy-up du fichier.
    mountpoint -q "$1" 2>/dev/null && return 0
    find "$1" -xdev ! -user "$TARGET_USER" -print0 2>/dev/null \
        | xargs -0r chown -h "${TARGET_USER}:${TARGET_USER}" 2>/dev/null || true
}

# Parse "KEY=VAL KEY2=VAL2" et exporte sans eval
apply_wine_env() {
    local pair
    while IFS= read -r pair; do
        # shellcheck disable=SC2163  # export de "VAR=valeur" voulu
        [[ "$pair" =~ ^[A-Za-z_][A-Za-z0-9_]*=.* ]] && export "$pair" || true
    done <<< "$(tr ' ' '\n' <<< "$1")"
}

# Arrêt propre du wineserver — séquence Batocera : kill → wait → kill -9 forcé
# Lancé en tant que l'utilisateur de Wine : chaque UID a son propre socket
# wineserver (/tmp/.wine-<uid>), root ne joignait donc jamais celui de
# TARGET_USER — l'overlay était démonté sous un wineserver encore vivant, qui
# perdait ensuite le registre ("could not save registry branch to system.reg").
stop_wineserver() {
    as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -k 2>/dev/null || true
    local i=0
    while (( i++ < 10 )); do
        as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -w 2>/dev/null && return 0
        sleep 1
    done
    # Kill forcé si wineserver s'accroche encore
    local pids
    pids=$(pgrep -f "WINEPREFIX=${WINEPOINT}" 2>/dev/null) || true
    [[ -n "$pids" ]] && kill -9 $pids 2>/dev/null || true
}

# Relie (lien symbolique) les DLLs Wine absentes du prefix (DLLs Wine 10+ manquantes dans vieux
# prefixes Batocera). Seules les DLLs absentes sont reliées — les existantes (DXVK etc.) ne sont
# jamais écrasées.
# Note : aucune limite de taille — Wine 10+ a promu certaines DLLs de stubs à implémentations
# complètes (ex: coml2.dll ~344 Ko) qui sont nécessaires même dans les vieux prefixes Batocera.
#
# En mode overlay : fuse-overlayfs non-privilégié ne peut pas faire de copy-up des répertoires
# root-owned (system32, syswow64). On écrit donc directement dans le SAVEPOINT (upperdir)
# au lieu du WINEPOINT (overlay), ce qui évite le copy-up et l'erreur EPERM.
sync_wine_stubs() {
    local wine_bin="$1"
    # target_root : répertoire racine du prefix où écrire les DLLs
    # En mode overlay → SAVEPOINT (upperdir direct, évite copy-up EPERM)
    # En mode copy    → WINEPOINT (écriture directe)
    local target_root="${2:-$WINEPOINT}"
    local wine_root
    # Résoudre le symlink pour trouver le vrai répertoire Wine (ex: /usr/bin/wine → /opt/wine-staging/bin/wine)
    wine_root=$(dirname "$(dirname "$(readlink -f "$wine_bin")")")
    local src_dirs=(
        "${wine_root}/lib/wine/x86_64-windows:system32"
        "${wine_root}/lib64/wine/x86_64-windows:system32"   # wine-ge/lutris met les DLLs 64-bit ici
        "${wine_root}/lib/wine/i386-windows:syswow64"
        # chemins Debian/Ubuntu
        "/usr/lib/x86_64-linux-gnu/wine/x86_64-windows:system32"
        "/usr/lib/x86_64-linux-gnu/wine/i386-windows:syswow64"
        "/usr/lib/i386-linux-gnu/wine/i386-windows:syswow64"
    )
    local entry src_dir dst_subdir src dst name
    for entry in "${src_dirs[@]}"; do
        src_dir="${entry%%:*}"
        dst_subdir="${entry##*:}"
        # Prefix win32 : system32 contient les DLL 32 bits, pas de syswow64
        if [[ "$WINE_ARCH" == "win32" ]]; then
            [[ "$dst_subdir" == "system32" ]] && continue
            dst_subdir=system32
        fi
        [[ -d "$src_dir" ]] || continue
        mkdir -p "${target_root}/drive_c/windows/${dst_subdir}" 2>/dev/null || true
        # DLL internes de Wine déjà dans le prefix (signature "Wine builtin
        # DLL" / "Wine placeholder DLL") : remplacées par celles du runner,
        # comme batocera-wine (27/09). Les prefixes Batocera en embarquent de
        # vraies copies d'un autre Wine (Virtua Tennis 4 : 619 dans
        # system32) — gardées, winex11.drv/explorer.exe d'un autre Wine avec
        # les bibliothèques de celui-ci donnaient "no driver could be
        # loaded". Seules les DLL natives (sans signature : d3dx9_42,
        # mscoree... de Microsoft) sont conservées.
        local -A wine_owned=()
        local f
        while IFS= read -r f; do
            wine_owned["$(basename "$f")"]=1
        done < <(grep -laE "Wine (builtin|placeholder) DLL" \
                     "${WINEPOINT}/drive_c/windows/${dst_subdir}"/* 2>/dev/null)
        # Tous les types de modules (.dll, .exe, .drv, .sys...) : explorer.exe
        # et winex11.drv n'étaient jamais reliés avec *.dll seul.
        for src in "$src_dir"/*; do
            [[ -f "$src" ]] || continue
            name=$(basename "$src")
            local overlay_dst="${WINEPOINT}/drive_c/windows/${dst_subdir}/${name}"
            # -f renvoie false pour les symlinks cassés → on ne saute pas, on remplace
            [[ -f "$overlay_dst" && -z "${wine_owned[$name]:-}" ]] && continue
            dst="${target_root}/drive_c/windows/${dst_subdir}/${name}"
            # Lien symbolique, pas copie (25/09) : comme batocera-wine, qui relie
            # les DLL du runner dans le prefix. La copie recopiait ~1 660 DLL
            # (~500 Mo) à CHAQUE lancement dans les sauvegardes du jeu — 35 Go
            # sur 41 Go de saves pour 140 jeux (mesuré). Wine reconnaît ses DLL
            # intégrées à travers le lien. ln -sfn remplace aussi un lien cassé
            # (ex. vers /userdata/... d'un prefix Batocera).
            ln -sfn "$src" "$dst" 2>/dev/null || true
        done
    done
}

# Les prefixes Batocera n'embarquent pas DXVK : system32/syswow64 contiennent
# des liens vers /userdata/system/wine/dxvk/{x64,x32}/*.dll, un chemin qui
# n'existe que sous Batocera (247 jeux sur 247 concernés dans une collection
# réelle). Liens cassés → Wine retombe sur son d3d9/d3d11 intégré (OpenGL),
# soit llvmpipe sous Xwayland+NVIDIA — confirmé en direct : Dead or Alive 5
# Ultimate (segare) quittait aussitôt sans aucune erreur.
find_dxvk_dir() {
    local d
    for d in "${WSQUASHFS_DXVK_DIR:-}" /usr/share/dxvk "$HOME/.local/share/wsquashfs/dxvk"; do
        [[ -n "$d" && -f "${d}/x64/dxgi.dll" ]] && echo "$d" && return
    done
}

# Comme dxvk_install() de batocera-wine : les liens DXVK sont recréés à
# CHAQUE lancement (pas seulement réparés), vers le DXVK local. À lancer
# APRÈS sync_wine_stubs, qui aurait sinon laissé la DLL intégrée de Wine.
# target_root : comme sync_wine_stubs (SAVEPOINT en overlay, WINEPOINT sinon).
install_dxvk() {
    local target_root="${1:-$WINEPOINT}" dxvk_dir pair arch sub dll
    dxvk_dir=$(find_dxvk_dir)
    [[ -n "$dxvk_dir" ]] || return 0
    for pair in x64:system32 x32:syswow64; do
        arch="${pair%%:*}" sub="${pair##*:}"
        # Prefix win32 : system32 contient les DLL 32 bits, pas de syswow64
        if [[ "$WINE_ARCH" == "win32" ]]; then
            [[ "$arch" == "x64" ]] && continue
            sub=system32
        fi
        mkdir -p "${target_root}/drive_c/windows/${sub}" 2>/dev/null || true
        for dll in d3d8 d3d9 d3d10core d3d11 dxgi; do
            [[ -f "${dxvk_dir}/${arch}/${dll}.dll" ]] || continue
            ln -sfn "${dxvk_dir}/${arch}/${dll}.dll" \
                "${target_root}/drive_c/windows/${sub}/${dll}.dll" 2>/dev/null || true
        done
    done
}

# VKD3D-Proton (Direct3D 12 → Vulkan), relié comme DXVK (26/09) : jusque-là
# seul l'override d3d12=n,b était posé, sans aucune DLL vkd3d-proton dans le
# prefix — Wine chargeait son propre d3d12.dll, inutilisable ici, et tout jeu
# DX12 échouait (Pinball FX : "DX12 is not supported on your system"). Il
# faut la version Windows (paquet vkd3d-proton-mingw, /usr/share/vkd3d-proton/
# {x64,x86}), pas la bibliothèque Linux de vkd3d-proton.
find_vkd3d_dir() {
    local d
    for d in "${WSQUASHFS_VKD3D_DIR:-}" /usr/share/vkd3d-proton "$HOME/.local/share/wsquashfs/vkd3d-proton"; do
        [[ -n "$d" && -f "${d}/x64/d3d12.dll" ]] && echo "$d" && return
    done
}

install_vkd3d() {
    local target_root="${1:-$WINEPOINT}" vkd3d_dir pair arch sub dll
    vkd3d_dir=$(find_vkd3d_dir)
    [[ -n "$vkd3d_dir" ]] || return 0
    for pair in x64:system32 x86:syswow64; do
        arch="${pair%%:*}" sub="${pair##*:}"
        if [[ "$WINE_ARCH" == "win32" ]]; then
            [[ "$arch" == "x64" ]] && continue
            sub=system32
        fi
        mkdir -p "${target_root}/drive_c/windows/${sub}" 2>/dev/null || true
        for dll in d3d12 d3d12core; do
            [[ -f "${vkd3d_dir}/${arch}/${dll}.dll" ]] || continue
            ln -sfn "${vkd3d_dir}/${arch}/${dll}.dll" \
                "${target_root}/drive_c/windows/${sub}/${dll}.dll" 2>/dev/null || true
        done
    done
}

# Comme sandboxing_prefix() de batocera-wine : les dossiers du profil Wine
# (Documents, Music...) sont packagés en liens vers /userdata/system,
# inexistant ici — un jeu qui sauvegarde dans "Mes documents" échouait.
# Remplacés par de vrais dossiers (dans l'upperdir en overlay : les
# sauvegardes y persistent).
# d7vk (DirectDraw → Vulkan, 32 bits uniquement), comme dxvk_install() de
# batocera-wine avec son option d7vk : ddraw.dll → d7vk, et le ddraw
# intégré de Wine exposé en ddraw_.dll. Sans lui, un jeu DirectDraw passe
# par l'OpenGL de wined3d, soit llvmpipe (rendu logiciel) sous
# Xwayland + NVIDIA.
find_d7vk() {
    local f
    for f in "${WSQUASHFS_D7VK_DLL:-}" /usr/share/d7vk/x32/ddraw.dll \
             "$HOME/.local/share/wsquashfs/d7vk/x32/ddraw.dll"; do
        [[ -n "$f" && -f "$f" ]] && echo "$f" && return
    done
}

install_d7vk() {
    local target_root="${1:-$WINEPOINT}" d7 wine_root builtin="" c sub=syswow64
    d7=$(find_d7vk)
    [[ -n "$d7" ]] || return 0
    [[ "$WINE_ARCH" == "win32" ]] && sub=system32
    wine_root=$(dirname "$(dirname "$(readlink -f "$WINE_BINARY")")")
    for c in "${wine_root}/lib/wine/i386-windows/ddraw.dll" \
             "${wine_root}/lib32/wine/i386-windows/ddraw.dll" \
             /usr/lib/wine/i386-windows/ddraw.dll; do
        [[ -f "$c" ]] && { builtin="$c"; break; }
    done
    mkdir -p "${target_root}/drive_c/windows/${sub}" 2>/dev/null || true
    ln -sfn "$d7" "${target_root}/drive_c/windows/${sub}/ddraw.dll" 2>/dev/null || true
    [[ -n "$builtin" ]] && ln -sfn "$builtin" "${target_root}/drive_c/windows/${sub}/ddraw_.dll" 2>/dev/null || true
}

# Mise à jour du prefix au changement de runner, comme createOrUpdatePrefix()
# de batocera-wine : Wine met le prefix à jour quand .update-timestamp ne
# correspond plus à son wine.inf, et échouait alors sur les liens DLL déjà en
# place (liens DXVK des prefixes Batocera, cassés ici) — "create_dest_file
# failed ... (error=80)" pour chaque DLL, vu pendant la campagne de test.
# Les liens de system32/syswow64 sont retirés AVANT la mise à jour, puis
# recréés par sync_wine_stubs/install_dxvk/install_d7vk juste après.
update_prefix_if_needed() {
    local wine_root inf ts stamp
    [[ -f "${WINEPOINT}/system.reg" ]] || return 0
    wine_root=$(dirname "$(dirname "$(readlink -f "$WINE_BINARY")")")
    inf="${wine_root}/share/wine/wine.inf"
    [[ -f "$inf" ]] || return 0
    ts=$(stat -c %Y "$inf")
    # Wine écrit ce fichier en fin de ligne Windows ("1790165633\r\n") : sans
    # retirer le \r, la comparaison échouait toujours et wineboot -u tournait
    # à CHAQUE lancement (~70 s, ~725 DLL réécrites dans les saves — 25/09).
    stamp=$(head -n1 "${WINEPOINT}/.update-timestamp" 2>/dev/null | tr -d '\r')
    [[ "$stamp" == "disable" || "$stamp" == "$ts" ]] && return 0
    echo "Préfixe       : mise à jour pour $("$WINE_BINARY" --version 2>/dev/null || basename "$wine_root")"
    find "${WINEPOINT}/drive_c/windows/system32" "${WINEPOINT}/drive_c/windows/syswow64" \
        -maxdepth 1 -type l -delete 2>/dev/null || true
    as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
        WINEDEBUG="-all" WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d" \
        "$WINE_BINARY" wineboot -u >/dev/null 2>&1 || true
    as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -w 2>/dev/null || true
    # wineboot -u vient d'écrire ~1 600 DLL (~500 Mo) dans l'upperdir : les
    # retirer tout de suite, sync_wine_stubs les remplace par des liens et
    # l'overlay est rechargé ensuite (de toute façon effacées au lancement
    # suivant). Vu le 25/09 : 8 jeux, +4,5 Go après un premier lancement.
    # Prefix packagé seulement : pour un jeu seul, ce system32 EST le prefix.
    # Rechargement obligatoire (27/09) : sans lui, fuse-overlayfs gardait
    # sa vue d'avant l'effacement, sync_wine_stubs croyait absentes les DLL
    # natives du jeu (d3dx9_42, mscoree...) et les remplaçait par des liens
    # Wine — "d3dx9_42.dll not found", jeu arcade qui ne se lance pas au
    # premier lancement après chaque changement de Wine (Virtua Tennis 4,
    # 27/09 : échec avec la mise à jour, lancement normal sans).
    if [[ "$MOUNT_MODE" == "overlay" && "$PACKAGED_PREFIX" == "1" ]]; then
        rm -rf "${SAVEPOINT}/drive_c/windows/system32" \
               "${SAVEPOINT}/drive_c/windows/syswow64" 2>/dev/null || true
        reload_overlay "après mise à jour du préfixe"
    fi
}

# SAVEDIR / SAVEFILES de l'autorun.cmd, comme saveFilesToUserdata() de
# batocera-wine : le dossier (ou les fichiers) de sauvegarde du jeu sont
# remplacés par des liens vers <racine>/saves/<système>/<jeu>, à côté du
# dossier roms/ — l'emplacement des sauvegardes Batocera. Différence : la
# copie initiale des sauvegardes packagées n'écrase JAMAIS une sauvegarde
# déjà présente (cp -n), là où Batocera peut les remplacer si le prefix est
# recréé.
batocera_saves_dir() {
    local rom_dir sys root
    if [[ -n "${WSQUASHFS_BATOCERA_SAVES:-}" ]]; then
        echo "${WSQUASHFS_BATOCERA_SAVES}/${GAME_NAME}"; return
    fi
    rom_dir=$(dirname "$WSQUASHFS_FILE")
    sys=$(basename "$rom_dir")
    root=$(dirname "$(dirname "$rom_dir")")
    [[ "$(basename "$(dirname "$rom_dir")")" == "roms" ]] || return 1
    echo "${root}/saves/${sys}/${GAME_NAME}"
}

apply_savedir() {
    local savedir="${1//\\//}" savefiles="$2" sysdir parent base f
    [[ -n "$savedir$savefiles" ]] || return 0
    if ! sysdir=$(batocera_saves_dir); then
        echo "Attention : SAVEDIR/SAVEFILES ignorés (jeu hors d'un dossier roms/<système>/ ;"
        echo "  définir WSQUASHFS_BATOCERA_SAVES)"
        return 0
    fi
    mkdir -p "$sysdir"
    if [[ -n "$savedir" ]]; then
        parent="${WINEPOINT}/$(dirname "$savedir")"
        base=$(basename "$savedir")
        mkdir -p "$parent"
        if [[ -d "${parent}/${base}" && ! -L "${parent}/${base}" ]]; then
            cp -an "${parent}/${base}/." "$sysdir/" 2>/dev/null || true
            rm -rf "${parent:?}/${base:?}"
        fi
        [[ -L "${parent}/${base}" ]] || ln -s "$sysdir" "${parent}/${base}"
    else
        IFS=';' read -r -a files <<< "$savefiles"
        for f in "${files[@]}"; do
            f="${f//\\//}"
            [[ -n "$f" ]] || continue
            mkdir -p "$(dirname "${sysdir}/${f}")" "$(dirname "${WINEPOINT}/${f}")"
            if [[ -e "${WINEPOINT}/${f}" && ! -L "${WINEPOINT}/${f}" ]]; then
                [[ -e "${sysdir}/${f}" ]] || mv -f "${WINEPOINT}/${f}" "${sysdir}/${f}"
                rm -f "${WINEPOINT}/${f}"
            fi
            ln -sfn "${sysdir}/${f}" "${WINEPOINT}/${f}"
        done
    fi
    chown_to_target "$sysdir"
    echo "Sauvegardes   : ${sysdir} (SAVEDIR/SAVEFILES)"
}

fix_userdata_links() {
    local link
    while IFS= read -r -d '' link; do
        rm -f "$link" && mkdir -p "$link"
    done < <(find "${WINEPOINT}/drive_c/users" -maxdepth 6 -type l -lname '/userdata*' -print0 2>/dev/null)
}

# Résout <base>/<rel> sans tenir compte de la casse (comme Windows/Wine).
# Affiche le chemin réel, retour 1 si un composant est introuvable.
resolve_ci() {
    local cur="$1" part match entry name
    local -a parts
    IFS='/' read -ra parts <<< "$2"
    for part in "${parts[@]}"; do
        [[ -z "$part" || "$part" == "." ]] && continue
        if [[ -e "${cur}/${part}" ]]; then
            cur="${cur}/${part}"
            continue
        fi
        match=""
        for entry in "$cur"/* "$cur"/.[!.]*; do
            name="${entry##*/}"
            if [[ "${name,,}" == "${part,,}" ]]; then match="$entry"; break; fi
        done
        [[ -n "$match" ]] || return 1
        cur="$match"
    done
    echo "$cur"
}

# Extrait le wsquashfs dans WINEPOINT : squashfuse (copie) ou unsquashfs
do_fresh_extraction() {
    if command -v squashfuse &>/dev/null && \
       squashfuse ${ALLOW_OTHER_OPT:+-o "$ALLOW_OTHER_OPT"} "$WSQUASHFS_FILE" "$SQUASHFSPOINT" 2>/dev/null; then
        echo "Mode          : copy (squashfuse)"
        [[ -n "$WINEPOINT" ]] && rm -rf "$WINEPOINT"
        mkdir -p "$WINEPOINT"
        cp -a "$SQUASHFSPOINT/." "$WINEPOINT/"
        do_umount "$SQUASHFSPOINT"
    elif command -v unsquashfs &>/dev/null; then
        echo "Mode          : copy (unsquashfs)"
        [[ -n "$WINEPOINT" ]] && rm -rf "$WINEPOINT"
        if ! unsquashfs -d "$WINEPOINT" "$WSQUASHFS_FILE"; then
            echo "Erreur : échec de l'extraction unsquashfs"
            return 1
        fi
    else
        echo "Erreur : FUSE bloqué et unsquashfs absent"
        echo "  → Exposer /dev/fuse dans le conteneur : --device /dev/fuse"
        echo "  → Ou installer squashfs-tools : apt-get install squashfs-tools"
        return 1
    fi
    echo "${WSQUASHFS_FILE}:$(stat -c '%s:%Y' "$WSQUASHFS_FILE" 2>/dev/null)" \
        > "${WINEPOINT}/.wsquashfs_cache"
    # Mode copy : WINEPOINT est un vrai répertoire extrait — s'il l'a été en
    # root, Wine (relancé en TARGET_USER plus loin) le refusera sinon.
    chown_to_target "$WINEPOINT"
    return 0
}

# Runners Wine/Proton installés, pour --wine : dossiers contenant bin/wine
# (Wine classique, Kron4ek...) ou files/bin/wine (Proton-GE).
list_wine_runners() {
    local d
    for d in /opt/* /usr/wine/* "$HOME/.local/share/wsquashfs/wine"/*; do
        [[ -x "${d}/bin/wine" || -x "${d}/files/bin/wine" ]] && echo "$d"
    done 2>/dev/null
    proton_runner_dirs
}

# Runners Proton installés hors de nos dossiers (27/09) : Heroic, Steam et
# paquets proton-cachyos/umu. Leur Wine est dans files/bin/wine. Un même
# dossier vu deux fois (~/.steam/root → ~/.local/share/Steam) n'est listé
# qu'une fois.
proton_runner_dirs() {
    local base d
    for base in "$HOME/.config/heroic/tools/proton" \
                "$HOME/.local/share/Steam/compatibilitytools.d" \
                "$HOME/.steam/root/compatibilitytools.d" \
                /usr/share/steam/compatibilitytools.d; do
        for d in "$base"/*; do
            [[ -x "${d}/files/bin/wine" ]] && readlink -f "$d"
        done
    done 2>/dev/null | awk '!seen[$0]++'
}

# Manettes Sony (DualShock 4, DualSense) utilisables par hidraw : avec
# "DisableHidraw"=0, winebus les réserve à son backend hidraw et SDL les
# ignore — un /dev/hidrawN illisible laisserait le jeu SANS manette. Vrai
# s'il y en a au moins une et que tous leurs nœuds sont lisibles ; message
# de la raison dans HIDRAW_REASON.
hidraw_usable() {
    local u n found=0
    for u in "${HIDRAW_SYSFS:-/sys/class/hidraw}"/*/device/uevent; do
        grep -qs '^HID_ID=[0-9A-Fa-f]*:0000054C:' "$u" || continue
        n=$(basename "$(dirname "$(dirname "$u")")")
        found=1
        if [[ ! -r "/dev/${n}" ]]; then
            HIDRAW_REASON="/dev/${n} illisible"
            return 1
        fi
    done
    [[ "$found" == 1 ]] || { HIDRAW_REASON="aucune manette Sony"; return 1; }
}

# Remonte l'overlay : fuse-overlayfs garde sa vue des dossiers en mémoire
# et ne voit pas ce qui est modifié directement dans l'upperdir (SAVEPOINT).
reload_overlay() {
    do_umount "$WINEPOINT"
    rm -rf "$WORKPOINT" && mkdir -p "$WORKPOINT"
    chown_to_target "$WORKPOINT"
    if ! fuse-overlayfs \
           -o "lowerdir=${SQUASHFSPOINT},upperdir=${SAVEPOINT},workdir=${WORKPOINT},${OVERLAY_SQUASH_OPT}${ALLOW_OTHER_OPT:+,$ALLOW_OTHER_OPT}" \
           "$WINEPOINT" 2>/dev/null; then
        echo "Erreur : échec du rechargement de l'overlay ${1}"
        exit 1
    fi
}

# umu-run (paquet umu-launcher), sinon celui installé par Heroic : lance un
# prefix Proton comme Heroic ou Steam, par le script proton complet dans le
# runtime Steam. WSQUASHFS_UMU=0 pour lancer Wine directement.
find_umu_run() {
    local u
    [[ "${WSQUASHFS_UMU:-1}" == "0" ]] && return 1
    for u in "$(command -v umu-run 2>/dev/null)" \
             "$HOME/.config/heroic/tools/runtimes/umu/umu_run.py"; do
        [[ -n "$u" && -x "$u" ]] && { echo "$u"; return 0; }
    done
    return 1
}

# Version de Proton qui a créé le prefix monté (1re ligne de config_info,
# écrite par le script proton : "GE-Proton11-5"), vide pour un prefix
# Batocera ou Wine simple.
prefix_proton_version() {
    [[ -f "${WINEPOINT}/config_info" ]] || return 0
    head -1 "${WINEPOINT}/config_info" 2>/dev/null | tr -d '\r'
}

# Vrai si le dossier de runner Proton correspond à cette version : même nom
# de dossier ou même version (fichier version : "<horodatage> GE-Proton11-5",
# Heroic installe sous GE-Proton-latest).
proton_runner_is() {
    [[ "$(basename "$1")" == "$2" ]] || \
    [[ "$(awk '{print $NF}' "${1}/version" 2>/dev/null)" == "$2" ]]
}

# Dossier du runner Proton pour une version voulue, sinon le plus récent des
# proton-cachyos, puis UMU-Proton, puis GE-Proton, puis n'importe quel
# Proton : un prefix Proton ne doit pas retomber sur le Wine système (27/09,
# Kingdom Hearts III, prefix Heroic GE-Proton11-5 : écran noir sous
# wine-staging). proton-cachyos puis UMU-Proton d'abord (30/09) : leur SDL
# gère la DualSense en XInput avec la vibration (evdev, hid-playstation) ;
# GE la force en hidraw et sa conversion XInput ne transmet pas la vibration.
# proton-cachyos exige une pile limitée (voir « Pile limitée » plus haut).
find_proton_runner() {
    local want="$1" d dirs
    dirs=$(proton_runner_dirs)
    [[ -n "$dirs" ]] || return 1
    if [[ -n "$want" ]]; then
        while IFS= read -r d; do
            proton_runner_is "$d" "$want" && { echo "$d"; return 0; }
        done <<< "$dirs"
    fi
    d=$(grep -i 'proton-cachyos' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(grep -i '/UMU-Proton' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(grep -i '/GE-Proton' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(head -1 <<< "$dirs")
    echo "$d"
}

# --wine <version|chemin> : binaire wine explicite, dossier de runner, nom
# exact ou partiel d'un runner installé (ex. "win32", "GE-Proton9"), ou
# "system" pour le wine du système.
resolve_wine_override() {
    local want="$1" d
    if [[ "$want" == "system" ]]; then command -v wine; return; fi
    if [[ -f "$want" && -x "$want" ]]; then echo "$want"; return; fi
    for d in "$want" $(list_wine_runners | grep -F -- "$want"); do
        [[ -x "${d}/bin/wine" ]] && { echo "${d}/bin/wine"; return; }
        [[ -x "${d}/files/bin/wine" ]] && { echo "${d}/files/bin/wine"; return; }
    done
    return 1
}

# --umount [jeu] : arrête le wineserver du jeu puis démonte son overlay et
# son squashfs. Sans argument : tous les montages wsquashfs.
umount_game() {
    local name="$1"
    [[ -d "${CACHE_DIR}/wine/${name}" ]] || return 0
    as_wine_user env WINEPREFIX="${CACHE_DIR}/wine/${name}" wineserver -k 2>/dev/null || true
    umount_retry "${CACHE_DIR}/wine/${name}"
    umount_retry "${CACHE_DIR}/mnt/${name}"
    echo "✓ Démonté : ${name}"
}

# --pack <Jeu.wine> [sortie] : prefix Wine (dossier) → .wsquashfs, comme
# wine2squashfs de batocera-wine (mksquashfs, compression zstd).
pack_prefix() {
    local src="${1%/}" out="${2:-}"
    if [[ -z "$src" || ! -d "$src" ]]; then
        echo "Usage : $0 --pack <dossier.wine> [sortie.wsquashfs]"
        return 1
    fi
    command -v mksquashfs &>/dev/null || { echo "Erreur : mksquashfs absent (squashfs-tools)"; return 1; }
    [[ -n "$out" ]] || out="${src%.wine}.wsquashfs"
    local saves reply reset_saves=false
    saves="${SAVES_DIR}/$(basename "$out" .wsquashfs)"
    # Fichier existant : question au terminal (26/09, demande utilisateur),
    # refus sans terminal (script, frontend) comme avant.
    if [[ -e "$out" ]]; then
        if [[ ! -t 0 ]]; then
            echo "Erreur : ${out} existe déjà (jamais écrasé sans confirmation au terminal)"
            return 1
        fi
        read -r -p "${out} existe déjà ($(du -h "$out" | cut -f1), $(date -r "$out" '+%d/%m %H:%M')). L'écraser ? [o/N] " reply
        [[ "${reply,,}" == o* || "${reply,,}" == y* ]] || { echo "Abandon."; return 1; }
        # Sauvegardes de l'ancienne image : appliquées par-dessus le nouveau
        # prefix (overlay), elles peuvent en masquer une partie.
        if [[ -d "$saves" ]]; then
            read -r -p "Réinitialiser aussi ses sauvegardes (${saves}) ? [o/N] " reply
            [[ "${reply,,}" == o* || "${reply,,}" == y* ]] && reset_saves=true
        fi
    fi
    [[ -f "${src}/autorun.cmd" ]] || echo "Attention : pas d'autorun.cmd dans ${src} (lançable seulement via --exec)"
    # Construit à côté puis remplace : l'ancienne image reste intacte si
    # mksquashfs échoue ou est interrompu.
    local tmp="${out}.part"
    rm -f "$tmp"
    echo "Création de ${out} depuis ${src}..."
    if ! mksquashfs "$src" "$tmp" -comp zstd -noappend -quiet; then
        rm -f "$tmp"
        echo "Erreur : échec de mksquashfs, ${out} inchangé"
        return 1
    fi
    mv -f "$tmp" "$out"
    if [[ "$reset_saves" == true ]]; then
        rm -rf -- "${saves:?}" && echo "Sauvegardes réinitialisées : ${saves}"
    fi
    echo "✓ ${out} ($(du -h "$out" | cut -f1))"
    local version
    version=$(game_version "$src")
    if [[ -n "$version" ]]; then
        echo "  Version : ${version}"
    elif [[ -f "${src}/autorun.cmd" ]]; then
        echo "  Version non renseignée (GAME_VERSION=... dans l'autorun.cmd, voir --info)"
    fi
}

# --info <jeu.wsquashfs | dossier> (29/09) : version et type du jeu, lus
# dans l'image sans la monter.
show_info() {
    local src="$1" autorun type version proton
    if [[ -z "$src" || ! -e "$src" ]]; then
        echo "Usage : $0 --info <jeu.wsquashfs | dossier du jeu>"
        return 1
    fi
    src=$(realpath "$src")
    if [[ -d "$src" ]]; then
        autorun=$(cat "${src}/autorun.cmd" 2>/dev/null)
        [[ -f "${src}/system.reg" ]] && type=prefix
        proton=$(head -1 "${src}/config_info" 2>/dev/null)
    else
        command -v unsquashfs &>/dev/null || { echo "Erreur : unsquashfs absent (squashfs-tools)"; return 1; }
        autorun=$(unsquashfs -cat "$src" autorun.cmd 2>/dev/null)
        unsquashfs -cat "$src" system.reg >/dev/null 2>&1 && type=prefix
        proton=$(unsquashfs -cat "$src" config_info 2>/dev/null | head -1)
    fi
    proton="${proton%$'\r'}"
    version=$(game_version "$src")
    if [[ -n "$proton" ]]; then
        type="prefix Proton (${proton})"
    elif [[ "$type" == prefix ]]; then
        type="prefix Wine (Batocera)"
    else
        type="jeu seul (prefix créé au premier lancement)"
    fi
    echo "Jeu           : $(basename "$src" .wsquashfs)"
    [[ -n "$version" ]] || version="non renseignée (GAME_VERSION= dans l'autorun.cmd)"
    echo "Version       : ${version}"
    echo "Type          : ${type}"
    if [[ -n "$autorun" ]]; then
        echo "Commande      : $(grep -m1 '^CMD=' <<< "$autorun" | sed 's/^CMD=//' | tr -d '\r')"
    else
        echo "Commande      : aucun autorun.cmd"
    fi
    echo "Taille        : $(du -sh "$src" | cut -f1)"
}

# --install <jeu.wsquashfs> [dossier] (29/09) : l'inverse de --pack —
# extrait l'image dans <dossier>/<Jeu> (défaut : à côté de l'image), pour
# jouer sans FUSE ; le dossier se lance ensuite directement
# (wsquashfs-launcher <dossier>/<Jeu>). Part de l'image d'origine : la couche
# de sauvegardes du .wsquashfs n'est pas reprise, l'image est conservée.
install_game() {
    local img="$1" parent="${2:-}" name dest tmp
    if [[ -z "$img" || ! -f "$img" || "${img##*.}" != "wsquashfs" ]]; then
        echo "Usage : $0 --install <jeu.wsquashfs> [dossier de destination]"
        return 1
    fi
    command -v unsquashfs &>/dev/null || { echo "Erreur : unsquashfs absent (squashfs-tools)"; return 1; }
    name=$(basename "$img" .wsquashfs)
    [[ -n "$parent" ]] || parent=$(dirname "$(realpath "$img")")
    mkdir -p "$parent" || { echo "Erreur : impossible de créer ${parent}"; return 1; }
    dest="${parent%/}/${name}"
    if [[ -e "$dest" ]]; then
        echo "Erreur : ${dest} existe déjà (jamais écrasé)"
        return 1
    fi
    # Extrait à côté puis renomme : pas de dossier à moitié rempli si
    # unsquashfs échoue (place insuffisante...) ou est interrompu.
    tmp="${dest}.part"
    rm -rf -- "$tmp"
    echo "Installation de ${name} dans ${dest}..."
    if ! unsquashfs -no-xattrs -d "$tmp" "$img"; then
        rm -rf -- "$tmp"
        echo "Erreur : échec de l'extraction, rien n'a été installé"
        return 1
    fi
    mv -- "$tmp" "$dest"
    # Lancé en root : le dossier doit appartenir à l'utilisateur qui lancera
    # Wine, sinon Wine refuse le prefix.
    if [[ "$RUN_AS_ROOT" == true && -n "$TARGET_USER" ]]; then
        chown -R "${WINE_UID}:${WINE_GID}" "$dest"
    fi
    echo "✓ ${dest} ($(du -sh "$dest" | cut -f1))"
    local version
    version=$(game_version "$dest")
    [[ -n "$version" ]] && echo "  Version : ${version}"
    echo "  Lancement : $0 \"${dest}\""
}

MOUNT_MODE=""
MOUNTED=false
SQUASHFSPOINT=""
WINEPOINT=""
WORKPOINT=""
SAVEPOINT=""

cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM
    # Le script a fait un cd dans WINEPOINT pour lancer le jeu : sans en
    # sortir, son propre CWD rend l'overlay "busy" et le démontage échouait
    # à chaque fois — d'où les montages orphelins (confirmé en direct).
    cd / || true
    if [[ "$MOUNTED" == true ]]; then
        stop_wineserver
        case "$MOUNT_MODE" in
            overlay)
                umount_retry "$WINEPOINT"
                umount_retry "$SQUASHFSPOINT"
                [[ -d "$WORKPOINT" ]] && rm -rf "$WORKPOINT"
                ;;
            copy)
                # WINEPOINT persiste entre les sessions (cache + sauvegardes intégrées)
                ;;
        esac
    fi
    exit $exit_code
}

trap cleanup EXIT INT TERM

# ============================================================
# COMMANDES SPÉCIALES
# ============================================================

fix_ownership "$CACHE_DIR"
fix_ownership "$SAVES_DIR"

usage() {
    cat <<'HELP'
Usage :
  wsquashfs-launcher [--wine <version>] <jeu.wsquashfs>
        Lance le jeu (autorun.cmd).
  wsquashfs-launcher [--wine <version>] --exec <jeu.wsquashfs> <programme> [arguments...]
        Lance un autre programme dans le prefix du jeu : un exécutable du jeu
        (chemin relatif au prefix ou au DIR de l'autorun.cmd, ex. JConfig.exe,
        drive_c/teknoparrot/TeknoParrotUi.exe) ou un outil Wine (winecfg,
        regedit, cmd, explorer, control joy.cpl...).
  wsquashfs-launcher --mount <jeu.wsquashfs>
        Monte le jeu et le laisse monté pour le modifier à la main ; les
        changements vont dans le dossier de sauvegardes du jeu.
  wsquashfs-launcher --umount [<jeu.wsquashfs>]
        Démonte un jeu (ou tous les jeux montés).
  wsquashfs-launcher --pack <Jeu.wine> [sortie.wsquashfs]
        Crée un .wsquashfs (zstd) à partir d'un prefix Wine.
  wsquashfs-launcher --install <jeu.wsquashfs> [dossier]
        Extrait le jeu dans <dossier>/<Jeu> (défaut : à côté de l'image), pour
        jouer sans FUSE ; l'image est conservée, ses sauvegardes non reprises.
  wsquashfs-launcher --info <jeu.wsquashfs | dossier>
        Affiche la version du jeu (GAME_VERSION= de l'autorun.cmd), son type
        de prefix, sa commande et sa taille, sans monter l'image.
  wsquashfs-launcher [--wine <version>] <dossier du jeu>
        Lance un jeu installé (dossier contenant autorun.cmd) sur place, sans
        montage : le jeu écrit directement dans son dossier.
  wsquashfs-launcher --clean
        Supprime les copies de travail (cache), les sauvegardes sont gardées.

Options :
  --wine <version>  Runner Wine/Proton à utiliser : nom (ou partie du nom) d'un
                    runner installé dans /opt, /usr/wine ou
                    ~/.local/share/wsquashfs/wine, chemin d'un binaire wine,
                    ou "system". Un Proton (Heroic, Steam) est lancé via umu
                    sur un jeu à prefix Proton ou sans prefix.

Modes de montage (automatique) :
  overlay   squashfuse + fuse-overlayfs (sauvegardes isolées, idéal)
  copy      squashfuse ou unsquashfs + cache persistant
  dossier   jeu installé (--install) lancé sur place, sans FUSE

Variables d'environnement :
  WSQUASHFS_SAVES_DIR        Sauvegardes overlay (défaut: ~/.local/share/wsquashfs/saves)
  WSQUASHFS_CACHE            Cache de travail   (défaut: ~/.cache/wsquashfs)
  WSQUASHFS_DXVK=0           Désactive DXVK (défaut : activé)
  WSQUASHFS_HIDRAW=1         Manettes Sony par hidraw si lisibles (défaut : XInput,
                             comme Batocera ; aussi par jeu via HIDRAW=1 dans autorun.cmd)
  (MangoHud, gamemode... : outils extérieurs, ex. "mangohud wsquashfs-launcher jeu.wsquashfs" —
   leurs variables sont transmises au jeu, y compris lancé en root)
  WSQUASHFS_VIRTUAL_DESKTOP  Bureau virtuel Wine pour tous les jeux (ex: 1920x1080),
                             aussi par jeu via VIRTUAL_DESKTOP= dans autorun.cmd
HELP
}

ACTION="run"
GAME_ARG=""
WINE_OVERRIDE=""
declare -a EXEC_CMD=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --clean)
            echo "Nettoyage des copies de travail wsquashfs..."
            # Démonter avant de supprimer : rm -rf sur un point de montage FUSE
            # actif tente de supprimer les fichiers du jeu À TRAVERS le montage
            # plutôt que le point de montage lui-même (destructif/imprévisible).
            unmount_all_stale
            rm -rf "${CACHE_DIR:?}/mnt" "${CACHE_DIR:?}/wine" "${CACHE_DIR:?}/work" 2>/dev/null || true
            echo "✓ Copies de travail supprimées"
            echo "  Les sauvegardes overlay sont préservées dans : ${SAVES_DIR}"
            exit 0
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --umount)
            if [[ -n "${2:-}" ]]; then
                umount_game "$(basename "$2" .wsquashfs)"
            else
                for g in "${CACHE_DIR}/wine"/*/; do
                    [[ -d "$g" ]] && umount_game "$(basename "$g")"
                done
                unmount_all_stale
            fi
            exit 0
            ;;
        --pack)
            pack_prefix "${2:-}" "${3:-}"
            exit $?
            ;;
        --install)
            install_game "${2:-}" "${3:-}"
            exit $?
            ;;
        --info)
            show_info "${2:-}"
            exit $?
            ;;
        --wine)
            [[ -n "${2:-}" ]] || { echo "Erreur : --wine attend une version ou un chemin"; exit 1; }
            WINE_OVERRIDE="$2"
            shift 2
            ;;
        --mount)
            ACTION="mount"
            shift
            ;;
        --exec)
            ACTION="exec"
            GAME_ARG="${2:-}"
            EXEC_CMD=("${@:3}")
            if [[ -z "$GAME_ARG" || ${#EXEC_CMD[@]} -eq 0 ]]; then
                echo "Usage : $0 --exec <jeu.wsquashfs> <programme> [arguments...]"
                exit 1
            fi
            set --
            ;;
        -*)
            echo "Erreur : option inconnue : $1  (voir $0 --help)"
            exit 1
            ;;
        *)
            if [[ -n "$GAME_ARG" ]]; then
                echo "Erreur : un seul jeu attendu (voir $0 --help)"
                exit 1
            fi
            GAME_ARG="$1"
            shift
            ;;
    esac
done

# ============================================================
# VÉRIFICATIONS
# ============================================================

if [[ -z "$GAME_ARG" ]]; then
    echo "Erreur : fichier .wsquashfs ou dossier de jeu requis"
    echo "Usage : $0 <fichier.wsquashfs | dossier du jeu>  |  $0 --help"
    exit 1
fi

WSQUASHFS_FILE=$(realpath "$GAME_ARG" 2>/dev/null) || {
    echo "Erreur : chemin introuvable : $GAME_ARG"
    exit 1
}

# Jeu installé (--install) : dossier lancé sur place, sans montage.
DIR_MODE=0
if [[ -d "$WSQUASHFS_FILE" ]]; then
    if [[ ! -f "${WSQUASHFS_FILE}/autorun.cmd" && "$ACTION" != "exec" ]]; then
        echo "Erreur : pas d'autorun.cmd dans ${WSQUASHFS_FILE}"
        exit 1
    fi
    if [[ "$ACTION" == "mount" ]]; then
        echo "Erreur : --mount sert aux .wsquashfs ; un dossier installé se modifie directement"
        exit 1
    fi
    DIR_MODE=1
elif [[ "${WSQUASHFS_FILE##*.}" != "wsquashfs" ]]; then
    echo "Erreur : extension .wsquashfs attendue (ou dossier de jeu installé)"
    exit 1
elif [[ ! -f "$WSQUASHFS_FILE" ]]; then
    echo "Erreur : fichier introuvable : $WSQUASHFS_FILE"
    exit 1
fi

if ! command -v wine &>/dev/null && [[ -z "$(find_wine_binary)" ]]; then
    echo "Erreur : aucun binaire Wine trouvé"
    exit 1
fi

if [[ "$DIR_MODE" == "0" ]] && ! command -v squashfuse &>/dev/null && ! command -v unsquashfs &>/dev/null; then
    echo "Erreur : ni squashfuse ni unsquashfs ne sont disponibles"
    echo "  → apt-get install squashfuse squashfs-tools"
    exit 1
fi

# ============================================================
# EN-TÊTE
# ============================================================

GAME_NAME=$(basename "$WSQUASHFS_FILE" .wsquashfs)
ENV_TYPE=$(detect_env)

SQUASHFSPOINT="${CACHE_DIR}/mnt/${GAME_NAME}"
WINEPOINT="${CACHE_DIR}/wine/${GAME_NAME}"
SAVEPOINT="${SAVES_DIR}/${GAME_NAME}"
WORKPOINT="${CACHE_DIR}/work/${GAME_NAME}"

echo "========================================="
echo "WSquashFS Launcher"
echo "========================================="
echo "Environnement : $ENV_TYPE"
echo "Jeu           : $GAME_NAME"
GAME_VERSION=$(game_version "$WSQUASHFS_FILE")
[[ -n "$GAME_VERSION" ]] && echo "Version       : $GAME_VERSION"
echo "Fichier       : $WSQUASHFS_FILE"
[[ "$ACTION" != "run" ]] && echo "Action        : ${ACTION}${EXEC_CMD[0]:+ (${EXEC_CMD[0]})}"

# ============================================================
# MONTAGE
# ============================================================

if [[ "$DIR_MODE" == "1" ]]; then
    # Jeu installé : le dossier est lui-même le prefix, rien à monter.
    WINEPOINT="$WSQUASHFS_FILE"
    SQUASHFSPOINT="" SAVEPOINT="" WORKPOINT=""
    if grep -qszE "^WINEPREFIX=$(printf '%s' "$WINEPOINT" | sed 's/[][\.*^$(){}?+|/]/\\&/g')(/.*)?$" /proc/[0-9]*/environ 2>/dev/null; then
        echo "Erreur : ${GAME_NAME} est déjà lancé"
        exit 1
    fi
    unmount_all_stale
    PACKAGED_PREFIX=0
    [[ -f "${WINEPOINT}/system.reg" ]] && PACKAGED_PREFIX=1
    PROTON_PREFIX=0
    [[ -f "${WINEPOINT}/config_info" ]] && PROTON_PREFIX=1
    rm -f "${WINEPOINT}/.wineserver-lock" "${WINEPOINT}"/reg*.tmp 2>/dev/null || true
    MOUNT_MODE="dir"
    echo "Mode          : dossier (jeu installé, sans FUSE)"
fi

# Ce jeu tourne déjà : ne pas le relancer par-dessus (même montage, même
# prefix — la partie en cours serait coupée).
if [[ "$DIR_MODE" == "0" ]] && game_in_use "$GAME_NAME"; then
    echo "Erreur : ${GAME_NAME} est déjà lancé"
    exit 1
fi

if [[ "$DIR_MODE" == "0" ]]; then
# Nettoyer d'éventuels montages orphelins (celui de ce jeu ET ceux d'autres
# jeux abandonnés en cours de route, voir unmount_all_stale)
unmount_all_stale

mkdir -p "$SQUASHFSPOINT" "$SAVEPOINT" "$WINEPOINT"
# WORKPOINT doit être vide avant chaque montage overlay (évite l'état obsolète)
rm -rf "$WORKPOINT" && mkdir -p "$WORKPOINT"
chown_to_target "$SQUASHFSPOINT"
chown_to_target "$SAVEPOINT"
chown_to_target "$WINEPOINT"
chown_to_target "$WORKPOINT"

# Supprimer les fichiers verrou et fichiers temporaires wineserver obsolètes dans SAVEPOINT
# Les reg*.tmp orphelins (wineserver interrompu) corrompent fuse-overlayfs et causent ESTALE
rm -f "${SAVEPOINT}/wineserver" "${SAVEPOINT}/.wineserver-lock" 2>/dev/null || true
rm -f "${SAVEPOINT}"/reg*.tmp 2>/dev/null || true

# Image = prefix packagé (Batocera : system.reg, drive_c… dans le squashfs)
# ou jeu seul (NBA 2K23, Pinball FX : prefix créé dans les saves au premier
# lancement) ? Lu directement dans l'image (< 0,1 s, même sur 38 Go).
PACKAGED_PREFIX=0
unsquashfs -cat "$WSQUASHFS_FILE" system.reg >/dev/null 2>&1 && PACKAGED_PREFIX=1
# Prefix créé par Proton (config_info) : ses DLL sont gérées par Proton.
PROTON_PREFIX=0
unsquashfs -cat "$WSQUASHFS_FILE" config_info >/dev/null 2>&1 && PROTON_PREFIX=1

# Prefix packagé : system32/syswow64 de l'upperdir ne contiennent que des
# liens/copies régénérés à chaque lancement (sync_wine_stubs, DXVK…) et
# d'anciennes entrées redirect/opaque — effacés. JAMAIS pour un jeu seul
# (26/09) : son system32 EST le prefix (explorer.exe, services.exe…) ; effacé,
# Wine échouait au lancement suivant ("failed to start explorer c0000034").
# Prefix Proton (27/09) : Proton y met à jour ses propres DLL (copies) quand
# sa version change — effacées, le prefix garderait la nouvelle version
# annoncée avec les DLL de l'ancienne. Seuls les liens posés par ce lanceur
# (sync_wine_stubs, DXVK... d'un lancement sans umu) sont retirés.
if [[ "$PACKAGED_PREFIX" == "1" && "$PROTON_PREFIX" == "1" ]]; then
    find "${SAVEPOINT}/drive_c/windows/system32" "${SAVEPOINT}/drive_c/windows/syswow64" \
        -maxdepth 1 -type l -delete 2>/dev/null || true
elif [[ "$PACKAGED_PREFIX" == "1" ]]; then
    rm -rf "${SAVEPOINT}/drive_c/windows/system32" \
           "${SAVEPOINT}/drive_c/windows/syswow64" 2>/dev/null || true
fi

# MODE 1 : overlay (squashfuse + fuse-overlayfs)
if command -v squashfuse &>/dev/null && \
   squashfuse ${ALLOW_OTHER_OPT:+-o "$ALLOW_OTHER_OPT"} "$WSQUASHFS_FILE" "$SQUASHFSPOINT" 2>/dev/null; then
    if command -v fuse-overlayfs &>/dev/null; then
        # Note : redirect_dir=on cause des ESTALE sur les chemins imbriqués lors des
        # remontages successifs (fuse-overlayfs bug). On n'utilise pas cette option.
        if fuse-overlayfs \
               -o "lowerdir=${SQUASHFSPOINT},upperdir=${SAVEPOINT},workdir=${WORKPOINT},${OVERLAY_SQUASH_OPT}${ALLOW_OTHER_OPT:+,$ALLOW_OTHER_OPT}" \
               "$WINEPOINT" 2>/dev/null; then
            MOUNT_MODE="overlay"
            MOUNTED=true
            echo "Mode          : overlay (squashfuse + fuse-overlayfs)"
        else
            do_umount "$SQUASHFSPOINT"
        fi
    else
        do_umount "$SQUASHFSPOINT"
    fi
fi

# MODE 2/3 : copy (squashfuse→copie ou unsquashfs)
if [[ -z "$MOUNT_MODE" ]]; then
    WSQUASHFS_INFO="${WSQUASHFS_FILE}:$(stat -c '%s:%Y' "$WSQUASHFS_FILE" 2>/dev/null)"
    CACHE_INFO_FILE="${WINEPOINT}/.wsquashfs_cache"

    if [[ -d "$WINEPOINT" ]] && [[ -f "$CACHE_INFO_FILE" ]] && \
       [[ "$(cat "$CACHE_INFO_FILE" 2>/dev/null)" == "$WSQUASHFS_INFO" ]]; then
        echo "Mode          : copy (cache valide, extraction ignorée)"
        MOUNT_MODE="copy"
        MOUNTED=true
    else
        do_fresh_extraction || exit 1
        MOUNT_MODE="copy"
        MOUNTED=true
    fi
fi
fi  # DIR_MODE == 0

# --mount : le jeu reste monté (cleanup ne démonte pas), pour le modifier à
# la main — fichiers de config, sauvegardes, remplacement d'un fichier.
if [[ "$ACTION" == "mount" ]]; then
    MOUNTED=false
    echo "-----------------------------------------"
    echo "Monté dans    : $WINEPOINT"
    [[ "$MOUNT_MODE" == "overlay" ]] && echo "Modifications : enregistrées dans $SAVEPOINT (le .wsquashfs n'est jamais modifié)"
    echo "Démontage     : $0 --umount \"$WSQUASHFS_FILE\""
    echo "  (tout lancement d'un autre jeu démonte aussi les montages inutilisés)"
    exit 0
fi

# ============================================================
# LECTURE DE AUTORUN.CMD
# ============================================================

AUTORUN_FILE="${WINEPOINT}/autorun.cmd"
if [[ ! -f "$AUTORUN_FILE" && "$ACTION" != "exec" ]]; then
    echo "Erreur : autorun.cmd introuvable dans le wsquashfs"
    exit 1
fi

DIR=$(unquote "$(getWine_var "$WINEPOINT" "DIR" "")")
CMD=$(getWine_var "$WINEPOINT" "CMD" "")
WINE_VERSION=$(getWine_var "$WINEPOINT" "WINE" "")
PROTON_VERSION=$(getWine_var "$WINEPOINT" "PROTON" "")
RUNNER=$(getWine_var "$WINEPOINT" "RUNNER" "")
WINE_ARCH=$(getWine_var "$WINEPOINT" "ARCH" "")
# DXVK activé par défaut (contrairement à Batocera) : sous Xwayland + NVIDIA,
# l'OpenGL de wined3d tombe sur llvmpipe (rendu logiciel, confirmé en direct)
# alors que Vulkan voit bien le GPU. DXVK=0 dans autorun.cmd (par jeu) ou
# WSQUASHFS_DXVK=0 (global) pour revenir aux DLL intégrées de Wine.
DXVK=$(getWine_var "$WINEPOINT" "DXVK" "${WSQUASHFS_DXVK:-1}")
if [[ "$DXVK" == "1" && -z "$(find_dxvk_dir)" ]]; then
    echo "Attention : DXVK introuvable (/usr/share/dxvk), rendu via wined3d"
    DXVK=0
fi
# VKD3D activé par défaut (pas 0) : le d3d12.dll natif de Wine dépend de
# stubs noyau (win32k.sys/dxgkrnl.sys/dxgmms1.sys, "SharedGpuResources")
# qui échouent à charger dans ce genre d'environnement conteneurisé sans
# vrai pilote graphique côté noyau Windows émulé — confirmé en direct :
# tout jeu D3D12 termine en page fault. vkd3d-proton traduit directement
# vers Vulkan, sans ces stubs. Inoffensif pour un jeu qui ne charge jamais
# d3d12.dll (l'override ne fait alors simplement rien). Un jeu packagé
# avec VKD3D=0 explicite dans son autorun.cmd garde la priorité.
VKD3D=$(getWine_var "$WINEPOINT" "VKD3D" "1")
if [[ "$VKD3D" == "1" && -z "$(find_vkd3d_dir)" ]]; then
    echo "Attention : VKD3D-Proton introuvable (/usr/share/vkd3d-proton), Direct3D 12 indisponible"
    VKD3D=0
fi
# d7vk activé par défaut, pour la même raison que DXVK (OpenGL = llvmpipe
# ici) ; sans effet sur un jeu qui ne charge pas ddraw.dll. D7VK=0 dans
# l'autorun.cmd ou WSQUASHFS_D7VK=0 pour l'écarter.
D7VK=$(getWine_var "$WINEPOINT" "D7VK" "${WSQUASHFS_D7VK:-1}")
[[ "$D7VK" == "1" && -z "$(find_d7vk)" ]] && D7VK=0
SAVEDIR=$(unquote "$(getWine_var "$WINEPOINT" "SAVEDIR" "")")
SAVEFILES=$(unquote "$(getWine_var "$WINEPOINT" "SAVEFILES" "")")
ESYNC=$(getWine_var "$WINEPOINT" "ESYNC" "0")
FSYNC=$(getWine_var "$WINEPOINT" "FSYNC" "0")
WINE_LANG=$(getWine_var "$WINEPOINT" "LANG" "")
WINE_ENV=$(getWine_var "$WINEPOINT" "ENV" "")
# Bureau virtuel Wine — évite les crashs KDE/WM quand le jeu change la résolution.
# Priorité : autorun.cmd (VIRTUAL_DESKTOP=1920x1080) > variable d'env WSQUASHFS_VIRTUAL_DESKTOP.
VIRTUAL_DESKTOP=$(getWine_var "$WINEPOINT" "VIRTUAL_DESKTOP" "${WSQUASHFS_VIRTUAL_DESKTOP:-}")

if [[ -z "$CMD" && "$ACTION" != "exec" ]]; then
    echo "Erreur : CMD non défini dans autorun.cmd"
    exit 1
fi

# ============================================================
# PARSING DE CMD
# ============================================================

# Windows ignore la casse, les autorun.cmd Batocera aussi : "game.exe" pour
# Game.exe (Rabbids Hollywood Arcade, confirmé en direct). DIR et CMD sont
# résolus composant par composant, sans tenir compte de la casse.
DIR="${DIR//\\//}"
if [[ -n "$DIR" ]]; then
    DIR_RESOLVED=$(resolve_ci "$WINEPOINT" "$DIR") && DIR="${DIR_RESOLVED#"$WINEPOINT"/}"
fi

declare -a EXEC_ARGS_ARR=()
if [[ "$ACTION" == "exec" ]]; then
    # --exec : fichier du prefix (depuis sa racine, puis depuis le DIR de
    # l'autorun.cmd), sinon outil Wine lancé tel quel (winecfg, regedit...).
    prog="${EXEC_CMD[0]//\\//}"
    EXEC_ARGS_ARR=("${EXEC_CMD[@]:1}")
    if EXEC_PATH=$(resolve_ci "$WINEPOINT" "$prog") && [[ -f "$EXEC_PATH" ]]; then
        DIR=$(dirname "${EXEC_PATH#"$WINEPOINT"/}"); [[ "$DIR" == "." ]] && DIR=""
    elif [[ -n "$DIR" ]] && EXEC_PATH=$(resolve_ci "$WINEPOINT" "${DIR}/${prog}") && [[ -f "$EXEC_PATH" ]]; then
        DIR=$(dirname "${EXEC_PATH#"$WINEPOINT"/}")
    else
        EXEC_PATH="${EXEC_CMD[0]}"
        DIR=""
    fi
else
    if [[ "$CMD" =~ ^\"([^\"]+)\"(.*)$ ]]; then
        EXEC_NAME="${BASH_REMATCH[1]}"
        EXEC_ARGS="${BASH_REMATCH[2]# }"
    else
        EXEC_NAME=$(echo "$CMD" | awk '{print $1}')
        EXEC_ARGS=$(echo "$CMD" | cut -d' ' -f2- -s)
    fi
    read -ra EXEC_ARGS_ARR <<< "$EXEC_ARGS"
    EXEC_PATH=$(resolve_ci "$WINEPOINT" "${DIR:+$DIR/}${EXEC_NAME}") \
        || EXEC_PATH="${WINEPOINT}/${DIR:+$DIR/}${EXEC_NAME}"
    if [[ ! -f "$EXEC_PATH" ]]; then
        echo "Erreur : exécutable introuvable : $EXEC_PATH"
        echo "  CMD : $CMD  |  DIR : ${DIR:-<vide>}"
        exit 1
    fi
fi

EXT="${EXEC_PATH##*.}"
EXT="${EXT,,}"

# ============================================================
# BINAIRE WINE
# ============================================================

# Base : Wine le plus compatible avec les prefixes Batocera
WINE_BINARY=$(find_wine_binary)

# Prefix créé par Proton (Heroic, Steam) : lancé sous Proton, la même
# version si elle est installée, plutôt que sous le Wine par défaut.
PREFIX_PROTON=$(prefix_proton_version)
# --wine <Proton> (30/09) : sur un prefix Proton ou un jeu sans prefix, lancé
# par umu comme PROTON= de l'autorun.cmd — auparavant seul le binaire wine du
# Proton était pris, sans umu ni script proton (mode dégradé, écran noir de
# Kingdom Hearts III). Sur un prefix Wine (Batocera), inchangé : Wine du
# Proton lancé directement, Proton ne sachant pas convertir ces prefixes.
# FORCED_WINE : runner Wine imposé (autorun.cmd ou --wine hors ce cas).
OVERRIDE_PROTON=""
if [[ -n "$WINE_OVERRIDE" ]] && found=$(resolve_wine_override "$WINE_OVERRIDE") \
   && [[ "$found" == */files/bin/wine && -x "${found%/files/bin/wine}/proton" ]] \
   && [[ -n "$PREFIX_PROTON" || ! -f "${WINEPOINT}/system.reg" ]]; then
    OVERRIDE_PROTON="${found%/files/bin/wine}"
fi
FORCED_WINE="${RUNNER}${WINE_VERSION}"
[[ -n "$WINE_OVERRIDE" && -z "$OVERRIDE_PROTON" ]] && FORCED_WINE+="$WINE_OVERRIDE"
# Image sans prefix (jeu seul : jeu PC récent emballé à la main, 27/09) :
# prefix créé par Proton via umu — proton-cachyos, sinon UMU-Proton, sinon
# GE-Proton —, les
# prefixes Batocera (jeux arcade) restant sous wine-tkg. Un prefix Wine
# déjà créé dans les sauvegardes est gardé tel quel : Proton ne sait pas
# le convertir (DRAGON BALL Sparking! ZERO, 27/09 : copy_pfx en échec,
# puis manettes perdues sous Wine avec les DLL de Proton). WINE=tkg dans
# l'autorun.cmd pour garder wine-tkg.
AUTO_PROTON=0
if [[ -z "$PREFIX_PROTON" && "$PACKAGED_PREFIX" == "0" && -z "$FORCED_WINE" ]]; then
    if [[ -f "${WINEPOINT}/system.reg" ]]; then
        if [[ "$DIR_MODE" == "1" ]]; then
            echo "Attention : prefix Wine déjà créé dans ${WINEPOINT}, gardé sous $(basename "$(dirname "$(dirname "$WINE_BINARY")")") (Proton ne sait pas le convertir)"
        else
            echo "Attention : prefix Wine déjà créé dans les sauvegardes, gardé sous $(basename "$(dirname "$(dirname "$WINE_BINARY")")") — supprimer ${SAVEPOINT} (sauvegardes du jeu comprises) pour passer sous Proton"
        fi
    else
        AUTO_PROTON=1
    fi
fi
if [[ -n "$PREFIX_PROTON" || "$AUTO_PROTON" == "1" ]]; then
    if found=$(find_proton_runner "$PREFIX_PROTON") && [[ -n "$found" ]]; then
        WINE_BINARY="${found}/files/bin/wine"
        [[ -z "$PREFIX_PROTON" ]] || proton_runner_is "$found" "$PREFIX_PROTON" || \
            echo "Attention : prefix créé par ${PREFIX_PROTON} (absent), utilisation de $(basename "$found")"
    else
        echo "Attention : prefix Proton${PREFIX_PROTON:+ (${PREFIX_PROTON})} voulu, aucun Proton installé, utilisation de $(basename "$WINE_BINARY")"
        AUTO_PROTON=0
    fi
fi

# Surcharge via autorun.cmd
if [[ -n "$RUNNER" ]]; then
    if [[ -x "$RUNNER" ]]; then
        WINE_BINARY="$RUNNER"
    else
        echo "Attention : runner ${RUNNER} non exécutable, utilisation de $(basename "$WINE_BINARY")"
    fi
elif [[ -n "$PROTON_VERSION" ]]; then
    if found=$(find_proton_runner "$PROTON_VERSION") && [[ -n "$found" ]]; then
        WINE_BINARY="${found}/files/bin/wine"
    elif [[ -x "/usr/local/bin/proton" ]]; then
        WINE_BINARY="/usr/local/bin/proton"
    else
        echo "Attention : Proton absent, utilisation de $(basename "$WINE_BINARY")"
    fi
elif [[ -n "$WINE_VERSION" ]]; then
    found=""
    # WINE=system (30/09) : le Wine du système, comme --wine system. Jeux
    # 32 bits qui échouent sous wine-tkg (non WoW64) mais passent en WoW64 :
    # GTI Club (réservation de 450 Mo refusée), Castlevania (mmap du son).
    # Valeur ignorée par Batocera, qui choisit son runner dans ES.
    if [[ "${WINE_VERSION,,}" == "system" ]]; then
        found=$(command -v wine)
    fi
    for d in "/opt/wine-${WINE_VERSION}" "$HOME/.local/share/wsquashfs/wine/wine-${WINE_VERSION}"; do
        [[ -n "$found" ]] && break
        [[ -x "${d}/bin/wine" ]] && found="${d}/bin/wine" && break
    done
    if [[ -n "$found" ]]; then
        WINE_BINARY="$found"
    else
        echo "Attention : Wine ${WINE_VERSION} absent, utilisation de $(basename "$WINE_BINARY")"
    fi
fi

# --wine (ligne de commande) : prioritaire sur l'autorun.cmd.
if [[ -n "$WINE_OVERRIDE" ]]; then
    if found=$(resolve_wine_override "$WINE_OVERRIDE") && [[ -n "$found" ]]; then
        WINE_BINARY="$found"
    else
        echo "Erreur : runner Wine introuvable : ${WINE_OVERRIDE}"
        echo "  Runners installés :"
        list_wine_runners | sed 's/^/    /'
        echo "    system ($(command -v wine 2>/dev/null || echo absent))"
        exit 1
    fi
fi

# Prefix Proton (ou PROTON= dans l'autorun.cmd) sans runner Wine imposé :
# lancé via umu avec le script proton, comme Heroic (27/09, Kingdom Hearts
# III : écran noir puis LowLevelFatalError avec le seul binaire wine de
# GE-Proton, menu du jeu atteint via umu). Proton gère alors lui-même le
# prefix, DXVK, VKD3D et NVAPI.
UMU_RUN=""
PROTON_DIR=""
if [[ -n "${PREFIX_PROTON}${PROTON_VERSION}${OVERRIDE_PROTON}" || "$AUTO_PROTON" == "1" ]] \
   && [[ -z "$FORCED_WINE" ]]; then
    if [[ -z "$PREFIX_PROTON" && -f "${WINEPOINT}/system.reg" ]]; then
        # PROTON= sur un prefix Wine existant : conversion impossible (voir
        # AUTO_PROTON), on reste sur le Wine par défaut.
        WINE_BINARY=$(find_wine_binary)
        echo "Attention : PROTON=${PROTON_VERSION} ignoré, prefix Wine existant — Proton ne sait pas le convertir"
    elif [[ "$WINE_BINARY" == */files/bin/wine ]] && [[ -x "${WINE_BINARY%/files/bin/wine}/proton" ]] \
       && UMU_RUN=$(find_umu_run); then
        PROTON_DIR="${WINE_BINARY%/files/bin/wine}"
        export GAMEID="${GAMEID:-umu-default}" PROTONPATH="$PROTON_DIR"
    elif [[ "$AUTO_PROTON" == "1" ]]; then
        UMU_RUN=""
        WINE_BINARY=$(find_wine_binary)
        echo "Attention : umu-run absent, prefix créé par $(basename "$(dirname "$(dirname "$WINE_BINARY")")") au lieu de Proton"
    else
        UMU_RUN=""
        echo "Attention : prefix Proton lancé directement par Wine (umu-run ou Proton absent) — rendu ou stabilité possiblement dégradés"
    fi
fi

# Outils Wine lancés sur le prefix (regedit, reg) : par umu pour un prefix
# Proton — lancés par un autre wine, ils mettraient le prefix à jour pour
# ce wine, hors de Proton.
WINE_TOOL=("$WINE_BINARY")
[[ -n "$UMU_RUN" ]] && WINE_TOOL=("$UMU_RUN")

# ============================================================
# CONFIGURATION WINE
# ============================================================

# Architecture : autorun.cmd → system.reg → défaut win64
if [[ -z "$WINE_ARCH" ]]; then
    WINE_ARCH=$(detect_prefix_arch)
fi

# Prefix win32 : il faut un Wine "classique" (avec i386-unix). Les builds
# WoW64 seuls (wine-staging d'Arch depuis 2025) refusent ces prefixes —
# confirmé en direct : "... is a 32-bit installation, it cannot support
# 64-bit applications" (Lethal Enforcers 3, konamipc). batocera-wine fait le
# même constat (setPrefixArch). On cherche un runner compatible installé.
if [[ "$WINE_ARCH" == "win32" ]] && ! wine_supports_win32 "$WINE_BINARY"; then
    alt=""
    if [[ -n "$WINE_OVERRIDE" ]]; then
        echo "Erreur : prefix win32, mais le runner choisi (--wine ${WINE_OVERRIDE}) est WoW64 seul"
        exit 1
    fi
    while IFS= read -r -d '' w; do
        wine_supports_win32 "$w" && { alt="$w"; break; }
    done < <(find /usr/wine /opt "$HOME/.local/share/wsquashfs/wine" -maxdepth 3 \
                 -path '*/bin/wine' -print0 2>/dev/null)
    if [[ -n "$alt" ]]; then
        WINE_BINARY="$alt"
    else
        echo "Erreur : prefix win32, mais $(basename "$WINE_BINARY") est un Wine WoW64 seul"
        echo "  (pas de lib/wine/i386-unix) qui ne peut pas lancer de prefix 32 bits."
        echo "  → Installer un Wine classique (ex. Kron4ek wine-*-amd64, non wow64)"
        echo "    dans /opt ou ~/.local/share/wsquashfs/wine"
        exit 1
    fi
fi

export WINEPREFIX="$WINEPOINT"
export WINEARCH="$WINE_ARCH"

# Adapter le nom d'utilisateur Wine au prefix (évite l'erreur de création de profil).
# Les prefixes Batocera sont packagés avec "steamuser" — si on tourne sous un autre user,
# Wine essaie de créer drive_c/users/$USER à travers l'overlay, ce qui produit ESTALE.
PREFIX_USERNAME=$(detect_wine_username)
# Comparer contre TARGET_USER (pas $USER, qui vaudrait "root" ici) quand on
# a été élevé : c'est TARGET_USER qui lancera réellement Wine plus loin.
EFFECTIVE_USER="$USER"
[[ "$RUN_AS_ROOT" == true && -n "$TARGET_USER" ]] && EFFECTIVE_USER="$TARGET_USER"
if [[ -n "$PREFIX_USERNAME" && "$PREFIX_USERNAME" != "$EFFECTIVE_USER" ]]; then
    export WINEUSERNAME="$PREFIX_USERNAME"
fi

[[ "$ESYNC" == "1" ]] && export WINEESYNC=1
[[ "$FSYNC" == "1" ]] && export WINEFSYNC=1

if [[ -n "$UMU_RUN" ]]; then
    # Proton pose lui-même DXVK/VKD3D/NVAPI dans le prefix. DXVK=0 (autorun
    # ou WSQUASHFS_DXVK=0) passe par son équivalent Proton : sans lui, Proton
    # gardait DXVK et DXVK=0 était ignoré (constaté le 01/10, variable bien
    # reçue par le jeu après correction).
    [[ "$DXVK" == "0" ]] && export PROTON_USE_WINED3D=1
    DXVK=0 VKD3D=0 D7VK=0
else
if [[ "$D7VK" == "1" ]]; then
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}ddraw=n,b"
fi
if [[ "$DXVK" == "1" ]]; then
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}d3d8,d3d9,d3d10core,d3d11,dxgi=n,b"
else
    # Explicite, comme Batocera : un prefix peut contenir des copies natives
    # de DXVK que Wine chargerait sinon.
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}d3d8,d3d9,d3d10core,d3d11,dxgi=b"
fi
if [[ "$VKD3D" == "1" ]]; then
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}d3d12,d3d12core=n,b"
fi
fi

# Borne arcade : Wine ne doit rien ouvrir côté Linux. winebrowser ouvrait
# Chrome (profil réel de l'utilisateur) sur la session du stream quand
# TeknoParrot affichait une page — confirmé en direct (Initial D Zero) ;
# winemenubuilder crée des raccourcis de menu (batocera-wine le coupe aussi).
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}winemenubuilder.exe=d;winebrowser.exe=d"

# Batocera exporte WINEDEBUG=-all (les fixme ralentissent certains jeux) ;
# on garde les err: pour le diagnostic. Surchargeable depuis l'environnement.
export WINEDEBUG="${WINEDEBUG:-fixme-all}"

[[ -n "$WINE_LANG" ]] && export LC_ALL="$WINE_LANG"
[[ -n "$WINE_ENV" ]] && apply_wine_env "$WINE_ENV"

# Jeu seul dont le prefix a perdu son system32 (effacé à chaque lancement
# par les versions du 25-26/09, voir PACKAGED_PREFIX) : réparé par wineboot.
if [[ -n "$UMU_RUN" ]]; then
    # Prefix créé ou mis à jour par Proton lui-même au lancement.
    [[ -f "${WINEPOINT}/system.reg" ]] || echo "Initialisation du préfixe par Proton au premier lancement..."
elif [[ -f "${WINEPOINT}/system.reg" ]] && [[ -d "${WINEPOINT}/drive_c" ]] \
   && { [[ "$PACKAGED_PREFIX" == "1" ]] || [[ -f "${WINEPOINT}/drive_c/windows/system32/explorer.exe" ]]; }; then
    echo "✓ Préfixe Wine détecté (structure Batocera)"
else
    # .wsquashfs sans prefix (jeu seul : NBA 2K23, Robin Hood...) : prefix
    # créé dans l'overlay. En tant qu'utilisateur Wine — lancé en root, Wine
    # refusait ("... is not owned by you", confirmé en campagne de test) et
    # le lanceur restait bloqué.
    echo "Initialisation du préfixe Wine ($WINE_ARCH)..."
    # Réparation : wineboot -u ne réinstalle RIEN tant que .update-timestamp
    # correspond à la version de Wine (vérifié le 26/09 : 0 fichier recréé,
    # 816 sans l'horodatage). Sans effet sur un prefix neuf.
    rm -f "${WINEPOINT}/.update-timestamp"
    as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
        WINEDEBUG="$WINEDEBUG" WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d" \
        "$WINE_BINARY" wineboot -u 2>&1 | grep -v "fixme:" || true
    as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -w 2>/dev/null || true
    # Overlay : JAMAIS de chown -R sur WINEPOINT (le montage) — chaque fichier
    # du jeu serait recopié dans SAVEPOINT (confirmé en direct : 70 Go sur
    # NBA 2K23). L'upperdir suffit, squash_to_uid s'occupe du reste.
    if [[ "$MOUNT_MODE" == "overlay" ]]; then
        chown_to_target "$SAVEPOINT"
    else
        chown_to_target "$WINEPOINT"
    fi
fi

[[ -z "$UMU_RUN" ]] && update_prefix_if_needed
fix_userdata_links

# Synchroniser les DLLs Wine manquantes (compatibilité prefixes Batocera / Wine 10+).
# En mode overlay : écriture dans SAVEPOINT (upperdir) pour éviter EPERM copy-up sur
# les répertoires root-owned (system32, syswow64) par fuse-overlayfs non-privilégié.
# Après écriture dans l'upperdir, on recharge l'overlay pour que les DLLs soient visibles
# (fuse-overlayfs cache les listdir au montage et ne voit pas les fichiers ajoutés après).
if [[ -n "$UMU_RUN" ]]; then
    :   # prefix géré par Proton
elif [[ "$MOUNT_MODE" == "overlay" ]]; then
    sync_wine_stubs "$WINE_BINARY" "$SAVEPOINT"
    [[ "$DXVK" == "1" ]] && install_dxvk "$SAVEPOINT"
    [[ "$VKD3D" == "1" ]] && install_vkd3d "$SAVEPOINT"
    [[ "$D7VK" == "1" ]] && install_d7vk "$SAVEPOINT"
    # Les DLLs viennent d'être copiées en root dans l'upperdir — sans ce
    # chown, Wine (relancé en TARGET_USER) verrait un prefix appartenant en
    # partie à root une fois l'overlay rechargé.
    chown_to_target "$SAVEPOINT"
    # Recharger l'overlay pour que fuse-overlayfs voie les nouveaux fichiers dans l'upperdir
    reload_overlay "après sync DLLs"
else
    sync_wine_stubs "$WINE_BINARY"
    [[ "$DXVK" == "1" ]] && install_dxvk
    [[ "$VKD3D" == "1" ]] && install_vkd3d
    [[ "$D7VK" == "1" ]] && install_d7vk
    chown_to_target "$WINEPOINT"
fi

if [[ -d "${WINEPOINT}/regs" ]]; then
    echo "Import des fichiers de registre..."
    while IFS= read -r -d '' regfile; do
        echo "  → $(basename "$regfile")"
        as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
            WINEDEBUG="$WINEDEBUG" WINEDLLOVERRIDES="$WINEDLLOVERRIDES" \
            GAMEID="${GAMEID:-}" PROTONPATH="${PROTONPATH:-}" \
            "${WINE_TOOL[@]}" regedit "//?/unix${regfile}" 2>/dev/null || true
    done < <(find "${WINEPOINT}/regs" -maxdepth 1 -type f -iname "*.reg" -print0)
fi

# Manettes par hidraw dans Wine — option enable_hidraw de batocera-wine,
# DÉSACTIVÉE par défaut comme chez Batocera : XInput (manette Xbox via
# SDL), que tous les jeux comprennent. Essayée par défaut deux fois, deux
# fois abandonnée avec la DualSense virtuelle de Sunshine (uhid, seule
# lisible par hidraw) : touches décalées (24/09 : SNK Heroines, Sonic &
# All-Stars Racing), puis aucune commande reçue par un jeu XInput seul
# (27/09 : DRAGON BALL Sparking! ZERO, icônes Xbox même en hidraw).
# HIDRAW=1 dans l'autorun.cmd (par jeu, emballé avec lui) ou
# WSQUASHFS_HIDRAW=1 (prioritaire) pour un jeu qui gère la DualSense
# lui-même — seulement si la manette Sony est lisible (hidraw_usable),
# sinon repli XInput : le jeu n'aurait aucune manette. La valeur est
# imposée dans les deux sens à chaque lancement.
HIDRAW_DISABLE=1 HIDRAW_MSG="XInput, manette Xbox"
if [[ "${WSQUASHFS_HIDRAW:-$(getWine_var "$WINEPOINT" "HIDRAW" "0")}" == "1" ]]; then
    if hidraw_usable; then
        HIDRAW_DISABLE=0 HIDRAW_MSG="DualSense/DualShock en direct (hidraw)"
    else
        HIDRAW_MSG="XInput, manette Xbox (hidraw demandé : ${HIDRAW_REASON})"
    fi
fi
# GE-Proton (30/09) : sa SDL ignore TOUJOURS les manettes Sony ("ignoring SDL
# DualSense device; hidraw handles native reports") et les laisse au backend
# hidraw. Hidraw coupé (mode XInput par défaut), la DualSense n'était gérée
# par personne : aucune manette dans Kena, The Devil in Me, Like a Dragon...
# quand Pinball FX (wine-tkg, prefix Batocera) marchait. En mode XInput, on
# garde donc hidraw et GE-Proton présente la manette Sony en XInput
# (PROTON_SONY_HIDRAW_XINPUT). Les Proton de Valve (UMU-Proton,
# proton-cachyos) n'ont pas ce correctif : leur SDL gère la DualSense.
PROTON_ROOT=""
[[ "$WINE_BINARY" == */files/bin/wine ]] && PROTON_ROOT="${WINE_BINARY%/files/bin/wine}"
if [[ "$HIDRAW_DISABLE" == "1" && -n "$PROTON_ROOT" ]] \
   && grep -aqs "hidraw handles native reports" "${PROTON_ROOT}/files/lib/wine/x86_64-unix/winebus.so" \
   && hidraw_usable; then
    HIDRAW_DISABLE=0
    export PROTON_SONY_HIDRAW_XINPUT=1
    HIDRAW_MSG="XInput, manette Xbox (manette Sony par hidraw, convertie par GE-Proton)"
fi
# Prefix Proton : registre dans pfx/ (sinon reg add à chaque lancement).
if ! grep -qs "\"DisableHidraw\"=dword:0000000${HIDRAW_DISABLE}" "${WINEPOINT}/system.reg" "${WINEPOINT}/pfx/system.reg"; then
    as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
        WINEDEBUG="$WINEDEBUG" WINEDLLOVERRIDES="$WINEDLLOVERRIDES" \
        GAMEID="${GAMEID:-}" PROTONPATH="${PROTONPATH:-}" \
        "${WINE_TOOL[@]}" reg add 'HKLM\System\CurrentControlSet\Services\winebus' \
        /v DisableHidraw /t REG_DWORD /d "${HIDRAW_DISABLE}" /f >/dev/null 2>&1 || true
    as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -k 2>/dev/null || true
    as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -w 2>/dev/null || true
fi

apply_savedir "$SAVEDIR" "$SAVEFILES"

# ============================================================
# RÉCAPITULATIF
# ============================================================

echo "-----------------------------------------"
echo "Exécutable    : $EXEC_PATH"
echo "Arguments     : ${EXEC_ARGS:-<aucun>}"
if [[ -n "$UMU_RUN" ]]; then
    echo "Proton        : $(basename "$PROTON_DIR") via umu ($PROTON_DIR)"
else
    echo "Wine          : $WINE_BINARY ($WINE_ARCH)"
fi
echo "Préfixe       : $WINEPREFIX"
[[ -n "$WINEUSERNAME" ]] && echo "Utilisateur   : $WINEUSERNAME (adapté au prefix)"
if [[ "$RUN_AS_ROOT" == true ]]; then
    if [[ -n "$TARGET_USER" ]]; then
        echo "Privilège     : montage en root, Wine relancé en $TARGET_USER"
    else
        echo "Attention     : lancé en root sans SUDO_USER — l'affichage risque d'échouer (pas de cookie X11)"
    fi
fi
[[ "$MOUNT_MODE" == "overlay" ]] && echo "Sauvegardes   : $SAVEPOINT"
echo "Manettes      : $HIDRAW_MSG"
[[ "$DXVK"  == "1" ]] && echo "DXVK          : activé"
[[ "$VKD3D" == "1" ]] && echo "VKD3D         : activé"
[[ "$D7VK"  == "1" ]] && echo "D7VK          : activé (DirectDraw → Vulkan)"
[[ "$ESYNC" == "1" ]] && echo "ESYNC         : activé"
[[ "$FSYNC" == "1" ]] && echo "FSYNC         : activé"
[[ -n "$WINE_LANG" ]] && echo "Langue        : $WINE_LANG"
[[ -n "$VIRTUAL_DESKTOP" ]] && echo "Bureau virtuel: ${VIRTUAL_DESKTOP}"
echo "========================================="
echo ""

# ============================================================
# EXÉCUTION
# ============================================================

WORKDIR="$WINEPOINT"
[[ -n "$DIR" ]] && WORKDIR="${WINEPOINT}/${DIR}"
cd "$WORKDIR" || exit 1

declare -a RUN_CMD

if [[ -n "$VIRTUAL_DESKTOP" ]]; then
    # Bureau virtuel : empêche le jeu de changer la résolution système (crash KDE/WM)
    DESKTOP_NAME=$(echo "$GAME_NAME" | tr ' ' '_' | tr -cd 'a-zA-Z0-9_')
    if [[ "$EXT" == "bat" ]]; then
        RUN_CMD=("$WINE_BINARY" explorer "/desktop=${DESKTOP_NAME},${VIRTUAL_DESKTOP}" \
                 cmd /c "$EXEC_PATH" "${EXEC_ARGS_ARR[@]}")
    else
        RUN_CMD=("$WINE_BINARY" explorer "/desktop=${DESKTOP_NAME},${VIRTUAL_DESKTOP}" \
                 "$EXEC_PATH" "${EXEC_ARGS_ARR[@]}")
    fi
elif [[ "$EXT" == "bat" ]]; then
    RUN_CMD=("$WINE_BINARY" cmd /c "$EXEC_PATH" "${EXEC_ARGS_ARR[@]}")
else
    RUN_CMD=("$WINE_BINARY" "$EXEC_PATH" "${EXEC_ARGS_ARR[@]}")
fi
# umu-run prend la place de wine : même ligne de commande (exécutable Unix,
# explorer, cmd /c...), transmise au script proton.
[[ -n "$UMU_RUN" ]] && RUN_CMD[0]="$UMU_RUN"

if [[ "$RUN_AS_ROOT" == true ]] && [[ -n "$TARGET_USER" ]]; then
    # SDL_* : winebus (manettes Wine) lit les manettes via SDL — sans ces
    # variables, un mapping SDL_GAMECONTROLLERCONFIG et
    # SDL_JOYSTICK_DISABLE_UDEV de la session étaient perdus ici.
    # env explicite plutôt que `sudo --preserve-env` : certaines politiques
    # sudoers restreignent --preserve-env (env_reset sans autorisation
    # explicite), alors que passer des VAR=valeur à `env` en argument
    # fonctionne toujours, quelle que soit la politique de l'appelant.
    sudo -u "$TARGET_USER" env \
        DISPLAY="${DISPLAY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        WINEPREFIX="$WINEPREFIX" \
        WINEARCH="$WINEARCH" \
        WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}" \
        WINEESYNC="${WINEESYNC:-}" \
        WINEFSYNC="${WINEFSYNC:-}" \
        WINEUSERNAME="${WINEUSERNAME:-}" \
        LC_ALL="${LC_ALL:-}" \
        WINEDEBUG="${WINEDEBUG:-}" \
        GAMEID="${GAMEID:-}" \
        PROTONPATH="${PROTONPATH:-}" \
        SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG:-}" \
        SDL_JOYSTICK_DISABLE_UDEV="${SDL_JOYSTICK_DISABLE_UDEV:-}" \
        PROTON_SONY_HIDRAW_XINPUT="${PROTON_SONY_HIDRAW_XINPUT:-}" \
        MANGOHUD="${MANGOHUD:-}" \
        MANGOHUD_CONFIG="${MANGOHUD_CONFIG:-}" \
        MANGOHUD_CONFIGFILE="${MANGOHUD_CONFIGFILE:-}" \
        "${RUN_CMD[@]}"
else
    "${RUN_CMD[@]}"
fi
EXIT_CODE=$?

# Beaucoup de jeux passent par un lanceur qui démarre le vrai exécutable puis
# quitte aussitôt (ring_loader.exe → DOA5A.exe, TeknoParrotUi → OpenParrot) :
# sans cette attente, cleanup() tuait le jeu à peine lancé via
# stop_wineserver — confirmé en direct sur Dead or Alive 5 Ultimate (segare).
# Comme Batocera : on attend que tous les processus du prefix aient terminé.
as_wine_user env WINEPREFIX="$WINEPOINT" wineserver -w 2>/dev/null || true

echo ""
echo "========================================="
echo "Jeu terminé (code : $EXIT_CODE)"
echo "========================================="

exit $EXIT_CODE
