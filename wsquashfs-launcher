# ── --clean / --clear ──────────────────────────────────────────────────

# Vrai si rel (chemin relatif dans l'upperdir) est sous un dossier opaque :
# le dossier de l'image y est masqué, le fichier de l'upperdir est alors le
# seul visible, même identique. fuse-overlayfs marque les dossiers opaques
# par l'attribut user.fuseoverlayfs.opaque ou un fichier .wh..wh..opq,
# l'overlay noyau par user.overlay.opaque.
under_opaque() {
    local upper="$1" d="$2"
    while [[ "$d" == */* ]]; do
        d="${d%/*}"
        if [[ -z "${OPAQUE_CACHE[$d]:-}" ]]; then
            OPAQUE_CACHE[$d]=n
            if [[ -e "${upper}/${d}/.wh..wh..opq" ]] \
               || getfattr -d -m '^user\.(fuseoverlayfs|overlay)\.opaque$' "${upper}/${d}" 2>/dev/null | grep -q '="y"'; then
                OPAQUE_CACHE[$d]=y
            fi
        fi
        [[ "${OPAQUE_CACHE[$d]}" == y ]] && return 0
    done
    return 1
}

# --clean (01/10) : retire des sauvegardes de chaque jeu les doublons
# certains, régénérés ou relus ailleurs ; tout ce que le jeu a écrit reste.
# 1. Fichiers identiques à ceux de l'image — copy-up d'un fichier que le
#    jeu ouvre en écriture sans le modifier (Streets of Rage 4 : 2,7 Go de
#    textures, Trouble Witches : 870 Mo de .PACK) ; ils redeviennent lus
#    depuis l'image. Image retrouvée par saves/.images/<jeu>, écrit à chaque
#    lancement. Seuls les fichiers de même taille sont comparés (cmp).
#    Gardés : ceux d'un dossier opaque (voir under_opaque) et ceux qui
#    portent des attributs Wine (DOS, sécurité) absents de l'image.
# 2. Prefix Proton : DXVK, vkd3d-proton et nvapi, recopiés par Proton à
#    CHAQUE lancement (setup_prefix) — ~65 Mo par jeu. Pas le FSR4 de
#    proton-cachyos (amdxcffx64.dll), téléchargé par protonfixes.
# Manuel et jamais au démontage : le jeu recopierait ces fichiers à chaque
# partie.
clean_saves() {
    local name="$1" saves="${SAVES_DIR}/${1}" img="" mnt f rel lower n=0 bytes=0 size lib b c
    if saves_busy "$name"; then
        echo "  ${name} : monté ou en cours, ignoré"
        return 0
    fi
    [[ -f "${SAVES_DIR}/.images/${name}" ]] && img=$(< "${SAVES_DIR}/.images/${name}")
    if [[ -z "$img" || ! -f "$img" ]]; then
        echo "  ${name} : image inconnue (lancer le jeu une fois), fichiers du jeu gardés"
    elif ! command -v getfattr &>/dev/null; then
        # Sans getfattr, les dossiers opaques ne seraient pas tous reconnus.
        echo "  ${name} : getfattr absent (paquet attr), fichiers du jeu gardés"
    else
        mkdir -p "$CACHE_DIR"
        mnt=$(mktemp -d "${CACHE_DIR}/purge.XXXXXX") || return 0
        if squashfuse "$img" "$mnt" 2>/dev/null; then
            OPAQUE_CACHE=()
            while IFS= read -r -d '' f; do
                rel="${f#"$saves"/}"
                [[ "${rel##*/}" == .wh.* ]] && continue
                lower="${mnt}/${rel}"
                [[ -f "$lower" && ! -L "$lower" ]] || continue
                size=$(stat -c %s "$f")
                [[ "$size" == "$(stat -c %s "$lower")" ]] || continue
                under_opaque "$saves" "$rel" && continue
                getfattr -d -m '^user\.(wine|DOSATTRIB)' "$f" 2>/dev/null | grep -q . && continue
                cmp -s "$f" "$lower" || continue
                rm -f -- "$f" && { n=$((n + 1)); bytes=$((bytes + size)); }
            done < <(find "$saves" -xdev -type f -print0 2>/dev/null)
            umount_retry "$mnt"
        else
            echo "  ${name} : montage de l'image impossible, fichiers du jeu gardés"
        fi
        rmdir "$mnt" 2>/dev/null || true
    fi
    # 3e ligne de config_info : lib/ du Proton qui a configuré le prefix.
    lib=$(sed -n 3p "${saves}/config_info" 2>/dev/null)
    if [[ -n "$lib" && -d "${lib}wine" ]]; then
        while IFS= read -r -d '' f; do
            b=$(basename "$f")
            for c in "${lib}wine"/{dxvk,vkd3d-proton,nvapi}/{x86_64,i386}-windows/"$b"; do
                if ! { [[ -f "$c" ]] && cmp -s "$f" "$c"; }; then
                    continue
                fi
                size=$(stat -c %s "$f")
                rm -f -- "$f" && { n=$((n + 1)); bytes=$((bytes + size)); }
                break
            done
        done < <(find "${saves}/drive_c/windows/system32" "${saves}/drive_c/windows/syswow64" \
                     -maxdepth 1 -type f -print0 2>/dev/null)
    fi
    [[ "$n" -gt 0 ]] && echo "  ${name} : ${n} doublon(s) retiré(s), $((bytes / 1048576)) Mo libérés"
    return 0
}

# --clear (01/10) : ne garde que drive_c/users de chaque jeu (sauvegardes
# des jeux PC récents : Documents, AppData, Saved Games). Tout le reste est
# supprimé : prefix créé dans les saves (recréé au lancement suivant —
# par Proton pour un jeu seul, même s'il tournait sous Wine), registre, et
# ce que le jeu a écrit dans son dossier : scores et réglages des jeux
# arcade/TeknoParrot, sauvegardes à côté de l'exe. Dossiers opaques et
# fichiers supprimés (whiteouts) disparaissent aussi : l'image redevient
# visible telle quelle, sauf sous users.
clear_saves() {
    local name="$1" saves="${SAVES_DIR}/${1}"
    if saves_busy "$name"; then
        echo "  ${name} : monté ou en cours, ignoré"
        return 0
    fi
    find "$saves" -mindepth 1 -maxdepth 1 ! -name drive_c -exec rm -rf -- {} + 2>/dev/null
    if [[ -d "${saves}/drive_c" ]]; then
        # drive_c recréé : opaque (prefix créé dans les saves), il masquerait
        # le drive_c de l'image. users déplacé, même système de fichiers.
        if [[ -d "${saves}/drive_c/users" ]]; then
            rm -rf -- "${saves}/.users"
            mv -- "${saves}/drive_c/users" "${saves}/.users" || return 0
        fi
        rm -rf -- "${saves}/drive_c"
        if [[ -d "${saves}/.users" ]]; then
            mkdir -p "${saves}/drive_c" && mv -- "${saves}/.users" "${saves}/drive_c/users"
        fi
    fi
    rmdir "$saves" 2>/dev/null
    if [[ -d "$saves" ]]; then
        echo "  ${name} : gardé $(du -sh "$saves" 2>/dev/null | cut -f1) (drive_c/users)"
    else
        echo "  ${name} : rien à garder, supprimé"
    fi
}

# Cache de travail (mnt, wine, work) des jeux qui ne tournent pas.
# unmount_all_stale garde les jeux en cours (27/09) : leurs dossiers sont
# épargnés, sinon rm -rf effaçait leurs sauvegardes à travers l'overlay.
clean_cache() {
    local d g
    local -A kept=()
    # Démonter avant de supprimer : rm -rf sur un point de montage FUSE
    # actif supprime les fichiers du jeu À TRAVERS le montage.
    unmount_all_stale
    # CACHE_DIR/work : emplacement du workdir jusqu'au 13/10.
    for d in "${CACHE_DIR}/mnt"/* "${CACHE_DIR}/wine"/* "${SAVES_DIR}/.work"/* "${CACHE_DIR}/work"/*; do
        [[ -e "$d" ]] || continue
        g=$(basename "$d")
        if saves_busy "$g" || mountpoint -q "${CACHE_DIR}/mnt/${g}" 2>/dev/null; then
            [[ -n "${kept[$g]:-}" ]] || echo "  ${g} : en cours, gardé"
            kept[$g]=1
            continue
        fi
        rm -rf -- "$d" 2>/dev/null || true
    done
    echo "✓ Copies de travail supprimées"
}

# Jeux qui ont une couche de sauvegardes.
saved_games() {
    local g
    for g in "${SAVES_DIR}"/*/; do
        [[ -d "$g" ]] && basename "$g"
    done
}

cmd_clean() {
    local games=() g
    echo "Nettoyage des copies de travail et des doublons des sauvegardes..."
    clean_cache
    mapfile -t games < <(saved_games)
    for g in "${games[@]}"; do
        clean_saves "$g"
    done
    echo "✓ Sauvegardes gardées dans : ${SAVES_DIR}"
}

# cmd_clear [jeu]
cmd_clear() {
    local targets=() g
    if [[ -n "${1:-}" ]]; then
        targets=("$(basename "$1" .wsquashfs)")
        if [[ ! -d "${SAVES_DIR}/${targets[0]}" ]]; then
            echo "Aucune sauvegarde pour ${targets[0]}"
            return 0
        fi
    else
        mapfile -t targets < <(saved_games)
    fi
    echo "--clear ne garde que drive_c/users de ${#targets[@]} jeu(x) : scores et réglages"
    echo "  enregistrés ailleurs (jeux arcade, dossier du jeu, registre) seront perdus."
    echo "  Chaque jeu est d'abord archivé dans $(backup_dir) (voir --backup)."
    if [[ -t 0 ]] && ! confirm "Continuer ?"; then
        echo "Abandon."
        return 1
    fi
    clean_cache
    for g in "${targets[@]}"; do
        if saves_busy "$g"; then
            echo "  ${g} : monté ou en cours, ignoré"
            continue
        fi
        # Jamais de suppression sans archive (13/10) : --clear est irréversible.
        backup_saves "$g" || continue
        clear_saves "$g"
    done
    return 0
}

# ── --backup ───────────────────────────────────────────────────────────

backup_dir() {
    echo "${WSQUASHFS_BACKUP_DIR:-$HOME/.local/share/wsquashfs/backups}"
}

# backup_saves <jeu> : archive SAVES_DIR/<jeu> dans backup_dir
# (<jeu>-AAAAMMJJ-HHMMSS.tar.zst, ou .tar.gz sans zstd). Les attributs
# étendus sont gardés : fuse-overlayfs y marque les dossiers opaques, Wine
# les attributs DOS. Faux si l'archive n'a pas pu être faite.
backup_saves() {
    local name="$1" dir archive comp=(--gzip) ext=tar.gz
    [[ -d "${SAVES_DIR}/${name}" ]] || return 0
    dir=$(backup_dir)
    if command -v zstd &>/dev/null; then
        comp=(--zstd) ext=tar.zst
    fi
    archive="${dir}/${name}-$(date +%Y%m%d-%H%M%S)"
    # Deux archives dans la même seconde (--clear juste après --backup) :
    # suffixe, jamais d'écrasement.
    local base="$archive" n=1
    while [[ -e "${archive}.${ext}" ]]; do
        archive="${base}-$((++n))"
    done
    archive+=".${ext}"
    if mkdir -p "$dir" 2>/dev/null \
       && tar -C "$SAVES_DIR" --xattrs --xattrs-include='user.*' "${comp[@]}" \
              -cf "${archive}.part" -- "$name" 2>/dev/null \
       && mv -f "${archive}.part" "$archive"; then
        chown_to_target "$dir"
        echo "  ${name} : archivé dans ${archive} ($(du -h "$archive" | cut -f1))"
        return 0
    fi
    rm -f "${archive}.part"
    warn "${name} : échec de l'archive (${archive}), sauvegardes laissées intactes"
    return 1
}

# cmd_backup [jeu] : un jeu, ou tous ceux qui ont des sauvegardes.
cmd_backup() {
    local targets=() g failed=0
    if [[ -n "${1:-}" ]]; then
        targets=("$(basename "$1" .wsquashfs)")
        [[ -d "${SAVES_DIR}/${targets[0]}" ]] || die "aucune sauvegarde pour ${targets[0]}"
    else
        mapfile -t targets < <(saved_games)
    fi
    if ((${#targets[@]} == 0)); then
        echo "Aucune sauvegarde à archiver (${SAVES_DIR})"
        return 0
    fi
    echo "Archivage des sauvegardes dans $(backup_dir)..."
    for g in "${targets[@]}"; do
        # Jeu en cours : ses sauvegardes changent sous tar, archive incohérente.
        if saves_busy "$g"; then
            echo "  ${g} : monté ou en cours, ignoré"
            continue
        fi
        backup_saves "$g" || failed=1
    done
    echo "Restauration (jeu arrêté) :"
    echo "  tar -C \"${SAVES_DIR}\" --xattrs --xattrs-include='user.*' -xpf <archive>"
    return "$failed"
}

# ── --list ─────────────────────────────────────────────────────────────

# Jeux connus : sauvegardes, copie de travail, ou image enregistrée au
# lancement (SAVES_DIR/.images).
known_games() {
    local d
    {
        for d in "${SAVES_DIR}"/*/ "${CACHE_DIR}/wine"/*/; do
            [[ -d "$d" ]] && basename "$d"
        done
        for d in "${SAVES_DIR}/.images"/*; do
            [[ -f "$d" ]] && basename "$d"
        done
    } | sort -u
}

game_state() {
    if game_in_use "$1"; then
        echo "en cours"
    elif game_locked "$1"; then
        echo "verrouillé"
    elif mountpoint -q "${CACHE_DIR}/wine/${1}" 2>/dev/null; then
        echo "monté"
    else
        echo "-"
    fi
}

# --list (13/10) : jeux connus, état, version et taille des sauvegardes.
cmd_list() {
    local games=() g width=4 img image version size
    mapfile -t games < <(known_games)
    if ((${#games[@]} == 0)); then
        echo "Aucun jeu connu (aucun lancement enregistré dans ${SAVES_DIR})"
        return 0
    fi
    for g in "${games[@]}"; do
        (($(text_width "$g") > width)) && width=$(text_width "$g")
    done
    width=$((width + 2))
    echo "$(pad "Jeu" "$width")$(pad "État" 12)$(pad "Version" 12)$(pad "Sauvegardes" 13)Image"
    for g in "${games[@]}"; do
        img="" version="-" size="aucune"
        [[ -f "${SAVES_DIR}/.images/${g}" ]] && img=$(< "${SAVES_DIR}/.images/${g}")
        if [[ -z "$img" ]]; then
            image="inconnue"
        elif [[ -e "$img" ]]; then
            image="$img"
            version=$(game_version "$img")
            [[ -n "$version" ]] || version="-"
        else
            image="introuvable : ${img}"
        fi
        [[ -d "${SAVES_DIR}/${g}" ]] && size=$(du -sh "${SAVES_DIR}/${g}" 2>/dev/null | cut -f1)
        echo "$(pad "$g" "$width")$(pad "$(game_state "$g")" 12)$(pad "$version" 12)$(pad "$size" 13)${image}"
    done
    echo ""
    echo "Sauvegardes : ${SAVES_DIR} ($(du -sh "$SAVES_DIR" 2>/dev/null | cut -f1) au total)"
}

# ── --doctor ───────────────────────────────────────────────────────────

doctor_ok()   { echo "  ✓ $*"; }
doctor_fail() { echo "  ✗ $*"; }
doctor_note() { echo "  – $*"; }

# doctor_tool <commande> <rôle> <ok|fail|note si absente>
doctor_tool() {
    local path
    if path=$(command -v "$1"); then
        doctor_ok "$1 (${path}) : $2"
    else
        "doctor_$3" "$1 absent : $2"
    fi
}

# --doctor (13/10) : ce qui est installé, ce qui manque et ce que cela
# change. Code 1 si aucun jeu ne peut être lancé.
cmd_doctor() {
    local fatal=0 bin alt runners dir umu reason
    echo "Montage des images"
    if [[ -c /dev/fuse && -r /dev/fuse && -w /dev/fuse ]]; then
        doctor_ok "/dev/fuse accessible"
    else
        doctor_fail "/dev/fuse inaccessible : mode copy seulement (conteneur : --device /dev/fuse)"
    fi
    doctor_tool squashfuse "montage de l'image" fail
    if reason=$(kernel_overlay_unavailable); then
        doctor_note "overlay noyau indisponible : ${reason} (fuse-overlayfs à la place)"
    elif reason=$(kernel_overlay_probe); then
        doctor_ok "overlay noyau (namespace utilisateur) : une couche FUSE au lieu de deux"
    else
        doctor_note "overlay noyau indisponible : ${reason} (fuse-overlayfs à la place)"
    fi
    doctor_tool fuse-overlayfs "mode overlay, sauvegardes séparées (sinon mode copy)" fail
    doctor_tool unsquashfs "mode copy, --info, --install" fail
    doctor_tool mksquashfs "--pack" note
    doctor_tool getfattr "--clean (doublons des sauvegardes)" note
    doctor_tool flock "verrou par jeu (double lancement)" note
    doctor_tool zstd "archives --backup compactes (sinon gzip)" note
    if ! command -v squashfuse &>/dev/null && ! command -v unsquashfs &>/dev/null; then
        fatal=1
    fi

    echo "Wine / Proton"
    bin=$(find_wine_binary)
    if [[ -n "$bin" ]]; then
        doctor_ok "Wine par défaut : $(runner_name "$bin") $(runner_version "$bin") (${bin})"
        if wine_supports_win32 "$bin"; then
            doctor_ok "prefixes 32 bits (win32) pris en charge"
        elif alt=$(find_win32_wine); then
            doctor_ok "prefixes 32 bits : $(runner_name "$alt") (Wine par défaut WoW64 seul)"
        else
            doctor_fail "prefixes 32 bits impossibles : Wine WoW64 seul, aucun Wine classique installé"
        fi
    else
        doctor_fail "aucun Wine : seuls les jeux lancés par Proton (umu) fonctionnent"
    fi
    runners=$(list_wine_runners)
    if [[ -n "$runners" ]]; then
        doctor_ok "runners installés (--wine) :"
        while IFS= read -r dir; do
            echo "      $(basename "$dir")  ${dir}"
        done <<< "$runners"
    else
        doctor_note "aucun runner installé dans /opt, /usr/wine, ~/.local/share/wsquashfs/wine ni Steam/Heroic"
    fi
    if umu=$(find_umu_run); then
        doctor_ok "umu-run (${umu}) : prefixes Proton et jeux seuls lancés par Proton"
    else
        doctor_note "umu-run absent : prefixes Proton lancés directement par Wine (dégradé)"
    fi
    if [[ -z "$bin" ]] && ! { [[ -n "$umu" ]] && [[ -n "$(find_proton_runner "")" ]]; }; then
        fatal=1
    fi

    echo "Rendu"
    dir=$(find_dxvk_dir)
    if [[ -n "$dir" ]]; then doctor_ok "DXVK (${dir})"; else doctor_fail "DXVK absent : Direct3D 8-11 en OpenGL (llvmpipe possible)"; fi
    dir=$(find_vkd3d_dir)
    if [[ -n "$dir" ]]; then doctor_ok "VKD3D-Proton (${dir})"; else doctor_fail "VKD3D-Proton absent : Direct3D 12 indisponible"; fi
    dir=$(find_d7vk)
    if [[ -n "$dir" ]]; then doctor_ok "d7vk (${dir})"; else doctor_note "d7vk absent : DirectDraw en OpenGL"; fi

    echo "Manettes"
    if hidraw_usable; then
        doctor_ok "manette Sony lisible par hidraw (HIDRAW=1 possible)"
    else
        doctor_note "hidraw : ${HIDRAW_REASON} (HIDRAW=1 retombe en XInput)"
    fi
    bin=$(find_dualsense_bridge)
    if [[ -n "$bin" ]]; then
        doctor_ok "dualsense-usb-bridge (${bin})"
    else
        doctor_note "dualsense-usb-bridge absent : DualSense Bluetooth en direct avec HIDRAW=1"
    fi

    echo "Dossiers"
    for dir in "$SAVES_DIR" "$CACHE_DIR" "$(backup_dir)"; do
        if [[ ! -e "$dir" ]]; then
            doctor_note "${dir} : pas encore créé"
        elif [[ -w "$dir" ]]; then
            doctor_ok "${dir} ($(du -sh "$dir" 2>/dev/null | cut -f1))"
        else
            doctor_fail "${dir} : pas d'accès en écriture"
        fi
    done

    echo ""
    if ((fatal)); then
        echo "✗ Aucun jeu ne peut être lancé : voir les points ✗ ci-dessus"
        return 1
    fi
    echo "✓ Prêt à lancer des jeux"
}

# cmd_umount [jeu] : un jeu, ou tous les jeux montés.
cmd_umount() {
    local g
    if [[ -n "${1:-}" ]]; then
        umount_game "$(basename "$1" .wsquashfs)"
    else
        for g in "${CACHE_DIR}/wine"/*/; do
            [[ -d "$g" ]] && umount_game "$(basename "$g")"
        done
        unmount_all_stale
    fi
    return 0
}

# ── --pack / --install / --info ────────────────────────────────────────

# --pack <Jeu.wine> [sortie] : prefix Wine (dossier) → .wsquashfs, comme
# wine2squashfs de batocera-wine (mksquashfs, compression zstd).
pack_prefix() {
    local src="${1%/}" out="${2:-}" saves tmp version reset_saves=false
    [[ -n "$src" && -d "$src" ]] || usage_error "$0 --pack <dossier.wine> [sortie.wsquashfs]"
    command -v mksquashfs &>/dev/null || die "mksquashfs absent (squashfs-tools)"
    [[ -n "$out" ]] || out="${src%.wine}.wsquashfs"
    saves="${SAVES_DIR}/$(basename "$out" .wsquashfs)"
    # Fichier existant : question au terminal (26/09), refus sans terminal
    # (script, frontend).
    if [[ -e "$out" ]]; then
        [[ -t 0 ]] || die "${out} existe déjà (jamais écrasé sans confirmation au terminal)"
        if ! confirm "${out} existe déjà ($(du -h "$out" | cut -f1), $(date -r "$out" '+%d/%m %H:%M')). L'écraser ?"; then
            echo "Abandon."
            return 1
        fi
        # Sauvegardes de l'ancienne image : appliquées par-dessus le nouveau
        # prefix (overlay), elles peuvent en masquer une partie.
        if [[ -d "$saves" ]] && confirm "Réinitialiser aussi ses sauvegardes (${saves}) ?"; then
            reset_saves=true
        fi
    fi
    [[ -f "${src}/autorun.cmd" ]] || warn "pas d'autorun.cmd dans ${src} (lançable seulement via --exec)"
    # Construit à côté puis remplace : l'ancienne image reste intacte si
    # mksquashfs échoue ou est interrompu.
    tmp="${out}.part"
    rm -f "$tmp"
    echo "Création de ${out} depuis ${src}..."
    if ! mksquashfs "$src" "$tmp" -comp zstd -noappend -quiet; then
        rm -f "$tmp"
        die "échec de mksquashfs, ${out} inchangé"
    fi
    mv -f "$tmp" "$out"
    if [[ "$reset_saves" == true ]]; then
        rm -rf -- "${saves:?}" && echo "Sauvegardes réinitialisées : ${saves}"
    fi
    echo "✓ ${out} ($(du -h "$out" | cut -f1))"
    version=$(game_version "$src")
    if [[ -n "$version" ]]; then
        echo "  Version : ${version}"
    elif [[ -f "${src}/autorun.cmd" ]]; then
        echo "  Version non renseignée (GAME_VERSION=... dans l'autorun.cmd, voir --info)"
    fi
}

# --info <jeu.wsquashfs | dossier> (29/09) : version et type du jeu, lus
# dans l'image sans la monter.
show_info() {
    local src="$1" autorun type="" version proton cmd
    [[ -n "$src" && -e "$src" ]] || usage_error "$0 --info <jeu.wsquashfs | dossier du jeu>"
    src=$(realpath "$src")
    if [[ -d "$src" ]]; then
        autorun=$(cat "${src}/autorun.cmd" 2>/dev/null)
        [[ -f "${src}/system.reg" ]] && type=prefix
        proton=$(head -1 "${src}/config_info" 2>/dev/null)
    else
        command -v unsquashfs &>/dev/null || die "unsquashfs absent (squashfs-tools)"
        autorun=$(unsquashfs -cat "$src" autorun.cmd 2>/dev/null)
        unsquashfs -cat "$src" system.reg >/dev/null 2>&1 && type=prefix
        proton=$(unsquashfs -cat "$src" config_info 2>/dev/null | head -1)
    fi
    proton="${proton%$'\r'}"
    version=$(game_version "$src")
    if [[ -n "$proton" ]]; then
        type="prefix Proton (${proton})"
    elif [[ "$type" == prefix ]]; then
        type="prefix Wine (Batocera)"
    else
        type="jeu seul (prefix créé au premier lancement)"
    fi
    echo "Jeu           : $(basename "$src" .wsquashfs)"
    [[ -n "$version" ]] || version="non renseignée (GAME_VERSION= dans l'autorun.cmd)"
    echo "Version       : ${version}"
    echo "Type          : ${type}"
    if cmd=$(override_var "${src%/}.autorun" CMD); then
        echo "Commande      : ${cmd}"
    elif [[ -n "$autorun" ]]; then
        echo "Commande      : $(grep -m1 '^CMD=' <<< "$autorun" | sed 's/^CMD=//' | tr -d '\r')"
    else
        echo "Commande      : aucun autorun.cmd"
    fi
    if [[ -f "${src%/}.autorun" ]]; then
        echo "Surcharge     : $(basename "${src%/}.autorun") ($(override_keys "${src%/}.autorun")) — non lue par Batocera"
    fi
    echo "Taille        : $(du -sh "$src" | cut -f1)"
}

# --install <jeu.wsquashfs> [dossier] (29/09) : l'inverse de --pack —
# extrait l'image dans <dossier>/<Jeu> (défaut : à côté de l'image), pour
# jouer sans FUSE ; le dossier se lance ensuite directement
# (wsquashfs-launcher <dossier>/<Jeu>). Part de l'image d'origine : la couche
# de sauvegardes du .wsquashfs n'est pas reprise, l'image est conservée.
install_game() {
    local img="$1" parent="${2:-}" name dest tmp version
    if [[ -z "$img" || ! -f "$img" || "${img##*.}" != "wsquashfs" ]]; then
        usage_error "$0 --install <jeu.wsquashfs> [dossier de destination]"
    fi
    command -v unsquashfs &>/dev/null || die "unsquashfs absent (squashfs-tools)"
    name=$(basename "$img" .wsquashfs)
    [[ -n "$parent" ]] || parent=$(dirname "$(realpath "$img")")
    mkdir -p "$parent" || die "impossible de créer ${parent}"
    dest="${parent%/}/${name}"
    [[ ! -e "$dest" ]] || die "${dest} existe déjà (jamais écrasé)"
    # Extrait à côté puis renomme : pas de dossier à moitié rempli si
    # unsquashfs échoue (place insuffisante...) ou est interrompu.
    tmp="${dest}.part"
    rm -rf -- "$tmp"
    echo "Installation de ${name} dans ${dest}..."
    if ! unsquashfs -no-xattrs -d "$tmp" "$img"; then
        rm -rf -- "$tmp"
        die "échec de l'extraction, rien n'a été installé"
    fi
    mv -- "$tmp" "$dest"
    # Lancé en root : le dossier doit appartenir à l'utilisateur qui lancera
    # Wine, sinon Wine refuse le prefix.
    if drops_to_target_user; then
        chown -R "${WINE_UID}:${WINE_GID}" "$dest"
    fi
    echo "✓ ${dest} ($(du -sh "$dest" | cut -f1))"
    version=$(game_version "$dest")
    [[ -n "$version" ]] && echo "  Version : ${version}"
    echo "  Lancement : $0 \"${dest}\""
}

# ════════════════════════════════════════════════════════════════════════
# 9. LANCEMENT D'UN JEU
# ════════════════════════════════════════════════════════════════════════

# ── 9.1 Vérifications ──────────────────────────────────────────────────

# Résout GAME_ARG en WSQUASHFS_FILE (image ou dossier installé).
resolve_game_path() {
    [[ -n "$GAME_ARG" ]] || die "fichier .wsquashfs ou dossier de jeu requis" \
        "Usage : $0 <fichier.wsquashfs | dossier du jeu>  |  $0 --help"
    WSQUASHFS_FILE=$(realpath "$GAME_ARG" 2>/dev/null) || die "chemin introuvable : $GAME_ARG"

    if [[ -d "$WSQUASHFS_FILE" ]]; then
        # Jeu installé (--install) : dossier lancé sur place, sans montage.
        if [[ ! -f "${WSQUASHFS_FILE}/autorun.cmd" && "$ACTION" != "exec" ]]; then
            die "pas d'autorun.cmd dans ${WSQUASHFS_FILE}"
        fi
        [[ "$ACTION" != "mount" ]] || die "--mount sert aux .wsquashfs ; un dossier installé se modifie directement"
        DIR_MODE=1
    elif [[ "${WSQUASHFS_FILE##*.}" != "wsquashfs" ]]; then
        die "extension .wsquashfs attendue (ou dossier de jeu installé)"
    elif [[ ! -f "$WSQUASHFS_FILE" ]]; then
        die "fichier introuvable : $WSQUASHFS_FILE"
    fi
}

check_dependencies() {
    # Sans Wine, un Proton lancé par umu suffit (jeu seul ou prefix Proton) :
    # cas d'un système sans wine, les runners étant dans compatibilitytools.d.
    if ! command -v wine &>/dev/null && [[ -z "$(find_wine_binary)" ]] \
       && ! { find_umu_run >/dev/null && [[ -n "$(find_proton_runner "")" ]]; }; then
        die "aucun binaire Wine ni Proton (avec umu-run) trouvé"
    fi
    if [[ "$DIR_MODE" == "0" ]] && ! command -v squashfuse &>/dev/null && ! command -v unsquashfs &>/dev/null; then
        die "ni squashfuse ni unsquashfs ne sont disponibles" \
            "  → apt-get install squashfuse squashfs-tools"
    fi
}

# ── 9.2 En-tête ────────────────────────────────────────────────────────

init_game_paths() {
    GAME_NAME=$(basename "$WSQUASHFS_FILE" .wsquashfs)
    AUTORUN_OVERRIDE="${WSQUASHFS_FILE%/}.autorun"
    [[ -f "$AUTORUN_OVERRIDE" ]] || AUTORUN_OVERRIDE=""
    SQUASHFSPOINT="${CACHE_DIR}/mnt/${GAME_NAME}"
    WINEPOINT="${CACHE_DIR}/wine/${GAME_NAME}"
    SAVEPOINT="${SAVES_DIR}/${GAME_NAME}"
    # workdir sur le même système de fichiers que l'upperdir (13/10) :
    # fuse-overlayfs y crée chaque fichier puis le renomme dans les
    # sauvegardes, et un renommage entre deux montages échoue (EXDEV). Dans
    # CACHE_DIR, Wine ne pouvait rien écrire dès que les sauvegardes étaient
    # sur un autre disque, un NAS ou un volume Docker séparé ("cannot create
    # .../dosdevices : Invalid cross-device link").
    WORKPOINT="${SAVES_DIR}/.work/${GAME_NAME}"
}

print_header() {
    local version
    echo "========================================="
    echo "WSquashFS Launcher"
    echo "========================================="
    echo "Environnement : $(detect_env)"
    echo "Jeu           : $GAME_NAME"
    version=$(game_version "$WSQUASHFS_FILE")
    [[ -n "$version" ]] && echo "Version       : $version"
    echo "Fichier       : $WSQUASHFS_FILE"
    if [[ -n "$AUTORUN_OVERRIDE" ]]; then
        echo "Surcharge     : $(basename "$AUTORUN_OVERRIDE") ($(override_keys "$AUTORUN_OVERRIDE"))"
    fi
    [[ "$ACTION" != "run" ]] && echo "Action        : ${ACTION}${EXEC_CMD[0]:+ (${EXEC_CMD[0]})}"
    return 0
}

# ── 9.3 Montage ────────────────────────────────────────────────────────

# Jeu installé : le dossier est lui-même le prefix, rien à monter.
use_installed_dir() {
    WINEPOINT="$WSQUASHFS_FILE"
    SQUASHFSPOINT="" SAVEPOINT="" WORKPOINT=""
    prefix_in_use "$(regex_escape "$WINEPOINT")" && die "${GAME_NAME} est déjà lancé"
    unmount_all_stale
    [[ -f "${WINEPOINT}/system.reg" ]] && PACKAGED_PREFIX=1
    [[ -f "${WINEPOINT}/config_info" ]] && PROTON_PREFIX=1
    rm -f "${WINEPOINT}/.wineserver-lock" "${WINEPOINT}"/reg*.tmp 2>/dev/null || true
    MOUNT_MODE="dir"
    echo "Mode          : dossier (jeu installé, sans FUSE)"
}

# Dossiers de montage vides et au bon propriétaire.
prepare_mount_dirs() {
    mkdir -p "$SQUASHFSPOINT" "$SAVEPOINT" "$WINEPOINT" "${SAVES_DIR}/.images"
    # Image d'origine des sauvegardes, pour --clean (fichiers identiques).
    printf '%s\n' "$WSQUASHFS_FILE" > "${SAVES_DIR}/.images/${GAME_NAME}" 2>/dev/null || true
    chown_to_target "${SAVES_DIR}/.images"
    # WORKPOINT doit être vide avant chaque montage overlay (état obsolète).
    reset_workdir "$WORKPOINT"
    chown_to_target "$SQUASHFSPOINT"
    chown_to_target "$SAVEPOINT"
    chown_to_target "$WINEPOINT"
    chown_to_target "$WORKPOINT"
    # Verrous et temporaires wineserver obsolètes : les reg*.tmp orphelins
    # (wineserver interrompu) corrompent fuse-overlayfs et causent ESTALE.
    rm -f "${SAVEPOINT}/wineserver" "${SAVEPOINT}/.wineserver-lock" 2>/dev/null || true
    rm -f "${SAVEPOINT}"/reg*.tmp 2>/dev/null || true
}

# Image = prefix packagé (Batocera : system.reg, drive_c… dans le squashfs)
# ou jeu seul (NBA 2K23, Pinball FX : prefix créé dans les saves au premier
# lancement) ? Lu directement dans l'image (< 0,1 s, même sur 38 Go).
# Prefix créé par Proton (config_info) : ses DLL sont gérées par Proton.
detect_image_prefix() {
    unsquashfs -cat "$WSQUASHFS_FILE" system.reg >/dev/null 2>&1 && PACKAGED_PREFIX=1
    unsquashfs -cat "$WSQUASHFS_FILE" config_info >/dev/null 2>&1 && PROTON_PREFIX=1
    return 0
}

# Prefix packagé : system32/syswow64 de l'upperdir ne contiennent que des
# liens/copies régénérés à chaque lancement (sync_wine_stubs, DXVK…) et
# d'anciennes entrées redirect/opaque — effacés. JAMAIS pour un jeu seul
# (26/09) : son system32 EST le prefix (explorer.exe, services.exe…) ; effacé,
# Wine échouait au lancement suivant ("failed to start explorer c0000034").
# Prefix Proton (27/09) : Proton y met à jour ses propres DLL (copies) quand
# sa version change — effacées, le prefix garderait la nouvelle version
# annoncée avec les DLL de l'ancienne. Seuls les liens posés par ce lanceur
# (lancement sans umu) sont retirés.
clear_generated_system_dlls() {
    local dirs=("${SAVEPOINT}/drive_c/windows/system32" "${SAVEPOINT}/drive_c/windows/syswow64")
    [[ "$PACKAGED_PREFIX" == "1" ]] || return 0
    if [[ "$PROTON_PREFIX" == "1" ]]; then
        find "${dirs[@]}" -maxdepth 1 -type l -delete 2>/dev/null || true
    else
        rm -rf "${dirs[@]}" 2>/dev/null || true
    fi
}

# Mode overlay : squashfuse + fuse-overlayfs. Faux si l'un manque ou échoue.
try_overlay_mount() {
    command -v squashfuse &>/dev/null || return 1
    mount_squashfs "$WSQUASHFS_FILE" "$SQUASHFSPOINT" || return 1
    if command -v fuse-overlayfs &>/dev/null && mount_overlay; then
        MOUNT_MODE="overlay"
        OVERLAY_KIND="fuse"
        MOUNTED=true
        echo "Mode          : overlay (squashfuse + fuse-overlayfs)"
        return 0
    fi
    do_umount "$SQUASHFSPOINT"
    return 1
}

# Mode copy : copie de travail en cache, réextraite si l'image a changé.
use_copy_mode() {
    local cache_info_file="${WINEPOINT}/.wsquashfs_cache"
    if [[ -d "$WINEPOINT" && -f "$cache_info_file" ]] && \
       [[ "$(cat "$cache_info_file" 2>/dev/null)" == "$(image_signature)" ]]; then
        echo "Mode          : copy (cache valide, extraction ignorée)"
    else
        extract_image
    fi
    MOUNT_MODE="copy"
    MOUNTED=true
}

mount_image() {
    # Ce jeu tourne déjà : ne pas le relancer par-dessus (même montage, même
    # prefix — la partie en cours serait coupée).
    game_in_use "$GAME_NAME" && die "${GAME_NAME} est déjà lancé"
    unmount_all_stale
    prepare_mount_dirs
    detect_image_prefix
    clear_generated_system_dlls
    run_in_kernel_overlay
    try_overlay_mount || use_copy_mode
}

# --mount : le jeu reste monté (cleanup ne démonte pas), pour le modifier à
# la main — fichiers de config, sauvegardes, remplacement d'un fichier.
report_mount_and_exit() {
    MOUNTED=false
    echo "-----------------------------------------"
    echo "Monté dans    : $WINEPOINT"
    [[ "$MOUNT_MODE" == "overlay" ]] && echo "Modifications : enregistrées dans $SAVEPOINT (le .wsquashfs n'est jamais modifié)"
    echo "Démontage     : $0 --umount \"$WSQUASHFS_FILE\""
    echo "  (tout lancement d'un autre jeu démonte aussi les montages inutilisés)"
    exit 0
}

# ── 9.4 autorun.cmd ────────────────────────────────────────────────────

read_autorun() {
    if [[ ! -f "${WINEPOINT}/autorun.cmd" && "$ACTION" != "exec" ]]; then
        die "autorun.cmd introuvable dans le wsquashfs"
    fi

    DIR=$(unquote "$(autorun_var DIR "")")
    CMD=$(autorun_var CMD "")
    WINE_VERSION=$(autorun_var WINE "")
    PROTON_VERSION=$(autorun_var PROTON "")
    RUNNER=$(autorun_var RUNNER "")
    WINE_ARCH=$(autorun_var ARCH "")

    # DXVK activé par défaut (contrairement à Batocera) : sous Xwayland +
    # NVIDIA, l'OpenGL de wined3d tombe sur llvmpipe (rendu logiciel) alors
    # que Vulkan voit bien le GPU. DXVK=0 dans autorun.cmd (par jeu) ou
    # WSQUASHFS_DXVK=0 (global) pour revenir aux DLL intégrées de Wine.
    DXVK=$(autorun_var DXVK "${WSQUASHFS_DXVK:-1}")
    # Choix demandé, avant le repli faute de DXVK local : sous Proton, qui a
    # son propre DXVK, seul un DXVK=0 voulu passe en wined3d.
    DXVK_WANTED="$DXVK"
    if [[ "$DXVK" == "1" && -z "$(find_dxvk_dir)" ]]; then
        warn "DXVK introuvable (/usr/share/dxvk), rendu via wined3d"
        DXVK=0
    fi

    # VKD3D activé par défaut : le d3d12.dll de Wine dépend de stubs noyau
    # (win32k.sys/dxgkrnl.sys, "SharedGpuResources") qui échouent ici —
    # tout jeu D3D12 terminait en page fault. vkd3d-proton traduit
    # directement vers Vulkan. Sans effet sur un jeu qui ne charge pas
    # d3d12.dll ; VKD3D=0 dans l'autorun.cmd garde la priorité.
    VKD3D=$(autorun_var VKD3D "1")
    if [[ "$VKD3D" == "1" && -z "$(find_vkd3d_dir)" ]]; then
        warn "VKD3D-Proton introuvable (/usr/share/vkd3d-proton), Direct3D 12 indisponible"
        VKD3D=0
    fi

    # d7vk activé par défaut, pour la même raison que DXVK (OpenGL = llvmpipe
    # ici) ; sans effet sur un jeu qui ne charge pas ddraw.dll. D7VK=0 dans
    # l'autorun.cmd ou WSQUASHFS_D7VK=0 pour l'écarter.
    D7VK=$(autorun_var D7VK "${WSQUASHFS_D7VK:-1}")
    [[ "$D7VK" == "1" && -z "$(find_d7vk)" ]] && D7VK=0

    SAVEDIR=$(unquote "$(autorun_var SAVEDIR "")")
    SAVEFILES=$(unquote "$(autorun_var SAVEFILES "")")
    ESYNC=$(autorun_var ESYNC "0")
    FSYNC=$(autorun_var FSYNC "0")
    WINE_LANG=$(autorun_var LANG "")
    WINE_ENV=$(autorun_var ENV "")
    # Commandes autour du jeu (run_game) : PRE avant, ATTACH pendant.
    PRE_CMD=$(unquote "$(autorun_var PRE "")")
    ATTACH_CMD=$(unquote "$(autorun_var ATTACH "")")
    # Bureau virtuel Wine — évite les crashs KDE/WM quand le jeu change la
    # résolution. autorun.cmd (VIRTUAL_DESKTOP=1920x1080) prioritaire sur
    # WSQUASHFS_VIRTUAL_DESKTOP.
    VIRTUAL_DESKTOP=$(autorun_var VIRTUAL_DESKTOP "${WSQUASHFS_VIRTUAL_DESKTOP:-}")

    if [[ -z "$CMD" && "$ACTION" != "exec" ]]; then
        die "CMD non défini dans autorun.cmd"
    fi
}

# ── 9.5 Exécutable ─────────────────────────────────────────────────────

# Windows ignore la casse, les autorun.cmd Batocera aussi : "game.exe" pour
# Game.exe (Rabbids Hollywood Arcade). DIR et CMD sont résolus composant par
# composant, sans tenir compte de la casse.
resolve_executable() {
    local resolved prog exec_name
    DIR="${DIR//\\//}"
    if [[ -n "$DIR" ]] && resolved=$(resolve_ci "$WINEPOINT" "$DIR"); then
        DIR="${resolved#"$WINEPOINT"/}"
    fi

    if [[ "$ACTION" == "exec" ]]; then
        # --exec : fichier du prefix (depuis sa racine, puis depuis le DIR de
        # l'autorun.cmd), sinon outil Wine lancé tel quel (winecfg, regedit...).
        prog="${EXEC_CMD[0]//\\//}"
        EXEC_ARGS_ARR=("${EXEC_CMD[@]:1}")
        EXEC_ARGS="${EXEC_ARGS_ARR[*]}"
        if EXEC_PATH=$(resolve_ci "$WINEPOINT" "$prog") && [[ -f "$EXEC_PATH" ]]; then
            DIR=$(dirname "${EXEC_PATH#"$WINEPOINT"/}")
            [[ "$DIR" == "." ]] && DIR=""
        elif [[ -n "$DIR" ]] && EXEC_PATH=$(resolve_ci "$WINEPOINT" "${DIR}/${prog}") && [[ -f "$EXEC_PATH" ]]; then
            DIR=$(dirname "${EXEC_PATH#"$WINEPOINT"/}")
        else
            EXEC_PATH="${EXEC_CMD[0]}"
            DIR=""
        fi
    else
        # CMD : "exécutable avec espaces" args, ou exécutable args
        if [[ "$CMD" =~ ^\"([^\"]+)\"(.*)$ ]]; then
            exec_name="${BASH_REMATCH[1]}"
            EXEC_ARGS="${BASH_REMATCH[2]# }"
        else
            exec_name=$(printf '%s\n' "$CMD" | awk '{print $1}')
            EXEC_ARGS=$(printf '%s\n' "$CMD" | cut -d' ' -f2- -s)
        fi
        mapfile -d '' -t EXEC_ARGS_ARR < <(split_command_line "$EXEC_ARGS")
        EXEC_PATH=$(resolve_ci "$WINEPOINT" "${DIR:+$DIR/}${exec_name}") \
            || EXEC_PATH="${WINEPOINT}/${DIR:+$DIR/}${exec_name}"
        [[ -f "$EXEC_PATH" ]] || die "exécutable introuvable : $EXEC_PATH" \
            "  CMD : $CMD  |  DIR : ${DIR:-<vide>}"
    fi

    EXT="${EXEC_PATH##*.}"
    EXT="${EXT,,}"
}

# ── 9.6 Choix du runner ────────────────────────────────────────────────
#
# Ordre de priorité, du plus faible au plus fort :
#   1. Wine par défaut (find_wine_binary) ;
#   2. Proton pour un prefix Proton ou un jeu seul (choose_proton_default) ;
#   3. RUNNER= / PROTON= / WINE= de l'autorun.cmd (apply_autorun_runner) ;
#   4. --wine (apply_wine_option).
# Puis setup_umu décide si un Proton passe par umu-run.

# Prefix créé par Proton (Heroic, Steam) : lancé sous Proton, la même
# version si elle est installée, plutôt que sous le Wine par défaut.
choose_proton_default() {
    local found
    PREFIX_PROTON=$(prefix_proton_version)

    # --wine <Proton> (30/09) : sur un prefix Proton ou un jeu sans prefix,
    # lancé par umu comme PROTON= de l'autorun.cmd — auparavant seul le
    # binaire wine du Proton était pris, sans umu ni script proton (mode
    # dégradé, écran noir de Kingdom Hearts III). Sur un prefix Wine
    # (Batocera), inchangé : Wine du Proton lancé directement, Proton ne
    # sachant pas convertir ces prefixes.
    if [[ -n "$WINE_OVERRIDE" ]] && found=$(resolve_wine_override "$WINE_OVERRIDE") \
       && proton_dir_of "$found" >/dev/null \
       && [[ -n "$PREFIX_PROTON" || ! -f "${WINEPOINT}/system.reg" ]]; then
        OVERRIDE_PROTON=$(proton_dir_of "$found")
    fi
    FORCED_WINE="${RUNNER}${WINE_VERSION}"
    [[ -n "$WINE_OVERRIDE" && -z "$OVERRIDE_PROTON" ]] && FORCED_WINE+="$WINE_OVERRIDE"

    # Image sans prefix (jeu seul : jeu PC récent emballé à la main, 27/09) :
    # prefix créé par Proton via umu — proton-cachyos, sinon UMU-Proton,
    # sinon GE-Proton —, les prefixes Batocera (jeux arcade) restant sous
    # wine-tkg. Un prefix Wine déjà créé dans les sauvegardes est gardé tel
    # quel : Proton ne sait pas le convertir (DRAGON BALL Sparking! ZERO,
    # 27/09 : copy_pfx en échec, puis manettes perdues sous Wine avec les DLL
    # de Proton). WINE=tkg dans l'autorun.cmd pour garder wine-tkg.
    if [[ -z "$PREFIX_PROTON" && "$PACKAGED_PREFIX" == "0" && -z "$FORCED_WINE" ]]; then
        if [[ ! -f "${WINEPOINT}/system.reg" ]]; then
            AUTO_PROTON=1
        elif [[ "$DIR_MODE" == "1" ]]; then
            warn "prefix Wine déjà créé dans ${WINEPOINT}, gardé sous $(runner_name "$WINE_BINARY") (Proton ne sait pas le convertir)"
        else
            warn "prefix Wine déjà créé dans les sauvegardes, gardé sous $(runner_name "$WINE_BINARY") — supprimer ${SAVEPOINT} (sauvegardes du jeu comprises) pour passer sous Proton"
        fi
    fi

    [[ -n "$PREFIX_PROTON" || "$AUTO_PROTON" == "1" ]] || return 0
    if found=$(find_proton_runner "$PREFIX_PROTON") && [[ -n "$found" ]]; then
        WINE_BINARY="${found}/files/bin/wine"
        if [[ -n "$PREFIX_PROTON" ]] && ! proton_runner_is "$found" "$PREFIX_PROTON"; then
            warn "prefix créé par ${PREFIX_PROTON} (absent), utilisation de $(basename "$found")"
        fi
    else
        warn "prefix Proton${PREFIX_PROTON:+ (${PREFIX_PROTON})} voulu, aucun Proton installé, utilisation de $(runner_name "$WINE_BINARY")"
        AUTO_PROTON=0
    fi
}

# Runner imposé par l'autorun.cmd : RUNNER= (binaire), PROTON= ou WINE=.
apply_autorun_runner() {
    local found="" d
    if [[ -n "$RUNNER" ]]; then
        if [[ -x "$RUNNER" ]]; then
            WINE_BINARY="$RUNNER"
        else
            warn "runner ${RUNNER} non exécutable, utilisation de $(runner_name "$WINE_BINARY")"
        fi
    elif [[ -n "$PROTON_VERSION" ]]; then
        if found=$(find_proton_runner "$PROTON_VERSION") && [[ -n "$found" ]]; then
            WINE_BINARY="${found}/files/bin/wine"
        elif [[ -x "/usr/local/bin/proton" ]]; then
            WINE_BINARY="/usr/local/bin/proton"
        else
            warn "Proton absent, utilisation de $(runner_name "$WINE_BINARY")"
        fi
    elif [[ -n "$WINE_VERSION" ]]; then
        # WINE=system (30/09) : le Wine du système, comme --wine system. Jeux
        # 32 bits qui échouent sous wine-tkg (non WoW64) mais passent en
        # WoW64 : GTI Club (réservation de 450 Mo refusée), Castlevania (mmap
        # du son). Valeur ignorée par Batocera, qui choisit son runner dans ES.
        if [[ "${WINE_VERSION,,}" == "system" ]]; then
            found=$(command -v wine)
        fi
        for d in "/opt/wine-${WINE_VERSION}" "$HOME/.local/share/wsquashfs/wine/wine-${WINE_VERSION}"; do
            [[ -n "$found" ]] && break
            [[ -x "${d}/bin/wine" ]] && found="${d}/bin/wine" && break
        done
        if [[ -n "$found" ]]; then
            WINE_BINARY="$found"
        else
            warn "Wine ${WINE_VERSION} absent, utilisation de $(runner_name "$WINE_BINARY")"
        fi
    fi
}

# --wine (ligne de commande) : prioritaire sur l'autorun.cmd.
apply_wine_option() {
    local found
    [[ -n "$WINE_OVERRIDE" ]] || return 0
    if found=$(resolve_wine_override "$WINE_OVERRIDE") && [[ -n "$found" ]]; then
        WINE_BINARY="$found"
        return 0
    fi
    {
        echo "Erreur : runner Wine introuvable : ${WINE_OVERRIDE}"
        echo "  Runners installés :"
        list_wine_runners | sed 's/^/    /'
        echo "    system ($(command -v wine 2>/dev/null || echo absent))"
    } >&2
    exit 1
}

# Prefix Proton (ou PROTON= dans l'autorun.cmd) sans runner Wine imposé :
# lancé via umu avec le script proton, comme Heroic (27/09, Kingdom Hearts
# III : écran noir puis LowLevelFatalError avec le seul binaire wine de
# GE-Proton, menu du jeu atteint via umu). Proton gère alors lui-même le
# prefix, DXVK, VKD3D et NVAPI.
setup_umu() {
    if [[ -n "${PREFIX_PROTON}${PROTON_VERSION}${OVERRIDE_PROTON}" || "$AUTO_PROTON" == "1" ]] \
       && [[ -z "$FORCED_WINE" ]]; then
        if [[ -z "$PREFIX_PROTON" && -f "${WINEPOINT}/system.reg" ]]; then
            # PROTON= sur un prefix Wine existant : conversion impossible (voir
            # AUTO_PROTON), on reste sur le Wine par défaut.
            WINE_BINARY=$(find_wine_binary)
            warn "PROTON=${PROTON_VERSION} ignoré, prefix Wine existant — Proton ne sait pas le convertir"
        elif proton_dir_of "$WINE_BINARY" >/dev/null && UMU_RUN=$(find_umu_run); then
            PROTON_DIR=$(proton_dir_of "$WINE_BINARY")
            export GAMEID="${GAMEID:-umu-default}" PROTONPATH="$PROTON_DIR"
        elif [[ "$AUTO_PROTON" == "1" ]]; then
            UMU_RUN=""
            WINE_BINARY=$(find_wine_binary)
            warn "umu-run absent, prefix créé par $(runner_name "$WINE_BINARY") au lieu de Proton"
        else
            UMU_RUN=""
            warn "prefix Proton lancé directement par Wine (umu-run ou Proton absent) — rendu ou stabilité possiblement dégradés"
        fi
    fi
    return 0
}

select_runner() {
    # Base : Wine le plus compatible avec les prefixes Batocera
    WINE_BINARY=$(find_wine_binary)
    choose_proton_default
    apply_autorun_runner
    apply_wine_option
    setup_umu
}

# ── 9.7 Configuration de Wine ──────────────────────────────────────────

# Prefix win32 : il faut un Wine "classique" (avec i386-unix). Les builds
# WoW64 seuls (wine-staging d'Arch depuis 2025) refusent ces prefixes —
# "... is a 32-bit installation, it cannot support 64-bit applications"
# (Lethal Enforcers 3, konamipc). batocera-wine fait le même constat
# (setPrefixArch). On cherche un runner compatible installé.
ensure_win32_runner() {
    local alt
    [[ "$WINE_ARCH" == "win32" ]] || return 0
    wine_supports_win32 "$WINE_BINARY" && return 0
    if [[ -n "$WINE_OVERRIDE" ]]; then
        die "prefix win32, mais le runner choisi (--wine ${WINE_OVERRIDE}) est WoW64 seul"
    fi
    alt=$(find_win32_wine) || die "prefix win32, mais $(runner_name "$WINE_BINARY") est un Wine WoW64 seul" \
        "  (pas de lib/wine/i386-unix) qui ne peut pas lancer de prefix 32 bits." \
        "  → Installer un Wine classique (ex. Kron4ek wine-*-amd64, non wow64)" \
        "    dans /opt ou ~/.local/share/wsquashfs/wine"
    WINE_BINARY="$alt"
}

# Overrides DLL : DXVK/VKD3D/d7vk en Wine direct, équivalents Proton sous umu.
configure_dll_overrides() {
    if [[ -n "$UMU_RUN" ]]; then
        # Proton pose lui-même DXVK/VKD3D/NVAPI dans le prefix. DXVK=0
        # (autorun ou WSQUASHFS_DXVK=0) passe par son équivalent Proton :
        # sans lui, Proton gardait DXVK (01/10). DXVK_WANTED et non DXVK :
        # sans /usr/share/dxvk, DXVK valait 0 et tout jeu Proton passait en
        # wined3d (Ride 6, 10/10 : image qui clignote).
        [[ "$DXVK_WANTED" == "0" ]] && export PROTON_USE_WINED3D=1
        DXVK=0 VKD3D=0 D7VK=0
        # Proton COPIE ~560 DLL de son default_pfx (d3dx9, msvcp, xaudio...)
        # dans chaque prefix au lieu de les lier : ~190 Mo identiques par jeu,
        # 5 Go sur 27 jeux (01/10). PROTON_DLL_COPY vide → liens. Proton
        # convertit lui-même les copies existantes et gère les liens vers un
        # Proton supprimé. Surchargeable (ENV= de l'autorun.cmd).
        export PROTON_DLL_COPY="${PROTON_DLL_COPY-}"
    else
        [[ "$D7VK" == "1" ]] && add_dll_override "ddraw=n,b"
        if [[ "$DXVK" == "1" ]]; then
            add_dll_override "d3d8,d3d9,d3d10core,d3d11,dxgi=n,b"
        else
            # Explicite, comme Batocera : un prefix peut contenir des copies
            # natives de DXVK que Wine chargerait sinon.
            add_dll_override "d3d8,d3d9,d3d10core,d3d11,dxgi=b"
        fi
        [[ "$VKD3D" == "1" ]] && add_dll_override "d3d12,d3d12core=n,b"
    fi

    # Borne arcade : Wine ne doit rien ouvrir côté Linux. winebrowser ouvrait
    # Chrome (profil réel de l'utilisateur) sur la session du stream quand
    # TeknoParrot affichait une page (Initial D Zero) ; winemenubuilder crée
    # des raccourcis de menu (batocera-wine le coupe aussi).
    add_dll_override "winemenubuilder.exe=d;winebrowser.exe=d"
}

# Parse "KEY=VAL KEY2=VAL2" (ENV= de l'autorun.cmd) et exporte, sans eval.
apply_wine_env() {
    local pair
    while IFS= read -r pair; do
        if [[ "$pair" =~ ^[A-Za-z_][A-Za-z0-9_]*=.* ]]; then
            # shellcheck disable=SC2163  # export de "VAR=valeur" voulu
            export "$pair"
        fi
    done <<< "$(tr ' ' '\n' <<< "$1")"
}

configure_wine() {
    local prefix_user effective_user
    # Architecture : autorun.cmd → system.reg → défaut win64
    [[ -n "$WINE_ARCH" ]] || WINE_ARCH=$(detect_prefix_arch)
    ensure_win32_runner

    # Outils Wine lancés sur le prefix (regedit, reg) : par umu pour un prefix
    # Proton — lancés par un autre wine, ils mettraient le prefix à jour pour
    # ce wine, hors de Proton. Fixé ici, une fois le runner définitif (un
    # prefix win32 peut avoir changé de Wine juste au-dessus).
    WINE_TOOL=("$WINE_BINARY")
    [[ -n "$UMU_RUN" ]] && WINE_TOOL=("$UMU_RUN")

    export WINEPREFIX="$WINEPOINT"
    export WINEARCH="$WINE_ARCH"

    # Nom d'utilisateur Wine adapté au prefix : les prefixes Batocera sont
    # packagés avec "steamuser" ; sous un autre nom, Wine crée
    # drive_c/users/$USER à travers l'overlay, ce qui produit ESTALE.
    # Comparé à TARGET_USER (pas $USER, "root" ici) quand on a été élevé.
    prefix_user=$(detect_wine_username)
    effective_user="$USER"
    drops_to_target_user && effective_user="$TARGET_USER"
    if [[ -n "$prefix_user" && "$prefix_user" != "$effective_user" ]]; then
        export WINEUSERNAME="$prefix_user"
    fi

    [[ "$ESYNC" == "1" ]] && export WINEESYNC=1
    [[ "$FSYNC" == "1" ]] && export WINEFSYNC=1

    configure_dll_overrides

    # Batocera exporte WINEDEBUG=-all (les fixme ralentissent certains jeux) ;
    # on garde les err: pour le diagnostic. Surchargeable depuis l'environnement.
    export WINEDEBUG="${WINEDEBUG:-fixme-all}"

    # shellcheck disable=SC2031  # sans rapport avec le sous-shell de text_width
    [[ -n "$WINE_LANG" ]] && export LC_ALL="$WINE_LANG"
    [[ -n "$WINE_ENV" ]] && apply_wine_env "$WINE_ENV"
    return 0
}

# ── 9.8 Préparation du prefix ──────────────────────────────────────────

# Crée le prefix d'un jeu seul, ou répare celui qui a perdu son system32
# (effacé à chaque lancement par les versions du 25-26/09, voir
# clear_generated_system_dlls).
init_prefix_if_needed() {
    if [[ -n "$UMU_RUN" ]]; then
        # Prefix créé ou mis à jour par Proton lui-même au lancement.
        [[ -f "${WINEPOINT}/system.reg" ]] || echo "Initialisation du préfixe par Proton au premier lancement..."
        return 0
    fi
    if [[ -f "${WINEPOINT}/system.reg" && -d "${WINEPOINT}/drive_c" ]] \
       && [[ "$PACKAGED_PREFIX" == "1" || -f "${WINEPOINT}/drive_c/windows/system32/explorer.exe" ]]; then
        echo "✓ Préfixe Wine détecté (structure Batocera)"
        return 0
    fi
    # .wsquashfs sans prefix (jeu seul : NBA 2K23, Robin Hood...) : prefix
    # créé dans l'overlay, en utilisateur Wine — lancé en root, Wine refusait
    # ("... is not owned by you") et le lanceur restait bloqué.
    echo "Initialisation du préfixe Wine ($WINE_ARCH)..."
    # Réparation : wineboot -u ne réinstalle RIEN tant que .update-timestamp
    # correspond à la version de Wine (26/09 : 0 fichier recréé, 816 sans
    # l'horodatage). Sans effet sur un prefix neuf.
    rm -f "${WINEPOINT}/.update-timestamp"
    run_wineboot_update "$WINEDEBUG" 2>&1 | grep -v "fixme:" || true
    run_wineserver "$WINEPOINT" -w || true
    # Overlay : JAMAIS de chown sur WINEPOINT (le montage) — chaque fichier
    # du jeu serait recopié dans SAVEPOINT (70 Go sur NBA 2K23). L'upperdir
    # suffit, squash_to_uid s'occupe du reste.
    if [[ "$MOUNT_MODE" == "overlay" ]]; then
        chown_to_target "$SAVEPOINT"
    else
        chown_to_target "$WINEPOINT"
    fi
}

# DLL du runner, DXVK, VKD3D, d7vk (compatibilité prefixes Batocera / Wine
# 10+). Sous umu, Proton s'en charge.
install_prefix_dlls() {
    [[ -z "$UMU_RUN" ]] || return 0
    # Overlay noyau : le copy-up de system32/syswow64 fonctionne (le jeu
    # appartient à l'utilisateur dans le namespace), écriture directe dans
    # le prefix, sans rechargement.
    if [[ "$MOUNT_MODE" == "overlay" && "$OVERLAY_KIND" == "fuse" ]]; then
        # Écriture dans l'upperdir (voir sync_wine_stubs), rendue au
        # propriétaire de Wine, puis overlay rechargé : fuse-overlayfs ne
        # voit pas les fichiers ajoutés dans l'upperdir après le montage.
        link_runtime_dlls "$SAVEPOINT"
        chown_to_target "$SAVEPOINT"
        reload_overlay "après sync DLLs"
    else
        link_runtime_dlls "$WINEPOINT"
        chown_to_target "$WINEPOINT"
    fi
}

# Fichiers .reg du dossier regs/ du prefix, importés à chaque lancement.
import_registry_files() {
    local regfile
    [[ -d "${WINEPOINT}/regs" ]] || return 0
    echo "Import des fichiers de registre..."
    while IFS= read -r -d '' regfile; do
        echo "  → $(basename "$regfile")"
        run_wine_tool regedit "//?/unix${regfile}" 2>/dev/null || true
    done < <(find "${WINEPOINT}/regs" -maxdepth 1 -type f -iname "*.reg" -print0)
}

prepare_prefix() {
    init_prefix_if_needed
    [[ -z "$UMU_RUN" ]] && update_prefix_if_needed
    fix_userdata_links
    install_prefix_dlls
    import_registry_files
}

# ── 9.9 Manettes ───────────────────────────────────────────────────────

# Manettes par hidraw dans Wine — option enable_hidraw de batocera-wine,
# DÉSACTIVÉE par défaut comme chez Batocera : XInput (manette Xbox via SDL),
# que tous les jeux comprennent. Essayée par défaut deux fois, deux fois
# abandonnée avec la DualSense virtuelle de Sunshine (uhid, seule lisible
# par hidraw) : touches décalées (24/09 : SNK Heroines, Sonic & All-Stars
# Racing), puis aucune commande reçue par un jeu XInput seul (27/09 : DRAGON
# BALL Sparking! ZERO). HIDRAW=1 dans l'autorun.cmd (par jeu) ou
# WSQUASHFS_HIDRAW=1 (prioritaire) pour un jeu qui gère la DualSense
# lui-même — seulement si la manette Sony est lisible (hidraw_usable), sinon
# repli XInput. La valeur est imposée dans les deux sens à chaque lancement.
# HIDRAW=1 (02/10) : une DualSense Bluetooth (celle de Sunshine) est
# présentée au jeu en DualSense USB par dualsense-usb-bridge — les libScePad
# de 2022 (F1 22) refusent la Bluetooth. HIDRAW=bt garde la DualSense
# Bluetooth en direct : ses haptiques passent en rapports HID (Until Dawn),
# alors qu'en USB les jeux les jouent en audio, non transmis.
choose_hidraw_mode() {
    local mode
    HIDRAW_DISABLE=1
    HIDRAW_MSG="XInput, manette Xbox"
    mode="${WSQUASHFS_HIDRAW:-$(autorun_var HIDRAW "0")}"
    [[ "$mode" == "1" || "$mode" == "bt" ]] || return 0
    if ! hidraw_usable; then
        HIDRAW_MSG="XInput, manette Xbox (hidraw demandé : ${HIDRAW_REASON})"
        return 0
    fi
    HIDRAW_DISABLE=0
    HIDRAW_MSG="DualSense/DualShock en direct (hidraw)"
    if [[ "$mode" == "1" ]] && start_dualsense_bridge; then
        HIDRAW_MSG="DualSense USB (dualsense-usb-bridge, depuis la DualSense Bluetooth)"
    fi
}

# GE-Proton (30/09) : sa SDL ignore TOUJOURS les manettes Sony ("ignoring SDL
# DualSense device; hidraw handles native reports") et les laisse au backend
# hidraw. Hidraw coupé (mode XInput par défaut), la DualSense n'était gérée
# par personne : aucune manette dans Kena, The Devil in Me, Like a Dragon...
# En mode XInput, on garde donc hidraw et GE-Proton présente la manette Sony
# en XInput (PROTON_SONY_HIDRAW_XINPUT). Les Proton de Valve (UMU-Proton,
# proton-cachyos) n'ont pas ce correctif : leur SDL gère la DualSense.
apply_ge_proton_sony_fix() {
    local proton_root=""
    [[ "$WINE_BINARY" == */files/bin/wine ]] && proton_root="${WINE_BINARY%/files/bin/wine}"
    if [[ "$HIDRAW_DISABLE" == "1" && -n "$proton_root" ]] \
       && grep -aqs "hidraw handles native reports" "${proton_root}/files/lib/wine/x86_64-unix/winebus.so" \
       && hidraw_usable; then
        HIDRAW_DISABLE=0
        export PROTON_SONY_HIDRAW_XINPUT=1
        HIDRAW_MSG="XInput, manette Xbox (manette Sony par hidraw, convertie par GE-Proton)"
    fi
}

# Inscrit DisableHidraw dans le registre s'il diffère (prefix Proton :
# registre dans pfx/).
write_hidraw_setting() {
    if grep -qs "\"DisableHidraw\"=dword:0000000${HIDRAW_DISABLE}" "${WINEPOINT}/system.reg" "${WINEPOINT}/pfx/system.reg"; then
        return 0
    fi
    run_wine_tool reg add 'HKLM\System\CurrentControlSet\Services\winebus' \
        /v DisableHidraw /t REG_DWORD /d "${HIDRAW_DISABLE}" /f >/dev/null 2>&1 || true
    run_wineserver "$WINEPOINT" -k || true
    run_wineserver "$WINEPOINT" -w || true
}

configure_controllers() {
    choose_hidraw_mode
    apply_ge_proton_sony_fix
    write_hidraw_setting
}

# ── 9.10 Récapitulatif et exécution ────────────────────────────────────

print_summary() {
    echo "-----------------------------------------"
    echo "Exécutable    : $EXEC_PATH"
    echo "Arguments     : ${EXEC_ARGS:-<aucun>}"
    local version
    if [[ -n "$UMU_RUN" ]]; then
        echo "Proton        : $(basename "$PROTON_DIR") via umu ($PROTON_DIR)"
        version=$(runner_version "${PROTON_DIR}/files/bin/wine")
        [[ -n "$version" ]] && echo "Version Proton: $version"
    else
        echo "Wine          : $WINE_BINARY ($WINE_ARCH)"
        version=$(runner_version "$WINE_BINARY")
        [[ -n "$version" ]] && echo "Version Wine  : $version"
    fi
    echo "Préfixe       : $WINEPREFIX"
    [[ -n "${WINEUSERNAME:-}" ]] && echo "Utilisateur   : $WINEUSERNAME (adapté au prefix)"
    if [[ "$RUN_AS_ROOT" == true ]]; then
        if [[ -n "$TARGET_USER" ]]; then
            echo "Privilège     : montage en root, Wine relancé en $TARGET_USER"
        else
            warn "lancé en root sans SUDO_USER — l'affichage risque d'échouer (pas de cookie X11)"
        fi
    fi
    [[ "$MOUNT_MODE" == "overlay" ]] && echo "Sauvegardes   : $SAVEPOINT"
    echo "Manettes      : $HIDRAW_MSG"
    [[ "$DXVK"  == "1" ]] && echo "DXVK          : activé"
    [[ "$VKD3D" == "1" ]] && echo "VKD3D         : activé"
    [[ "$D7VK"  == "1" ]] && echo "D7VK          : activé (DirectDraw → Vulkan)"
    [[ "$ESYNC" == "1" ]] && echo "ESYNC         : activé"
    [[ "$FSYNC" == "1" ]] && echo "FSYNC         : activé"
    [[ -n "$WINE_LANG" ]] && echo "Langue        : $WINE_LANG"
    [[ -n "$VIRTUAL_DESKTOP" ]] && echo "Bureau virtuel: ${VIRTUAL_DESKTOP}"
    echo "========================================="
    echo ""
}

# Ligne de commande du jeu dans RUN_CMD : wine [explorer /desktop=…]
# [cmd /c] exe args. umu-run prend la place de wine : même ligne de commande
# (exécutable Unix, explorer, cmd /c...), transmise au script proton.
build_run_command() {
    local desktop_name
    RUN_CMD=("$WINE_BINARY")
    if [[ -n "$VIRTUAL_DESKTOP" ]]; then
        # Bureau virtuel : empêche le jeu de changer la résolution système
        # (crash KDE/WM).
        desktop_name=$(printf '%s\n' "$GAME_NAME" | tr ' ' '_' | tr -cd 'a-zA-Z0-9_')
        RUN_CMD+=(explorer "/desktop=${desktop_name},${VIRTUAL_DESKTOP}")
    fi
    [[ "$EXT" == "bat" ]] && RUN_CMD+=(cmd /c)
    RUN_CMD+=("$EXEC_PATH" "${EXEC_ARGS_ARR[@]}")
    [[ -n "$UMU_RUN" ]] && RUN_CMD[0]="$UMU_RUN"
    return 0
}

# Lance la commande en TARGET_USER avec l'environnement du jeu. SDL_* :
# winebus lit les manettes via SDL — sans elles, un mapping
# SDL_GAMECONTROLLERCONFIG et SDL_JOYSTICK_DISABLE_UDEV de la session étaient
# perdus. env explicite plutôt que `sudo --preserve-env` : certaines
# politiques sudoers restreignent --preserve-env, alors que des VAR=valeur
# passées à `env` fonctionnent toujours.
run_as_target_user() {
    sudo -u "$TARGET_USER" env \
        DISPLAY="${DISPLAY:-}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        WINEPREFIX="$WINEPREFIX" \
        WINEARCH="$WINEARCH" \
        WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}" \
        WINEESYNC="${WINEESYNC:-}" \
        WINEFSYNC="${WINEFSYNC:-}" \
        WINEUSERNAME="${WINEUSERNAME:-}" \
        LC_ALL="${LC_ALL:-}" \
        WINEDEBUG="${WINEDEBUG:-}" \
        GAMEID="${GAMEID:-}" \
        PROTONPATH="${PROTONPATH:-}" \
        SDL_GAMECONTROLLERCONFIG="${SDL_GAMECONTROLLERCONFIG:-}" \
        SDL_JOYSTICK_DISABLE_UDEV="${SDL_JOYSTICK_DISABLE_UDEV:-}" \
        PROTON_SONY_HIDRAW_XINPUT="${PROTON_SONY_HIDRAW_XINPUT:-}" \
        ${PROTON_USE_WINED3D:+PROTON_USE_WINED3D=$PROTON_USE_WINED3D} \
        PROTON_DLL_COPY="${PROTON_DLL_COPY-}" \
        MANGOHUD="${MANGOHUD:-}" \
        MANGOHUD_CONFIG="${MANGOHUD_CONFIG:-}" \
        MANGOHUD_CONFIGFILE="${MANGOHUD_CONFIGFILE:-}" \
        "$@"
}

# Lanceur en namespace : commande en tâche de fond suivie de wait. Au
# premier plan, bash ne traite le SIGTERM (--umount, lanceur de l'hôte
# arrêté) qu'à la fin de la commande, c'est-à-dire du jeu : l'arrêt était
# sans effet.
run_interruptible() {
    if [[ -n "$NS_STAGE" ]]; then
        "$@" <&0 &
        wait "$!"
    else
        "$@"
    fi
}

# Le jeu lui-même, avec l'utilisateur de la partie.
play_game() {
    if drops_to_target_user; then
        run_as_target_user "${RUN_CMD[@]}"
    else
        run_interruptible as_wine_user "${RUN_CMD[@]}"
    fi
}

# PRE= (autorun.cmd) : commande lancée une fois avant le jeu, dans son
# dossier. Un échec arrête le lancement : le jeu ne démarre pas sans elle.
# Sert à préparer des fichiers (correctif, identifiant…) que l'image ne
# peut pas contenir tels quels.
run_pre_command() {
    [[ -n "$PRE_CMD" ]] || return 0
    as_wine_user bash -c "$PRE_CMD" || die "PRE a échoué : ${PRE_CMD}"
}

# ATTACH= (autorun.cmd) : commande lancée pendant le jeu, une fois son
# processus trouvé. GAME_PID contient son PID. Le nom cherché est celui de
# l'exécutable, tronqué à 15 caractères comme le nom de processus du noyau.
# $1 : PID du lanceur du jeu, pour arrêter l'attente si le jeu meurt avant.
start_attach_command() {
    local exe pid="" _
    exe=$(basename "$EXEC_PATH")
    exe=${exe:0:15}
    for _ in $(seq 1 600); do
        pid=$(pgrep -x "$exe" | head -n 1)
        [[ -n "$pid" ]] && break
        kill -0 "$1" 2>/dev/null || break
        sleep 0.1
    done
    if [[ -z "$pid" ]]; then
        warn "ATTACH : processus ${exe} introuvable, commande non lancée"
        return 0
    fi
    as_wine_user env GAME_PID="$pid" bash -c "$ATTACH_CMD" <&0 &
    ATTACH_PID=$!
}

# Arrête ATTACH à la fin du jeu : elle a 5 s pour finir seule.
stop_attach_command() {
    local _
    [[ -n "$ATTACH_PID" ]] || return 0
    for _ in {1..50}; do
        kill -0 "$ATTACH_PID" 2>/dev/null || break
        sleep 0.1
    done
    kill "$ATTACH_PID" 2>/dev/null
    wait "$ATTACH_PID" 2>/dev/null
    ATTACH_PID=""
}

run_game() {
    local exit_code play_pid
    cd "${WINEPOINT}${DIR:+/$DIR}" || exit 1
    build_run_command
    run_pre_command

    if [[ -n "$ATTACH_CMD" ]]; then
        play_game <&0 &
        play_pid=$!
        start_attach_command "$play_pid"
        wait "$play_pid"
        exit_code=$?
        stop_attach_command
    else
        play_game
        exit_code=$?
    fi

    # Beaucoup de jeux passent par un lanceur qui démarre le vrai exécutable
    # puis quitte aussitôt (ring_loader.exe → DOA5A.exe, TeknoParrotUi →
    # OpenParrot) : sans cette attente, cleanup() tuait le jeu à peine lancé
    # (Dead or Alive 5 Ultimate). Comme Batocera : on attend que tous les
    # processus du prefix aient terminé.
    run_interruptible run_wineserver "$WINEPOINT" -w || true

    echo ""
    echo "========================================="
    echo "Jeu terminé (code : $exit_code)"
    echo "========================================="
    exit "$exit_code"
}

launch_game() {
    resolve_game_path
    check_dependencies
    init_game_paths
    if [[ -n "$NS_STAGE" ]]; then
        # Relancé dans le namespace : en-tête affiché, verrou pris (hérité)
        # et dossiers préparés par le lanceur de l'hôte (mount_image).
        LOCKED_GAME="$GAME_NAME"
        use_kernel_overlay
    else
        print_header
        acquire_game_lock || die "${GAME_NAME} est déjà lancé"
        if [[ "$DIR_MODE" == "1" ]]; then
            use_installed_dir
        else
            mount_image
        fi
    fi
    [[ "$ACTION" == "mount" ]] && report_mount_and_exit
    read_autorun
    resolve_executable
    select_runner
    configure_wine
    prepare_prefix
    configure_controllers
    apply_savedir "$SAVEDIR" "$SAVEFILES"
    print_summary
    run_game
}

# ════════════════════════════════════════════════════════════════════════
# 10. POINT D'ENTRÉE
# ════════════════════════════════════════════════════════════════════════

# Fin du script (normale, erreur ou signal) : arrête le pont DualSense, le
# wineserver et démonte le jeu (mode overlay ; la copie persiste).
# shellcheck disable=SC2317  # appelée par trap
cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM
    # Le script a fait un cd dans WINEPOINT pour lancer le jeu : sans en
    # sortir, son propre CWD rend l'overlay "busy" et le démontage échouait
    # à chaque fois — d'où les montages orphelins (confirmé en direct).
    cd / || true
    [[ -n "$ATTACH_PID" ]] && kill "$ATTACH_PID" 2>/dev/null
    # Jeu lancé dans un namespace (overlay noyau) : arrêt transmis au
    # lanceur du namespace, qui arrête Wine et démonte.
    if [[ -n "$NS_PID" ]]; then
        kill -TERM "$NS_PID" 2>/dev/null
        wait "$NS_PID" 2>/dev/null
        rm -rf "$NS_DIR"
    fi
    stop_dualsense_bridge
    if [[ "$MOUNTED" == true ]]; then
        stop_wineserver
        if [[ "$MOUNT_MODE" == "overlay" ]]; then
            umount_retry "$WINEPOINT"
            umount_retry "$SQUASHFSPOINT"
            [[ -d "$WORKPOINT" ]] && reset_workdir "$WORKPOINT" && rmdir "$WORKPOINT"
        fi
    fi
    exit "$exit_code"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                ACTION="help"
                return 0
                ;;
            --clean|--clear|--umount|--pack|--install|--info|--backup|--list|--doctor)
                # Commandes autonomes : le reste de la ligne leur appartient.
                ACTION="${1#--}"
                CMD_ARGS=("${@:2}")
                return 0
                ;;
            --wine)
                [[ -n "${2:-}" ]] || die "--wine attend une version ou un chemin"
                WINE_OVERRIDE="$2"
                shift 2
                ;;
            --mount)
                ACTION="mount"
                shift
                ;;
            --exec)
                ACTION="exec"
                GAME_ARG="${2:-}"
                EXEC_CMD=("${@:3}")
                if [[ -z "$GAME_ARG" || ${#EXEC_CMD[@]} -eq 0 ]]; then
                    usage_error "$0 --exec <jeu.wsquashfs> <programme> [arguments...]"
                fi
                return 0
                ;;
            -*)
                die "option inconnue : $1  (voir $0 --help)"
                ;;
            *)
                [[ -z "$GAME_ARG" ]] || die "un seul jeu attendu (voir $0 --help)"
                GAME_ARG="$1"
                shift
                ;;
        esac
    done
}

main() {
    ORIG_ARGS=("$@")
    restore_sudo_user_session
    limit_stack_size
    init_config
    # Relancé dans le namespace de l'overlay noyau (run_in_kernel_overlay) :
    # variables d'échange retirées de l'environnement du jeu.
    if [[ -n "${WSQUASHFS_NS_STAGE:-}" ]]; then
        NS_STAGE="$WSQUASHFS_NS_STAGE"
        NS_DIR="$WSQUASHFS_NS_DIR"
        unset WSQUASHFS_NS_STAGE WSQUASHFS_NS_DIR
    fi
    trap cleanup EXIT INT TERM

    fix_ownership "$CACHE_DIR"
    fix_ownership "$SAVES_DIR"

    parse_args "$@"
    case "$ACTION" in
        help)    usage ;;
        clean)   cmd_clean ;;
        clear)   cmd_clear "${CMD_ARGS[@]}" ;;
        umount)  cmd_umount "${CMD_ARGS[@]}" ;;
        pack)    pack_prefix "${CMD_ARGS[@]}" ;;
        install) install_game "${CMD_ARGS[@]}" ;;
        info)    show_info "${CMD_ARGS[@]}" ;;
        backup)  cmd_backup "${CMD_ARGS[@]}" ;;
        list)    cmd_list ;;
        doctor)  cmd_doctor ;;
        *)       launch_game ;;   # run, mount, exec : ne revient pas
    esac
}

# Exécuté (et non chargé par « source », comme le font les tests) : on lance.
# exit dans le même bloc : bash lit un script au fur et à mesure ; un lanceur
# mis à jour pendant une partie ne doit pas être relu après main.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
    exit
fi
