#!/usr/bin/env bash
#
# wsquashfs-launcher — lance un jeu Windows .wsquashfs (format Batocera) sur
# n'importe quel Linux, machine physique ou conteneur Docker.
#
# Usage : wsquashfs-launcher --help
#
# Modes de montage (choisis automatiquement) :
#   overlay  l'image reste intacte, ce que le jeu écrit va dans
#            SAVES_DIR/<jeu> (couche de sauvegardes). Overlay du noyau dans
#            un namespace utilisateur quand l'environnement le permet (testé
#            à chaque lancement), sinon squashfuse + fuse-overlayfs
#   copy     squashfuse ou unsquashfs : copie de travail persistante (cache)
#   dir      jeu installé (--install) : dossier lancé sur place, sans FUSE
#
# Aucun privilège requis (27/09) : squashfuse et fuse-overlayfs montent
# l'image en utilisateur (FUSE, comme les AppImage), et les fichiers
# root:root restrictifs des paquets Batocera se lisent tels quels — vérifié
# sur Blade Strangers (game/RConfig.exe, root rw-r-----). Lancé en
# utilisateur, tout (montages, Wine, sauvegardes) lui appartient. Toujours
# utilisable sous sudo (frontends qui l'élèvent) : voir init_config.
#
# Organisation du fichier :
#    1. Configuration et environnement d'exécution
#    2. Utilitaires
#    3. Lecture de l'autorun.cmd
#    4. Montages FUSE et cache
#    5. Runners Wine / Proton
#    6. Préparation du prefix (DLL, DXVK, registre, sauvegardes)
#    7. Manettes
#    8. Commandes de maintenance (--clean, --clear, --pack, --info...)
#    9. Lancement d'un jeu (étapes appelées dans l'ordre par launch_game)
#   10. Point d'entrée
#
# Conventions :
#   - MAJUSCULES : variables globales (configuration, état du lancement),
#     toutes déclarées en section 1 ; minuscules : variables locales.
#   - Pas de « set -euo pipefail » : le lanceur est volontairement
#     tolérant (démontages, chown, nettoyages peuvent échouer sans gêner la
#     partie) et plusieurs pipelines s'arrêtent tôt (head -1, grep -q).
#     Chaque erreur bloquante est testée explicitement et passe par die().
#   - Les dates (JJ/MM) dans les commentaires renvoient aux constats qui ont
#     motivé un comportement : à relire avant de le modifier.

# ════════════════════════════════════════════════════════════════════════
# 1. CONFIGURATION ET ENVIRONNEMENT D'EXÉCUTION
# ════════════════════════════════════════════════════════════════════════

# ── Configuration (figée par init_config) ──────────────────────────────
SAVES_DIR=""            # couches de sauvegardes (upperdir overlay), une par jeu
CACHE_DIR=""            # montages et copies de travail
RUN_AS_ROOT=false       # true : lancé en root (sudo)
TARGET_USER=""          # utilisateur qui lance Wine quand on est root (SUDO_USER)
ALLOW_OTHER_OPT=""      # option FUSE allow_other, en root seulement
WINE_UID="" WINE_GID="" # propriétaire de tout ce que Wine doit pouvoir écrire
OVERLAY_SQUASH_OPT=""   # options fuse-overlayfs squash_to_uid/gid
OVERLAY_PREF=""         # auto | kernel | fuse (WSQUASHFS_OVERLAY)
SELF=""                 # chemin de ce script, relancé dans le namespace

# ── Ligne de commande (parse_args) ─────────────────────────────────────
ACTION="run"            # run | mount | exec | help, ou une commande de maintenance
                        # (clean, clear, umount, pack, install, info, backup, list, doctor)
GAME_ARG=""             # jeu demandé (.wsquashfs ou dossier installé)
WINE_OVERRIDE=""        # --wine <version|chemin>
EXEC_CMD=()             # --exec : programme et ses arguments
CMD_ARGS=()             # arguments d'une commande de maintenance
ORIG_ARGS=()            # ligne de commande d'origine (relance dans le namespace)

# ── Jeu et montage ─────────────────────────────────────────────────────
WSQUASHFS_FILE=""       # chemin absolu du .wsquashfs (ou du dossier installé)
DIR_MODE=0              # 1 : jeu installé, lancé sur place
GAME_NAME=""
AUTORUN_OVERRIDE=""     # <jeu>.wsquashfs.autorun s'il existe
MOUNT_MODE=""           # overlay | copy | dir
OVERLAY_KIND=""         # mode overlay : kernel (namespace) | fuse (fuse-overlayfs)
MOUNTED=false           # true : cleanup() doit arrêter Wine et démonter
SQUASHFSPOINT=""        # image montée (lowerdir)
WINEPOINT=""            # prefix vu par Wine (overlay, copie ou dossier)
SAVEPOINT=""            # couche de sauvegardes du jeu (upperdir)
WORKPOINT=""            # workdir de l'overlay, à côté de SAVEPOINT
NS_STAGE=""             # 1 : relancé dans le namespace de l'overlay noyau
NS_DIR=""               # dossier d'échange hôte/namespace (statut, liens)
NS_PID=""               # lanceur en namespace démarré par ce processus (hôte)
PACKAGED_PREFIX=0       # 1 : l'image contient un prefix (system.reg)
PROTON_PREFIX=0         # 1 : prefix créé par Proton (config_info)
LOCK_FD=""              # descripteur du verrou du jeu (acquire_game_lock)
LOCKED_GAME=""          # jeu dont ce lancement tient le verrou

# ── autorun.cmd (read_autorun) ─────────────────────────────────────────
DIR="" CMD="" WINE_VERSION="" PROTON_VERSION="" RUNNER="" WINE_ARCH=""
DXVK="" DXVK_WANTED="" VKD3D="" D7VK="" SAVEDIR="" SAVEFILES=""
ESYNC="" FSYNC="" WINE_LANG="" WINE_ENV="" VIRTUAL_DESKTOP=""
PRE_CMD="" ATTACH_CMD="" ATTACH_PID=""

# ── Exécutable (resolve_executable) ────────────────────────────────────
EXEC_PATH=""            # chemin Unix de l'exécutable, ou outil Wine (--exec)
EXEC_ARGS=""            # arguments, pour l'affichage (CMD tel qu'écrit, ou --exec)
EXEC_ARGS_ARR=()
EXT=""                  # extension de l'exécutable, en minuscules
RUN_CMD=()              # ligne de commande finale (build_run_command)

# ── Runner (select_runner) ─────────────────────────────────────────────
WINE_BINARY=""
PREFIX_PROTON=""        # version de Proton qui a créé le prefix
OVERRIDE_PROTON=""      # Proton demandé par --wine, lancé par umu
FORCED_WINE=""          # runner Wine imposé (autorun.cmd ou --wine)
AUTO_PROTON=0           # 1 : jeu seul, prefix à créer par Proton
UMU_RUN=""              # umu-run utilisé, vide si Wine lancé directement
PROTON_DIR=""
WINE_TOOL=()            # lanceur des outils Wine (regedit, reg) : configure_wine

# ── Manettes (configure_controllers) ───────────────────────────────────
HIDRAW_DISABLE=1
HIDRAW_MSG=""
HIDRAW_REASON=""
DS_BRIDGE_PID=""

# Cache de under_opaque (--clean) : dossier relatif → y/n.
declare -A OPAQUE_CACHE=()

# Lancé par un simple "sudo" (sans -E) : sudo remet HOME=/root et efface
# XDG_RUNTIME_DIR/WAYLAND_DISPLAY — montages et sauvegardes partaient dans
# /root, inaccessible à Wine relancé en utilisateur ("wine: cannot use
# directory /root/.cache/wsquashfs/…: Permission denied", 26/09). On repart
# de l'utilisateur d'origine (SUDO_USER) ; une valeur conservée par sudo -E
# n'est jamais remplacée.
restore_sudo_user_session() {
    [[ "${EUID}" -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]] || return 0
    local home runtime
    home=$(getent passwd "${SUDO_USER}" | cut -d: -f6)
    if [[ -n "$home" && "${HOME:-/root}" == "/root" ]]; then
        export HOME="$home"
    fi
    runtime="/run/user/$(id -u "${SUDO_USER}")"
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "$runtime" ]]; then
        export XDG_RUNTIME_DIR="$runtime"
    fi
    if [[ -z "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/wayland-0" ]]; then
        export WAYLAND_DISPLAY=wayland-0
    fi
}

# Pile limitée à 8 Mo si elle est illimitée (30/09) — cas de Docker sur
# Unraid. Pile illimitée, Linux passe à la disposition mémoire « legacy »
# (bibliothèques vers 0x14… au lieu de 0x7f…) : proton-cachyos ne démarrait
# pas (son émulation seccomp tue les processus enfants chargés sous
# 0x7001_0000_0000 : wineboot en SIGSYS), et les jeux 32 bits sous wine-tkg
# n'obtenaient plus leurs grosses réservations (GTI Club, 450 Mo refusés).
# Limite souple seulement : toujours permise, héritée par Wine et Proton.
limit_stack_size() {
    if [[ "$(ulimit -s)" == "unlimited" ]]; then
        ulimit -S -s 8192 2>/dev/null || true
    fi
}

init_config() {
    SAVES_DIR="${WSQUASHFS_SAVES_DIR:-$HOME/.local/share/wsquashfs/saves}"
    CACHE_DIR="${WSQUASHFS_CACHE:-$HOME/.cache/wsquashfs}"

    # Un frontend peut élever ce script via `sudo -E` (inutile, voir l'en-tête,
    # mais toujours pris en charge). Root n'a pas le cookie X11 (~/.Xauthority)
    # de la session graphique : lancer Wine tel quel donne "Authorization
    # required, but no authorization protocol specified" puis "no driver could
    # be loaded" — confirmé en direct. Montage et extraction restent donc en
    # root, mais Wine est relancé en SUDO_USER (voir as_wine_user).
    # allow_other n'est utile que dans ce cas : sans lui, un montage fait en
    # root reste invisible à SUDO_USER (FUSE : seul le monteur ou root peut y
    # accéder), d'où des "Permission denied" au lancement suivant.
    RUN_AS_ROOT=false
    if [[ "$(id -u)" -eq 0 ]]; then
        RUN_AS_ROOT=true
        ALLOW_OTHER_OPT="allow_other"
    fi
    TARGET_USER="${SUDO_USER:-}"

    # Le contenu des .wsquashfs Batocera appartient à root:root (755/644) et
    # fuse-overlayfs applique ces droits (default_permissions) : Wine ne
    # pouvait alors RIEN modifier dans le jeu — confirmé sur Initial D 8
    # (segare) : "UnauthorizedAccessException: Access to the path
    # C:\game\...\teknoparrot.ini is denied". squash_to_uid/gid fait
    # apparaître toute l'arborescence fusionnée comme appartenant à
    # l'utilisateur qui lance Wine.
    WINE_UID=$(id -u)
    WINE_GID=$(id -g)
    if drops_to_target_user; then
        WINE_UID=$(id -u "$TARGET_USER")
        WINE_GID=$(id -g "$TARGET_USER")
    fi
    OVERLAY_SQUASH_OPT="squash_to_uid=${WINE_UID},squash_to_gid=${WINE_GID}"

    OVERLAY_PREF="${WSQUASHFS_OVERLAY:-auto}"
    case "$OVERLAY_PREF" in
        auto|kernel|fuse) ;;
        *) die "WSQUASHFS_OVERLAY=${OVERLAY_PREF} : valeurs possibles auto, kernel, fuse" ;;
    esac
    SELF=$(readlink -f "${BASH_SOURCE[0]}")

    readonly SAVES_DIR CACHE_DIR RUN_AS_ROOT TARGET_USER ALLOW_OTHER_OPT \
             WINE_UID WINE_GID OVERLAY_SQUASH_OPT OVERLAY_PREF SELF
}

# Vrai si l'on tourne en root pour le compte d'un utilisateur (sudo) : Wine
# doit alors être lancé en TARGET_USER.
drops_to_target_user() {
    [[ "$RUN_AS_ROOT" == true && -n "$TARGET_USER" ]]
}

# Exécute une commande en tant que l'utilisateur qui lance Wine.
# Overlay noyau : sans les capacités du namespace, gardées par le lanceur
# pour monter — le bwrap de Proton (pressure-vessel) refuse de démarrer avec
# des capacités sans être setuid.
as_wine_user() {
    if drops_to_target_user; then
        sudo -u "$TARGET_USER" "$@"
    elif [[ -n "$NS_STAGE" ]]; then
        setpriv --inh-caps=-all --ambient-caps=-all "$@"
    else
        "$@"
    fi
}

detect_env() {
    if [[ -f /.dockerenv ]] || grep -qE 'docker|lxc' /proc/1/cgroup 2>/dev/null; then
        echo "Docker"
    else
        echo "Physical"
    fi
}

# Auto-correction de propriété sur le cache : un dossier créé par un autre
# UID (session sudo antérieure, ancien PUID de conteneur avant remap
# usermod...) bloque ensuite mkdir/rm/unsquashfs pour TOUS les jeux. On
# corrige la racine en une passe (rien si déjà correct). sudo -n : jamais de
# prompt (le script peut tourner sans TTY) ; sans sudo, no-op silencieux.
#
# Propriétaire visé = l'utilisateur qui lance Wine. find -xdev, jamais
# chown -R : ce dernier traversait les overlays encore montés sous CACHE_DIR
# et chaque chown y déclenchait un copy-up — confirmé en direct, le jeu
# ENTIER recopié dans SAVES_DIR (7 Go par jeu).
fix_ownership() {
    local path="$1"
    [[ -e "$path" ]] || return 0
    [[ "$(stat -c '%u' "$path" 2>/dev/null)" == "$WINE_UID" ]] && return 0
    local chown_cmd=(chown)
    if [[ "$(id -u)" -ne 0 ]]; then
        command -v sudo &>/dev/null || return 0
        chown_cmd=(sudo -n chown)
    fi
    find "$path" -xdev ! -user "$WINE_UID" -print0 2>/dev/null \
        | xargs -0r "${chown_cmd[@]}" -h "${WINE_UID}:${WINE_GID}" 2>/dev/null || true
}

# Lancé en root, tout ce que le script crée (dossiers de cache, prefix
# extrait) appartient à root — Wine refuse ensuite un WINEPREFIX qui ne lui
# appartient pas ("... is not owned by you", confirmé en direct). Rend le
# chemin à TARGET_USER ; no-op hors sudo.
chown_to_target() {
    drops_to_target_user || return 0
    [[ -e "$1" ]] || return 0
    # Jamais à travers un montage FUSE (overlay encore monté d'une session
    # précédente...) : chaque chown y déclenche un copy-up du fichier.
    mountpoint -q "$1" 2>/dev/null && return 0
    find "$1" -xdev ! -user "$TARGET_USER" -print0 2>/dev/null \
        | xargs -0r chown -h "${TARGET_USER}:${TARGET_USER}" 2>/dev/null || true
}

# ════════════════════════════════════════════════════════════════════════
# 2. UTILITAIRES
# ════════════════════════════════════════════════════════════════════════

# Erreurs et avertissements vont sur la sortie d'erreur : un frontend qui
# n'enregistre que la sortie standard garde un journal propre, et un script
# qui appelle le lanceur peut les séparer du reste.

# die <message> [lignes de détail...] : affiche l'erreur et quitte (code 1).
die() {
    {
        echo "Erreur : $1"
        shift
        (($#)) && printf '%s\n' "$@"
    } >&2
    exit 1
}

# warn <message> [lignes de détail...]
warn() {
    {
        echo "Attention : $1"
        shift
        (($#)) && printf '%s\n' "$@"
    } >&2
    return 0
}

# usage_error <syntaxe> : rappel de syntaxe d'une commande, puis code 1.
usage_error() {
    echo "Usage : $*" >&2
    exit 1
}

# confirm <question> : vrai si l'utilisateur répond oui (o/y).
confirm() {
    local reply
    read -r -p "$1 [o/N] " reply
    [[ "${reply,,}" == o* || "${reply,,}" == y* ]]
}

# Échappe une chaîne pour un motif grep -E.
regex_escape() {
    # shellcheck disable=SC2016  # $ littéral dans la classe de caractères
    printf '%s' "$1" | sed 's/[][\.*^$(){}?+|/]/\\&/g'
}

# Retire une paire de guillemets entourant une valeur de chemin de
# l'autorun.cmd (DIR="Mon Jeu/Bin/", 27/09 : Kingdom Hearts III). Le format
# Batocera n'en met pas — les espaces passent tels quels —, mais le réflexe
# est naturel. CMD n'est pas concerné : c'est une ligne de commande, ses
# guillemets sont interprétés normalement.
unquote() {
    local v="$1"
    if [[ ${#v} -ge 2 && ( ( "${v:0:1}" == '"' && "${v: -1}" == '"' ) || ( "${v:0:1}" == "'" && "${v: -1}" == "'" ) ) ]]; then
        v="${v:1:${#v}-2}"
    fi
    echo "$v"
}

# Racine d'installation d'un binaire Wine (…/bin/wine → …), liens résolus.
runner_root() {
    dirname "$(dirname "$(readlink -f "$1")")"
}

# Nom lisible du runner d'un binaire Wine, pour les messages :
# …/wine-tkg/bin/wine → wine-tkg, …/GE-Proton9-1/files/bin/wine →
# GE-Proton9-1, wine du PATH → « Wine système ». Un binaire posé dans un
# dossier système (/usr/local/bin/proton) est nommé avec son chemin.
runner_name() {
    local bin="$1" root=""
    if [[ -z "$bin" ]]; then
        echo "aucun Wine"
        return
    fi
    if [[ "$bin" == "$(command -v wine 2>/dev/null)" ]]; then
        echo "Wine système"
        return
    fi
    case "$bin" in
        */files/bin/*) root="${bin%/files/bin/*}" ;;
        */bin/*)       root="${bin%/bin/*}" ;;
    esac
    case "$(basename "${root:-/}")" in
        /|usr|local|opt) echo "$(basename "$bin") (${bin})" ;;
        *)               basename "$root" ;;
    esac
}

# Version d'un runner : fichier version d'un Proton ("<horodatage>
# GE-Proton9-1" → GE-Proton9-1), sinon wine --version. Vide si inconnue.
runner_version() {
    local bin="$1"
    if [[ "$bin" == */files/bin/wine && -f "${bin%/files/bin/wine}/version" ]]; then
        awk '{print $NF; exit}' "${bin%/files/bin/wine}/version" 2>/dev/null
        return
    fi
    # Seulement un vrai binaire wine : un script proton ne connaît pas --version.
    [[ "$(basename "$bin")" == wine* && -x "$bin" ]] || return 0
    timeout 10 "$bin" --version 2>/dev/null | head -1
}

# Vrai si l'interpréteur ELF du binaire est présent : wine est souvent un
# stub 32 bits qui requiert /lib/ld-linux.so.2, absent des systèmes 64 bits
# purs.
elf_interpreter_present() {
    local interp
    interp=$(readelf -l "$1" 2>/dev/null | grep 'interpreter' \
             | sed 's/.*interpreter: \(.*\)\]/\1/')
    [[ -z "$interp" || -x "$interp" ]]
}

# split_command_line <ligne> : découpe des arguments à la manière de Windows,
# un par ligne terminée par NUL (pour mapfile -d ''). Les guillemets
# regroupent et sont retirés ("C:\Mon Jeu" → un argument), les antislashs
# restent tels quels, "" donne un argument vide. Jusqu'au 13/10, les
# arguments étaient découpés aux espaces, guillemets compris.
split_command_line() {
    local line="$1" arg="" c i in_quotes=false has_arg=false
    for ((i = 0; i < ${#line}; i++)); do
        c="${line:i:1}"
        if [[ "$c" == '"' ]]; then
            [[ "$in_quotes" == true ]] && in_quotes=false || in_quotes=true
            has_arg=true
        elif [[ "$c" == [[:space:]] && "$in_quotes" == false ]]; then
            [[ "$has_arg" == true ]] && printf '%s\0' "$arg"
            arg="" has_arg=false
        else
            arg+="$c"
            has_arg=true
        fi
    done
    [[ "$has_arg" == true ]] && printf '%s\0' "$arg"
    return 0
}

# Longueur en caractères d'un texte UTF-8, quelle que soit la locale (un
# frontend peut lancer en LANG=C, où ${#texte} compte les octets) : les
# octets de continuation (0x80-0xBF) ne sont pas comptés.
text_width() {
    local stripped
    # shellcheck disable=SC2030,SC2031  # LC_ALL=C limité au sous-shell, voulu
    stripped=$(LC_ALL=C; printf '%s' "${1//[$'\x80'-$'\xbf']/}")
    echo "${#stripped}"
}

# pad <texte> <largeur> : texte complété d'espaces jusqu'à la largeur.
pad() {
    local n=$(( $2 - $(text_width "$1") ))
    ((n < 1)) && n=1
    printf '%s%*s' "$1" "$n" ''
}

# Ajoute une règle à WINEDLLOVERRIDES (séparateur ;).
add_dll_override() {
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+${WINEDLLOVERRIDES};}$1"
}

# Résout <base>/<rel> sans tenir compte de la casse (comme Windows/Wine).
# Affiche le chemin réel, retour 1 si un composant est introuvable.
resolve_ci() {
    local cur="$1" part match entry name
    local -a parts
    IFS='/' read -ra parts <<< "$2"
    for part in "${parts[@]}"; do
        [[ -z "$part" || "$part" == "." ]] && continue
        if [[ -e "${cur}/${part}" ]]; then
            cur="${cur}/${part}"
            continue
        fi
        match=""
        for entry in "$cur"/* "$cur"/.[!.]*; do
            name="${entry##*/}"
            if [[ "${name,,}" == "${part,,}" ]]; then match="$entry"; break; fi
        done
        [[ -n "$match" ]] || return 1
        cur="$match"
    done
    echo "$cur"
}

# ════════════════════════════════════════════════════════════════════════
# 3. LECTURE DE L'AUTORUN.CMD
# ════════════════════════════════════════════════════════════════════════

# Surcharge de l'autorun (04/10, wsquashfs-manager) : <jeu>.wsquashfs.autorun
# à côté de l'image, même format que l'autorun.cmd. Une clé qui y figure
# l'emporte sur celle de l'image (CLÉ= vide : retour au défaut du lanceur) ;
# les autres clés viennent de l'image. Sert à essayer un réglage tout de
# suite, avant de l'inscrire dans l'image — Batocera ne lit pas ce fichier.
#
# override_var <fichier> <clé> : affiche la valeur, retour 1 si la clé (ou
# le fichier) est absente.
override_var() {
    local file="$1" key="$2"
    [[ -n "$file" && -f "$file" ]] || return 1
    grep -q "^${key}=" "$file" || return 1
    grep "^${key}=" "$file" | sed "s/^${key}=//" | head -1 | tr -d '\r'
}

# Clés présentes dans un fichier de surcharge, séparées par des espaces.
override_keys() {
    grep -o '^[A-Za-z_][A-Za-z0-9_]*=' "$1" | tr -d '=' | paste -sd ' '
}

# autorun_var <clé> <défaut> : valeur d'une clé de l'autorun.cmd du prefix
# monté, surcharge comprise ; le défaut si elle est absente ou vide.
autorun_var() {
    local key="$1" default="$2" val
    if val=$(override_var "${AUTORUN_OVERRIDE:-}" "$key"); then
        echo "${val:-$default}"
        return
    fi
    if [[ -e "${WINEPOINT}/autorun.cmd" ]]; then
        val=$(grep "^${key}=" "${WINEPOINT}/autorun.cmd" | sed "s/^${key}=//" | head -1 | tr -d '\r')
        echo "${val:-$default}"
    else
        echo "$default"
    fi
}

# Version du jeu packagé : GAME_VERSION= de l'autorun.cmd (29/09). Batocera
# ne lit que les clés qu'il connaît (grep "^CLE=" dans batocera-wine), une
# clé en plus y est ignorée — l'image reste compatible. Lue dans l'image
# même (unsquashfs -cat, sans montage : une modification de l'autorun.cmd
# restée dans les sauvegardes ne compte pas) ou dans un dossier installé.
game_version() {
    local v
    if v=$(override_var "${1%/}.autorun" GAME_VERSION); then
        unquote "$v"
        return
    fi
    if [[ -d "$1" ]]; then
        v=$(grep -m1 '^GAME_VERSION=' "${1}/autorun.cmd" 2>/dev/null)
    else
        v=$(unsquashfs -cat "$1" autorun.cmd 2>/dev/null | grep -m1 '^GAME_VERSION=')
    fi
    v="${v#GAME_VERSION=}"
    unquote "${v%$'\r'}"
}

# ════════════════════════════════════════════════════════════════════════
# 4. MONTAGES FUSE ET CACHE
# ════════════════════════════════════════════════════════════════════════

fuse_umount() {
    fusermount -u "$1" 2>/dev/null || fusermount3 -u "$1" 2>/dev/null || umount "$1" 2>/dev/null
}

do_umount() {
    fuse_umount "$1" || true
}

# Démontage de fin de partie : juste après wineserver -k, les processus du jeu
# tiennent encore des fichiers ouverts quelques instants ("busy") — un seul
# essai laissait le montage en place (confirmé en campagne de test). Quelques
# essais, puis démontage différé en dernier recours, comme safe_umount() de
# batocera-wine (umount -l).
umount_retry() {
    local i
    for ((i = 0; i < 5; i++)); do
        mountpoint -q "$1" 2>/dev/null || return 0
        fuse_umount "$1"
        mountpoint -q "$1" 2>/dev/null || return 0
        sleep 1
    done
    fusermount3 -uz "$1" 2>/dev/null || fusermount -uz "$1" 2>/dev/null || umount -l "$1" 2>/dev/null || true
}

# mount_squashfs <image> <point> : montage squashfuse (allow_other en root).
mount_squashfs() {
    without_lock squashfuse ${ALLOW_OTHER_OPT:+-o "$ALLOW_OTHER_OPT"} "$1" "$2" 2>/dev/null
}

# Monte l'overlay du jeu : image (lowerdir) + sauvegardes (upperdir).
# Note : redirect_dir=on cause des ESTALE sur les chemins imbriqués lors des
# remontages successifs (bug fuse-overlayfs) : option jamais utilisée.
mount_overlay() {
    without_lock fuse-overlayfs \
        -o "lowerdir=${SQUASHFSPOINT},upperdir=${SAVEPOINT},workdir=${WORKPOINT},${OVERLAY_SQUASH_OPT}${ALLOW_OTHER_OPT:+,$ALLOW_OTHER_OPT}" \
        "$WINEPOINT" 2>/dev/null
}

# Vide le workdir. L'overlay du noyau y laisse work/ en mode 000 (17/10) :
# rm -rf seul échouait dessus, et fuse-overlayfs refusait ensuite le
# workdir non vide.
reset_workdir() {
    chmod -R u+rwx "$1" 2>/dev/null
    rm -rf "$1" && mkdir -p "$1"
}

# Remonte l'overlay : il garde sa vue des dossiers en mémoire et ne voit
# pas ce qui est modifié directement dans l'upperdir (SAVEPOINT).
reload_overlay() {
    if [[ "$OVERLAY_KIND" == "kernel" ]]; then
        umount "$WINEPOINT" 2>/dev/null || umount -l "$WINEPOINT" 2>/dev/null
        mount_kernel_overlay_layer || die "échec du rechargement de l'overlay ${1}"
        return 0
    fi
    do_umount "$WINEPOINT"
    reset_workdir "$WORKPOINT"
    chown_to_target "$WORKPOINT"
    mount_overlay || die "échec du rechargement de l'overlay ${1}"
}

# ── Overlay noyau dans un namespace utilisateur (17/10) ────────────────
#
# Depuis Linux 5.11, un utilisateur peut monter l'overlay du noyau dans son
# propre namespace utilisateur. Une seule couche FUSE (squashfuse) au lieu
# de deux : chaque lecture du jeu traversait squashfuse PUIS fuse-overlayfs,
# et les sauvegardes s'écrivent à la vitesse du disque.
# Le lanceur prépare les dossiers sur l'hôte, puis se relance dans un
# namespace (unshare --map-current-user --mount --keep-caps) : même UID,
# avec les capacités du namespace pour monter. Il y monte l'image
# (squashfuse_ll -o uid=,gid= : tous les fichiers à l'utilisateur, rôle de
# squash_to_uid, qu'ils soient à root comme dans les paquets Batocera ou à
# un autre UID comme dans les images faites par --pack — sans cela, un UID
# de l'image absent du namespace bloquait toute écriture dans ses
# fichiers : EOVERFLOW), puis l'overlay, et lance le jeu. Wine tourne sans
# ces capacités (as_wine_user).
# Les montages sont invisibles hors du namespace et disparaissent avec lui :
# rien d'orphelin après un plantage (squashfuse meurt avec le lanceur).
# Mesuré (17/10, Tempest Rising, image en cache, 8 lectures aléatoires de
# 64K en parallèle) : 0,55 s contre 2,8 s avec squashfuse + fuse-overlayfs.
# En lecture séquentielle, squashfuse_ll multithread plafonne à 1,5 Go/s
# (3,7 Go/s avant) ; -s (un seul thread) donne 4,4 Go/s mais perd tout le
# gain en parallèle, le cas des chargements des jeux récents.
# Essayé à chaque lancement, sans mémoire : tout échec (namespaces refusés,
# conteneur sans seccomp ouvert, squashfuse trop ancien, sauvegardes sur un
# système de fichiers sans xattr user ou sur un overlay, /dev/fuse absent)
# retombe sur fuse-overlayfs. WSQUASHFS_OVERLAY=fuse l'impose, =kernel
# interdit le repli.

# Raison pour laquelle l'overlay noyau ne peut pas être essayé (vrai), ou
# rien (faux) : prérequis vérifiables sans rien monter.
kernel_overlay_unavailable() {
    local tool major minor
    if [[ "$OVERLAY_PREF" == "fuse" ]]; then
        echo "WSQUASHFS_OVERLAY=fuse"
        return 0
    fi
    # Lancé en root (sudo), Wine est relancé en TARGET_USER ; et l'option
    # uid=0 de squashfuse_ll est ignorée.
    if [[ "$RUN_AS_ROOT" == true ]]; then
        echo "lancé en root"
        return 0
    fi
    for tool in unshare setpriv squashfuse_ll mount umount mountpoint getfattr setfattr; do
        if ! command -v "$tool" &>/dev/null; then
            echo "${tool} absent"
            return 0
        fi
    done
    # Options uid/gid : squashfuse 0.5 (Debian 13, Arch), absentes de 0.1
    # (Debian 12).
    if ! squashfuse_ll -h 2>&1 | grep -q 'uid=N'; then
        echo "squashfuse_ll sans option uid= (squashfuse 0.5 requis)"
        return 0
    fi
    if ! unshare --help 2>/dev/null | grep -q -- '--map-current-user'; then
        echo "unshare trop ancien (util-linux 2.38 requis)"
        return 0
    fi
    IFS=. read -r major minor _ <<< "$(uname -r)"
    minor="${minor%%[!0-9]*}"
    if ((major < 5 || (major == 5 && ${minor:-0} < 11))); then
        echo "noyau $(uname -r) (5.11 requis)"
        return 0
    fi
    if [[ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" == "0" \
          || "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)" == "0" ]]; then
        echo "namespaces utilisateur désactivés (sysctl)"
        return 0
    fi
    if [[ ! -r /dev/fuse || ! -w /dev/fuse ]]; then
        echo "/dev/fuse inaccessible"
        return 0
    fi
    return 1
}

# unshare du lancement en namespace.
ns_unshare() {
    unshare --user --map-current-user --mount --keep-caps -- "$@"
}

# --doctor : monte un overlay noyau de test à côté des sauvegardes (le
# système de fichiers de l'upperdir compte). Cause de l'échec sur la
# sortie standard.
kernel_overlay_probe() {
    local dir="$SAVES_DIR" tmp err rc
    while [[ ! -d "$dir" ]]; do dir=$(dirname "$dir"); done
    tmp=$(mktemp -d "${dir}/.wsquashfs-probe.XXXXXX" 2>/dev/null) || { echo "${dir} : écriture impossible"; return 1; }
    # shellcheck disable=SC2016  # développé par le shell du namespace
    err=$(ns_unshare sh -c \
        'cd "$1" && mkdir l u w m && mount -t overlay overlay -o lowerdir=l,upperdir=u,workdir=w,userxattr m' \
        _ "$tmp" 2>&1)
    rc=$?
    reset_workdir "$tmp"
    rmdir "$tmp"
    ((rc == 0)) && return 0
    echo "${err##*: }" | head -1
    return 1
}

# Sauvegardes écrites par fuse-overlayfs → format de l'overlay noyau, avant
# chaque montage noyau (17/10). fuse-overlayfs lit les deux formats, le
# noyau seulement le sien : sans conversion, un dossier supprimé par le jeu
# réapparaissait avec le contenu de l'image, et .wh..wh..opq devenait un
# fichier visible.
#   - dossier opaque : fichier .wh..wh..opq ou user.fuseoverlayfs.opaque
#     → user.overlay.opaque=y ;
#   - fichier supprimé : .wh.<nom> (fuse-overlayfs sans mknod) → <nom>,
#     périphérique caractère 0/0 (créable sans privilège depuis Linux 5.8).
# Faux si une conversion échoue : l'overlay noyau n'est pas essayé.
saves_to_kernel_format() {
    local upper="$1" f d name
    while IFS= read -r -d '' f; do
        setfattr -n user.overlay.opaque -v y "${f%/*}" || return 1
        rm -f -- "$f"
    done < <(find "$upper" -xdev -type f -name .wh..wh..opq -print0 2>/dev/null)
    while IFS= read -r d; do
        printf -v d '%b' "$d"    # getfattr échappe les noms (\134, \303\251...)
        setfattr -n user.overlay.opaque -v y "$d" || return 1
    done < <(getfattr -R -h --absolute-names -n user.fuseoverlayfs.opaque -- "$upper" 2>/dev/null \
                 | sed -n 's/^# file: //p')
    while IFS= read -r -d '' f; do
        d="${f%/*}" name="${f##*/.wh.}"
        if [[ ! -e "${d}/${name}" && ! -L "${d}/${name}" ]]; then
            mknod "${d}/${name}" c 0 0 || return 1
        fi
        rm -f -- "$f"
    done < <(find "$upper" -xdev -type f -name '.wh.*' ! -name '.wh..wh..*' -print0 2>/dev/null)
}

# Hôte : relance le lanceur dans un namespace (overlay noyau). Ne revient
# pas si le jeu y a été lancé ; revient pour le repli sur fuse-overlayfs.
run_in_kernel_overlay() {
    local reason status rc
    # --mount : le montage doit survivre au lanceur.
    [[ "$ACTION" == "mount" ]] && return 0
    if reason=$(kernel_overlay_unavailable); then
        [[ "$OVERLAY_PREF" == "kernel" ]] && die "overlay noyau impossible : ${reason}"
        [[ "$OVERLAY_PREF" == "fuse" ]] || echo "Overlay noyau : indisponible, ${reason}"
        return 0
    fi
    # Essai à vide (quelques ms) : un refus (conteneur sans seccomp ouvert,
    # AppArmor) donne sa cause sans message d'unshare à chaque lancement.
    if ! reason=$(ns_unshare true 2>&1); then
        reason="namespace utilisateur refusé (${reason##*: })"
    elif ! saves_to_kernel_format "$SAVEPOINT"; then
        reason="conversion des sauvegardes impossible"
    else
        # Dossier d'échange nommé par le PID : statut du montage, et liens
        # sans virgule ni deux-points (noms de jeux) pour les options de
        # l'overlay.
        NS_DIR="${CACHE_DIR}/ns/$$"
        reset_workdir "$NS_DIR"
        printf '%s\n' "$GAME_NAME" > "${NS_DIR}/game"
        ln -s "$SQUASHFSPOINT" "${NS_DIR}/lower"
        ln -s "$SAVEPOINT" "${NS_DIR}/upper"
        ln -s "$WORKPOINT" "${NS_DIR}/work"
        # En tâche de fond : un SIGTERM au lanceur (frontend qui arrête le
        # jeu) est traité tout de suite et transmis (cleanup). <&0 : sans
        # lui, une tâche de fond lit /dev/null. unshare appelé directement,
        # pas par ns_unshare : NS_PID serait le sous-shell de la fonction, et
        # le SIGTERM n'atteindrait pas le lanceur du namespace.
        WSQUASHFS_NS_STAGE=1 WSQUASHFS_NS_DIR="$NS_DIR" \
            unshare --user --map-current-user --mount --keep-caps -- "$BASH" "$SELF" "${ORIG_ARGS[@]}" <&0 &
        NS_PID=$!
        wait "$NS_PID"
        rc=$?
        NS_PID=""
        status=$(cat "${NS_DIR}/status" 2>/dev/null)
        rm -rf "$NS_DIR"
        NS_DIR=""
        [[ "$status" == "ready" ]] && exit "$rc"
        reason="${status:-namespace utilisateur refusé}"
    fi
    [[ "$OVERLAY_PREF" == "kernel" ]] && die "overlay noyau impossible : ${reason}"
    echo "Overlay noyau : échec, ${reason}"
}

# Monte l'overlay noyau, chemins relatifs au dossier d'échange.
mount_kernel_overlay_layer() {
    (
        cd "$NS_DIR" || exit 1
        mount -t overlay overlay -o lowerdir=lower,upperdir=upper,workdir=work,userxattr,redirect_dir=off \
            "$WINEPOINT"
    )
}

# Dans le namespace : monte l'image puis l'overlay. Statut pour le lanceur
# de l'hôte (run_in_kernel_overlay) dans NS_DIR/status : « ready », ou la
# cause de l'échec, après quoi il se replie sur fuse-overlayfs.
use_kernel_overlay() {
    local i err
    # --pdeathsig : squashfuse meurt avec le lanceur, même tué par SIGKILL ;
    # il libère alors le verrou hérité (sans without_lock, dont le
    # sous-shell deviendrait son parent).
    setpriv --pdeathsig KILL \
        squashfuse_ll -f -o "uid=${WINE_UID},gid=${WINE_GID}" "$WSQUASHFS_FILE" "$SQUASHFSPOINT" 2>/dev/null &
    for ((i = 0; i < 100; i++)); do
        mountpoint -q "$SQUASHFSPOINT" && break
        kill -0 "$!" 2>/dev/null || break
        sleep 0.1
    done
    # Vérifié avant l'overlay : sans /dev/fuse, l'overlay se montait sur le
    # dossier vide et le jeu restait introuvable.
    if ! mountpoint -q "$SQUASHFSPOINT"; then
        echo "squashfuse_ll impossible dans le namespace" > "${NS_DIR}/status"
        exit 1
    fi
    if ! err=$(mount_kernel_overlay_layer 2>&1); then
        echo "overlay refusé (${err##*: })" > "${NS_DIR}/status"
        exit 1
    fi
    echo ready > "${NS_DIR}/status"
    MOUNT_MODE="overlay"
    OVERLAY_KIND="kernel"
    MOUNTED=true
    detect_image_prefix
    echo "Mode          : overlay noyau (squashfuse + overlayfs, namespace utilisateur)"
}

# Lanceur en namespace d'un jeu (PID), pour --umount : ses montages sont
# invisibles d'ici, et son wineserver injoignable (socket lié au prefix vu
# dans le namespace).
ns_launcher_pid() {
    local f pid
    for f in "${CACHE_DIR}/ns"/*/game; do
        [[ -f "$f" && "$(< "$f")" == "$1" ]] || continue
        for pid in $(pgrep -f -- "$SELF" 2>/dev/null); do
            grep -qszxF "WSQUASHFS_NS_DIR=${f%/game}" "/proc/${pid}/environ" \
                && grep -qszxF 'WSQUASHFS_NS_STAGE=1' "/proc/${pid}/environ" \
                && { echo "$pid"; return 0; }
        done
    done
    return 1
}

# Vrai si un processus tourne dans le prefix dont le chemin correspond au
# motif (grep -E) : WINEPREFIX est hérité par Wine, Proton, umu et son
# runtime, avec ou sans sous-dossier (Proton : …/pfx/).
prefix_in_use() {
    grep -qszE "^WINEPREFIX=${1}(/.*)?$" /proc/[0-9]*/environ 2>/dev/null
}

# Motif (grep -E) du dossier des prefixes de jeux : CACHE_DIR/wine tel quel
# et liens résolus (WINEPREFIX garde le chemin tel qu'il a été donné), plus
# …/wsquashfs/wine, le dossier par défaut, pour un jeu lancé par un autre
# utilisateur ou avec un autre CACHE_DIR. Seul ce dernier était reconnu
# jusqu'au 13/10 : avec WSQUASHFS_CACHE ailleurs, aucun jeu n'était vu en
# cours — un autre lancement le démontait, --clean effaçait son cache.
games_prefix_regex() {
    local raw real
    raw=$(regex_escape "$CACHE_DIR")
    real=$(regex_escape "$(readlink -f "$CACHE_DIR" 2>/dev/null || echo "$CACHE_DIR")")
    echo "(${raw}|${real}|.*/wsquashfs)/wine"
}

# Vrai si un processus tourne dans le prefix de ce jeu.
game_in_use() {
    prefix_in_use "$(games_prefix_regex)/$(regex_escape "$1")"
}

# Vrai si le jeu tourne ou si un autre lancement de ce jeu est en cours de
# préparation (verrou tenu, Wine pas encore démarré).
game_running() {
    game_in_use "$1" || game_locked "$1"
}

# Vrai si le jeu est monté ou en cours : ses sauvegardes sont l'upperdir
# actif de l'overlay, on n'y touche pas.
saves_busy() {
    game_running "$1" || mountpoint -q "${CACHE_DIR}/wine/${1}" 2>/dev/null
}

# ── Verrou par jeu ─────────────────────────────────────────────────────
#
# Un lancement prend le verrou CACHE_DIR/locks/<jeu>.lock (flock) avant de
# monter quoi que ce soit (13/10) : game_in_use ne voit un jeu qu'une fois
# Wine démarré, deux lancements rapprochés (double clic dans un frontend)
# passaient tous les deux et montaient le même overlay. Le verrou suit le
# descripteur : libéré à la fin du script et de Wine (qui en hérite, la
# partie reste protégée si le lanceur est tué), jamais transmis aux démons
# FUSE (without_lock) — un montage oublié bloquerait sinon le jeu.
# Sans flock ou sans fichier de verrou lisible : pas de verrou, jamais
# bloquant.

lock_file() {
    echo "${CACHE_DIR}/locks/${1}.lock"
}

# Prend le verrou de GAME_NAME ; faux s'il est déjà tenu.
acquire_game_lock() {
    local file
    command -v flock &>/dev/null || return 0
    file=$(lock_file "$GAME_NAME")
    mkdir -p "${CACHE_DIR}/locks" 2>/dev/null
    chown_to_target "${CACHE_DIR}/locks"
    : >> "$file" 2>/dev/null
    # Lecture seule : un verrou créé par un autre utilisateur (sudo) reste
    # utilisable, flock n'a pas besoin d'écrire.
    [[ -r "$file" ]] || return 0
    exec {LOCK_FD}< "$file"
    flock -n "$LOCK_FD" || return 1
    LOCKED_GAME="$GAME_NAME"
}

# Vrai si un AUTRE lancement tient le verrou de ce jeu.
game_locked() {
    local file
    [[ "$1" != "$LOCKED_GAME" ]] || return 1
    command -v flock &>/dev/null || return 1
    file=$(lock_file "$1")
    [[ -r "$file" ]] || return 1
    ! flock -n "$file" true 2>/dev/null
}

# Exécute une commande sans lui transmettre le descripteur du verrou (démons
# qui survivent au script).
without_lock() {
    if [[ -n "$LOCK_FD" ]]; then
        "$@" {LOCK_FD}>&-
    else
        "$@"
    fi
}

# Balaie TOUS les montages wsquashfs abandonnés sous CACHE_DIR, pas seulement
# celui du jeu qu'on lance — un jeu qui plante ou qu'on ferme brutalement
# (SIGKILL, déconnexion Moonlight) ne passe jamais par cleanup() ; sans ce
# balayage, les montages orphelins s'accumulaient (10 montages fantômes
# après 10 jeux testés). Les jeux EN COURS sont épargnés (27/09) : les
# démonter coupait la partie dès qu'un autre jeu était lancé.
unmount_all_stale() {
    # mount(8) affiche le chemin CANONIQUE : CACHE_DIR peut passer par un lien
    # (ex. /home/arcade -> /config sur SteamBox), un grep sur le chemin brut
    # ne trouvait alors jamais rien (confirmé en direct).
    local real_cache_dir sub m
    real_cache_dir=$(readlink -f "$CACHE_DIR" 2>/dev/null || echo "$CACHE_DIR")
    for sub in wine mnt; do
        mount 2>/dev/null | grep -F "${real_cache_dir}/${sub}/" | sed -E 's/^[^ ]+ on (.*) type .*/\1/' \
            | while IFS= read -r m; do game_running "$(basename "$m")" || do_umount "$m"; done
    done
}

# --umount [jeu] : arrête le wineserver du jeu puis démonte son overlay et
# son squashfs.
umount_game() {
    local name="$1" pid i
    # Overlay noyau : le lanceur du jeu, dans son namespace, arrête Wine et
    # démonte (SIGTERM, voir cleanup).
    if pid=$(ns_launcher_pid "$name"); then
        kill -TERM "$pid" 2>/dev/null
        for ((i = 0; i < 30; i++)); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        echo "✓ Arrêté et démonté : ${name}"
        return 0
    fi
    [[ -d "${CACHE_DIR}/wine/${name}" ]] || return 0
    run_wineserver "${CACHE_DIR}/wine/${name}" -k || true
    umount_retry "${CACHE_DIR}/wine/${name}"
    umount_retry "${CACHE_DIR}/mnt/${name}"
    echo "✓ Démonté : ${name}"
}

# Identité de l'image (chemin, taille, date) : valide la copie en cache.
image_signature() {
    echo "${WSQUASHFS_FILE}:$(stat -c '%s:%Y' "$WSQUASHFS_FILE" 2>/dev/null)"
}

# Mode copy : extrait l'image dans WINEPOINT (squashfuse puis copie, ou
# unsquashfs).
extract_image() {
    if command -v squashfuse &>/dev/null && mount_squashfs "$WSQUASHFS_FILE" "$SQUASHFSPOINT"; then
        echo "Mode          : copy (squashfuse)"
        rm -rf -- "${WINEPOINT:?}"
        mkdir -p "$WINEPOINT"
        cp -a "$SQUASHFSPOINT/." "$WINEPOINT/"
        do_umount "$SQUASHFSPOINT"
    elif command -v unsquashfs &>/dev/null; then
        echo "Mode          : copy (unsquashfs)"
        rm -rf -- "${WINEPOINT:?}"
        unsquashfs -d "$WINEPOINT" "$WSQUASHFS_FILE" || die "échec de l'extraction unsquashfs"
    else
        die "FUSE bloqué et unsquashfs absent" \
            "  → Exposer /dev/fuse dans le conteneur : --device /dev/fuse" \
            "  → Ou installer squashfs-tools : apt-get install squashfs-tools"
    fi
    image_signature > "${WINEPOINT}/.wsquashfs_cache"
    # WINEPOINT est un vrai répertoire : extrait en root, Wine le refuserait.
    chown_to_target "$WINEPOINT"
}

# ════════════════════════════════════════════════════════════════════════
# 5. RUNNERS WINE / PROTON
# ════════════════════════════════════════════════════════════════════════

# Binaires bin/wine installés par notre installeur ou à la main, filtrés par
# grep -z <options> (ex. -i tkg).
installed_wines() {
    local d w
    for d in "$HOME/.local/share/wsquashfs/wine" "/opt"; do
        [[ -d "$d" ]] || continue
        while IFS= read -r -d '' w; do
            [[ -x "$w" ]] && echo "$w"
        done < <(find "$d" -maxdepth 3 -name "wine" -path "*/bin/wine" -print0 2>/dev/null \
            | grep -z "$@")
    done
}

# Wine par défaut (prefix non Proton : jeux arcade Batocera). Priorité
# (27/09) : wine-tkg → wine-ge/lutris → wine-proton → wine système. wine-tkg
# d'abord, comme le runner par défaut de Batocera : meilleure compatibilité
# avec les jeux arcade. Les prefixes créés par Proton (Heroic, Steam) ont
# leur propre choix de runner, voir find_proton_runner.
find_wine_binary() {
    local candidates=() c w
    mapfile -t candidates < <(
        echo "/usr/wine/wine-tkg/bin/wine"
        installed_wines -i 'tkg'
        echo "/usr/wine/ge-custom/bin/wine"
        installed_wines -iE '/(wine-ge|lutris-|wine-lutris)'
        echo "/usr/wine/wine-proton/bin/wine"
    )
    for c in "${candidates[@]}"; do
        [[ -x "$c" ]] || continue
        if elf_interpreter_present "$c"; then
            echo "$c"
            return
        fi
        # Repli : wine64 dans le même répertoire bin/
        w="${c%wine}wine64"
        if [[ -x "$w" ]] && elf_interpreter_present "$w"; then
            echo "$w"
            return
        fi
    done
    command -v wine
}

# Vrai si ce binaire Wine sait exécuter un prefix win32 (build classique avec
# i386-unix ; un build WoW64 seul n'a que x86_64-unix).
wine_supports_win32() {
    local root
    root=$(runner_root "$1")
    [[ -d "${root}/lib/wine/i386-unix" || -d "${root}/lib32/wine/i386-unix" ]]
}

# Premier Wine installé capable de lancer un prefix win32.
find_win32_wine() {
    local w
    while IFS= read -r -d '' w; do
        wine_supports_win32 "$w" && { echo "$w"; return 0; }
    done < <(find /usr/wine /opt "$HOME/.local/share/wsquashfs/wine" -maxdepth 3 \
                 -path '*/bin/wine' -print0 2>/dev/null)
    return 1
}

# Runners Proton installés hors de nos dossiers (27/09) : Heroic, Steam et
# paquets proton-cachyos/umu. Leur Wine est dans files/bin/wine. Un même
# dossier vu deux fois (~/.steam/root → ~/.local/share/Steam) n'est listé
# qu'une fois.
proton_runner_dirs() {
    local base d
    for base in "$HOME/.config/heroic/tools/proton" \
                "$HOME/.local/share/Steam/compatibilitytools.d" \
                "$HOME/.steam/root/compatibilitytools.d" \
                /usr/share/steam/compatibilitytools.d; do
        for d in "$base"/*; do
            [[ -x "${d}/files/bin/wine" ]] && readlink -f "$d"
        done
    done 2>/dev/null | awk '!seen[$0]++'
}

# Runners Wine/Proton installés, pour --wine : dossiers contenant bin/wine
# (Wine classique, Kron4ek...) ou files/bin/wine (Proton-GE).
list_wine_runners() {
    local d
    for d in /opt/* /usr/wine/* "$HOME/.local/share/wsquashfs/wine"/*; do
        [[ -x "${d}/bin/wine" || -x "${d}/files/bin/wine" ]] && echo "$d"
    done 2>/dev/null
    proton_runner_dirs
}

# umu-run (paquet umu-launcher), sinon celui installé par Heroic : lance un
# prefix Proton comme Heroic ou Steam, par le script proton complet dans le
# runtime Steam. WSQUASHFS_UMU=0 pour lancer Wine directement.
find_umu_run() {
    local u
    [[ "${WSQUASHFS_UMU:-1}" == "0" ]] && return 1
    for u in "$(command -v umu-run 2>/dev/null)" \
             "$HOME/.config/heroic/tools/runtimes/umu/umu_run.py"; do
        [[ -n "$u" && -x "$u" ]] && { echo "$u"; return 0; }
    done
    return 1
}

# Version de Proton qui a créé le prefix monté (1re ligne de config_info,
# écrite par le script proton : "GE-Proton11-5"), vide pour un prefix
# Batocera ou Wine simple.
prefix_proton_version() {
    [[ -f "${WINEPOINT}/config_info" ]] || return 0
    head -1 "${WINEPOINT}/config_info" 2>/dev/null | tr -d '\r'
}

# Vrai si le dossier de runner Proton correspond à cette version : même nom
# de dossier ou même version (fichier version : "<horodatage> GE-Proton11-5",
# Heroic installe sous GE-Proton-latest).
proton_runner_is() {
    [[ "$(basename "$1")" == "$2" ]] || \
    [[ "$(awk '{print $NF}' "${1}/version" 2>/dev/null)" == "$2" ]]
}

# Dossier du runner Proton pour une version voulue, sinon le plus récent des
# proton-cachyos, puis UMU-Proton, puis GE-Proton, puis n'importe quel
# Proton : un prefix Proton ne doit pas retomber sur le Wine système (27/09,
# Kingdom Hearts III, prefix Heroic GE-Proton11-5 : écran noir sous
# wine-staging). proton-cachyos puis UMU-Proton d'abord (30/09) : leur SDL
# gère la DualSense en XInput avec la vibration (evdev, hid-playstation) ;
# GE la force en hidraw et sa conversion XInput ne transmet pas la vibration.
# proton-cachyos exige une pile limitée (voir limit_stack_size).
find_proton_runner() {
    local want="$1" d dirs
    dirs=$(proton_runner_dirs)
    [[ -n "$dirs" ]] || return 1
    if [[ -n "$want" ]]; then
        while IFS= read -r d; do
            proton_runner_is "$d" "$want" && { echo "$d"; return 0; }
        done <<< "$dirs"
    fi
    d=$(grep -i 'proton-cachyos' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(grep -i '/UMU-Proton' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(grep -i '/GE-Proton' <<< "$dirs" | sort -V | tail -1)
    [[ -n "$d" ]] || d=$(head -1 <<< "$dirs")
    echo "$d"
}

# --wine <version|chemin> : binaire wine explicite, dossier de runner, nom
# exact ou partiel d'un runner installé (ex. "win32", "GE-Proton9"), ou
# "system" pour le wine du système.
resolve_wine_override() {
    local want="$1" d
    if [[ "$want" == "system" ]]; then command -v wine; return; fi
    if [[ -f "$want" && -x "$want" ]]; then echo "$want"; return; fi
    for d in "$want" $(list_wine_runners | grep -F -- "$want"); do
        [[ -x "${d}/bin/wine" ]] && { echo "${d}/bin/wine"; return; }
        [[ -x "${d}/files/bin/wine" ]] && { echo "${d}/files/bin/wine"; return; }
    done
    return 1
}

# Dossier Proton d'un binaire …/files/bin/wine accompagné du script proton,
# retour 1 sinon.
proton_dir_of() {
    [[ "$1" == */files/bin/wine && -x "${1%/files/bin/wine}/proton" ]] || return 1
    echo "${1%/files/bin/wine}"
}

# ════════════════════════════════════════════════════════════════════════
# 6. PRÉPARATION DU PREFIX
# ════════════════════════════════════════════════════════════════════════

# ── Commandes Wine sur le prefix ───────────────────────────────────────

# run_wineserver <prefix> <options> : wineserver de ce prefix, lancé en
# utilisateur Wine — chaque UID a son propre socket (/tmp/.wine-<uid>), root
# ne joindrait pas celui de TARGET_USER.
# wineserver du runner (17/10) : celui du PATH (Wine système) ne joint pas
# le serveur d'une autre version, et manque quand seuls des runners sont
# installés — -w n'attendait rien, -k n'arrêtait rien, et le prefix restait
# occupé au démontage. Runner pas encore choisi (--umount) : celui du PATH.
run_wineserver() {
    local prefix="$1" server=wineserver
    shift
    if [[ -n "$WINE_BINARY" && -x "$(dirname "$WINE_BINARY")/wineserver" ]]; then
        server="$(dirname "$WINE_BINARY")/wineserver"
    fi
    as_wine_user env WINEPREFIX="$prefix" "$server" "$@" 2>/dev/null
}

# run_wineboot_update <WINEDEBUG> : crée ou met à jour le prefix.
run_wineboot_update() {
    as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
        WINEDEBUG="$1" WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d" \
        "$WINE_BINARY" wineboot -u
}

# run_wine_tool <outil> [arguments] : outil Wine (regedit, reg) sur le
# prefix, par umu pour un prefix Proton (voir WINE_TOOL).
run_wine_tool() {
    as_wine_user env DISPLAY="${DISPLAY:-}" WINEPREFIX="$WINEPOINT" WINEARCH="$WINE_ARCH" \
        WINEDEBUG="$WINEDEBUG" WINEDLLOVERRIDES="$WINEDLLOVERRIDES" \
        GAMEID="${GAMEID:-}" PROTONPATH="${PROTONPATH:-}" \
        "${WINE_TOOL[@]}" "$@"
}

# Arrêt propre du wineserver — séquence Batocera : kill → wait → kill -9.
# En utilisateur Wine : sinon l'overlay était démonté sous un wineserver
# encore vivant, qui perdait le registre ("could not save registry branch
# to system.reg").
stop_wineserver() {
    local i=0 pids=()
    run_wineserver "$WINEPOINT" -k || true
    while (( i++ < 10 )); do
        run_wineserver "$WINEPOINT" -w && return 0
        sleep 1
    done
    # Kill forcé si wineserver s'accroche encore
    mapfile -t pids < <(pgrep -f "WINEPREFIX=${WINEPOINT}" 2>/dev/null)
    if ((${#pids[@]})); then
        kill -9 "${pids[@]}" 2>/dev/null || true
    fi
}

# ── Détection ──────────────────────────────────────────────────────────

# Architecture réelle du prefix (comme setPrefixArch de Batocera). Format :
# ligne "#arch=win32" en tête de system.reg/userdef.reg — l'ancien motif
# '"#arch"="win32"' ne correspondait jamais (tout prefix vu en win64).
detect_prefix_arch() {
    if grep -qs '^#arch=win32' "${WINEPOINT}/system.reg" "${WINEPOINT}/userdef.reg"; then
        echo "win32"
    else
        echo "win64"
    fi
}

# Nom d'utilisateur Wine du prefix (profils packagés par Batocera, ex.
# steamuser) : le premier trouvé hors comptes système.
detect_wine_username() {
    local users_dir="${WINEPOINT}/drive_c/users" d name
    [[ -d "$users_dir" ]] || return
    for d in "$users_dir"/*/; do
        name=$(basename "$d")
        case "$name" in
            Public|"All Users"|"Default User"|LocalService|NetworkService) continue ;;
        esac
        [[ -d "$d" ]] && echo "$name" && return
    done
}

# ── DLL du runner, DXVK, VKD3D, d7vk ───────────────────────────────────

# Relie (lien symbolique) les DLL Wine absentes du prefix (DLL de Wine 10+
# manquantes dans les vieux prefixes Batocera). Les DLL natives existantes
# (DXVK, d3dx9...) ne sont jamais écrasées. Aucune limite de taille : Wine
# 10+ a promu certaines DLL de stubs à implémentations complètes (ex.
# coml2.dll ~344 Ko), nécessaires même dans les vieux prefixes.
#
# sync_wine_stubs <wine> [racine cible] — racine où écrire : SAVEPOINT en
# overlay (fuse-overlayfs non privilégié ne peut pas faire de copy-up des
# dossiers root-owned system32/syswow64 : EPERM), WINEPOINT sinon.
sync_wine_stubs() {
    local wine_bin="$1" target_root="${2:-$WINEPOINT}" wine_root
    wine_root=$(runner_root "$wine_bin")
    local src_dirs=(
        "${wine_root}/lib/wine/x86_64-windows:system32"
        "${wine_root}/lib64/wine/x86_64-windows:system32"   # wine-ge/lutris met les DLL 64 bits ici
        "${wine_root}/lib/wine/i386-windows:syswow64"
        # chemins Debian/Ubuntu
        "/usr/lib/x86_64-linux-gnu/wine/x86_64-windows:system32"
        "/usr/lib/x86_64-linux-gnu/wine/i386-windows:syswow64"
        "/usr/lib/i386-linux-gnu/wine/i386-windows:syswow64"
    )
    local entry src_dir dst_subdir src name f
    for entry in "${src_dirs[@]}"; do
        src_dir="${entry%%:*}"
        dst_subdir="${entry##*:}"
        # Prefix win32 : system32 contient les DLL 32 bits, pas de syswow64
        if [[ "$WINE_ARCH" == "win32" ]]; then
            [[ "$dst_subdir" == "system32" ]] && continue
            dst_subdir=system32
        fi
        [[ -d "$src_dir" ]] || continue
        mkdir -p "${target_root}/drive_c/windows/${dst_subdir}" 2>/dev/null || true
        # DLL internes de Wine déjà dans le prefix (signature "Wine builtin
        # DLL" / "Wine placeholder DLL") : remplacées par celles du runner,
        # comme batocera-wine (27/09). Les prefixes Batocera en embarquent de
        # vraies copies d'un autre Wine (Virtua Tennis 4 : 619 dans
        # system32) — gardées, winex11.drv/explorer.exe d'un autre Wine avec
        # les bibliothèques de celui-ci donnaient "no driver could be
        # loaded". Seules les DLL natives (sans signature : d3dx9_42,
        # mscoree... de Microsoft) sont conservées.
        local -A wine_owned=()
        while IFS= read -r f; do
            wine_owned["$(basename "$f")"]=1
        done < <(grep -laE "Wine (builtin|placeholder) DLL" \
                     "${WINEPOINT}/drive_c/windows/${dst_subdir}"/* 2>/dev/null)
        # Tous les types de modules (.dll, .exe, .drv, .sys...) : explorer.exe
        # et winex11.drv n'étaient jamais reliés avec *.dll seul.
        for src in "$src_dir"/*; do
            [[ -f "$src" ]] || continue
            name=$(basename "$src")
            # -f est faux pour un lien cassé : il est alors remplacé.
            [[ -f "${WINEPOINT}/drive_c/windows/${dst_subdir}/${name}" && -z "${wine_owned[$name]:-}" ]] && continue
            # Lien symbolique, pas copie (25/09) : comme batocera-wine. La copie
            # recopiait ~1 660 DLL (~500 Mo) à CHAQUE lancement dans les
            # sauvegardes — 35 Go sur 41 Go de saves pour 140 jeux (mesuré).
            # ln -sfn remplace aussi un lien cassé (ex. vers /userdata/...).
            ln -sfn "$src" "${target_root}/drive_c/windows/${dst_subdir}/${name}" 2>/dev/null || true
        done
    done
}

# link_dll_set <dossier source> <sous-dossier 64> <sous-dossier 32>
#              <racine cible> <dll...>
# Relie <source>/<sous-dossier>/<dll>.dll dans system32 (64 bits) et
# syswow64 (32 bits) du prefix ; prefix win32 : 32 bits seulement, dans
# system32.
link_dll_set() {
    local src_dir="$1" dir64="$2" dir32="$3" target_root="$4"
    shift 4
    local pair arch sub dll
    for pair in "${dir64}:system32" "${dir32}:syswow64"; do
        arch="${pair%%:*}" sub="${pair##*:}"
        if [[ "$WINE_ARCH" == "win32" ]]; then
            [[ "$arch" == "$dir64" ]] && continue
            sub=system32
        fi
        mkdir -p "${target_root}/drive_c/windows/${sub}" 2>/dev/null || true
        for dll in "$@"; do
            [[ -f "${src_dir}/${arch}/${dll}.dll" ]] || continue
            ln -sfn "${src_dir}/${arch}/${dll}.dll" \
                "${target_root}/drive_c/windows/${sub}/${dll}.dll" 2>/dev/null || true
        done
    done
}

# Les prefixes Batocera n'embarquent pas DXVK : system32/syswow64 contiennent
# des liens vers /userdata/system/wine/dxvk/{x64,x32}/*.dll, un chemin qui
# n'existe que sous Batocera (247 jeux sur 247 dans une collection réelle).
# Liens cassés → Wine retombe sur son d3d9/d3d11 intégré (OpenGL), soit
# llvmpipe sous Xwayland+NVIDIA — Dead or Alive 5 Ultimate (segare) quittait
# aussitôt sans erreur.
find_dxvk_dir() {
    local d
    for d in "${WSQUASHFS_DXVK_DIR:-}" /usr/share/dxvk "$HOME/.local/share/wsquashfs/dxvk"; do
        [[ -n "$d" && -f "${d}/x64/dxgi.dll" ]] && echo "$d" && return
    done
}

# Comme dxvk_install() de batocera-wine : liens DXVK recréés à CHAQUE
# lancement, vers le DXVK local. À lancer APRÈS sync_wine_stubs, qui aurait
# sinon laissé la DLL intégrée de Wine.
install_dxvk() {
    local dxvk_dir
    dxvk_dir=$(find_dxvk_dir)
    [[ -n "$dxvk_dir" ]] || return 0
    link_dll_set "$dxvk_dir" x64 x32 "${1:-$WINEPOINT}" d3d8 d3d9 d3d10core d3d11 dxgi
}

# VKD3D-Proton (Direct3D 12 → Vulkan), relié comme DXVK (26/09) : avec le
# seul override d3d12=n,b, Wine chargeait son propre d3d12.dll, inutilisable
# ici, et tout jeu DX12 échouait (Pinball FX : "DX12 is not supported on
# your system"). Il faut la version Windows (paquet vkd3d-proton-mingw,
# /usr/share/vkd3d-proton/{x64,x86}), pas la bibliothèque Linux.
find_vkd3d_dir() {
    local d
    for d in "${WSQUASHFS_VKD3D_DIR:-}" /usr/share/vkd3d-proton "$HOME/.local/share/wsquashfs/vkd3d-proton"; do
        [[ -n "$d" && -f "${d}/x64/d3d12.dll" ]] && echo "$d" && return
    done
}

install_vkd3d() {
    local vkd3d_dir
    vkd3d_dir=$(find_vkd3d_dir)
    [[ -n "$vkd3d_dir" ]] || return 0
    link_dll_set "$vkd3d_dir" x64 x86 "${1:-$WINEPOINT}" d3d12 d3d12core
}

# d7vk (DirectDraw → Vulkan, 32 bits uniquement), comme dxvk_install() de
# batocera-wine avec son option d7vk : ddraw.dll → d7vk, et le ddraw intégré
# de Wine exposé en ddraw_.dll. Sans lui, un jeu DirectDraw passe par
# l'OpenGL de wined3d, soit llvmpipe (rendu logiciel) sous Xwayland + NVIDIA.
find_d7vk() {
    local f
    for f in "${WSQUASHFS_D7VK_DLL:-}" /usr/share/d7vk/x32/ddraw.dll \
             "$HOME/.local/share/wsquashfs/d7vk/x32/ddraw.dll"; do
        [[ -n "$f" && -f "$f" ]] && echo "$f" && return
    done
}

install_d7vk() {
    local target_root="${1:-$WINEPOINT}" d7 wine_root builtin="" c sub=syswow64
    d7=$(find_d7vk)
    [[ -n "$d7" ]] || return 0
    [[ "$WINE_ARCH" == "win32" ]] && sub=system32
    wine_root=$(runner_root "$WINE_BINARY")
    for c in "${wine_root}/lib/wine/i386-windows/ddraw.dll" \
             "${wine_root}/lib32/wine/i386-windows/ddraw.dll" \
             /usr/lib/wine/i386-windows/ddraw.dll; do
        [[ -f "$c" ]] && { builtin="$c"; break; }
    done
    mkdir -p "${target_root}/drive_c/windows/${sub}" 2>/dev/null || true
    ln -sfn "$d7" "${target_root}/drive_c/windows/${sub}/ddraw.dll" 2>/dev/null || true
    if [[ -n "$builtin" ]]; then
        ln -sfn "$builtin" "${target_root}/drive_c/windows/${sub}/ddraw_.dll" 2>/dev/null || true
    fi
}

# DLL du runner + DXVK/VKD3D/d7vk selon les réglages, dans <racine cible>.
link_runtime_dlls() {
    local target_root="$1"
    sync_wine_stubs "$WINE_BINARY" "$target_root"
    [[ "$DXVK" == "1" ]] && install_dxvk "$target_root"
    [[ "$VKD3D" == "1" ]] && install_vkd3d "$target_root"
    [[ "$D7VK" == "1" ]] && install_d7vk "$target_root"
    return 0
}

# ── Mise à jour du prefix ──────────────────────────────────────────────

# Mise à jour du prefix au changement de runner, comme createOrUpdatePrefix()
# de batocera-wine : Wine met le prefix à jour quand .update-timestamp ne
# correspond plus à son wine.inf, et échouait alors sur les liens DLL déjà en
# place (liens DXVK des prefixes Batocera, cassés ici) — "create_dest_file
# failed ... (error=80)" pour chaque DLL. Les liens de system32/syswow64 sont
# retirés AVANT la mise à jour, puis recréés par link_runtime_dlls.
update_prefix_if_needed() {
    local wine_root inf ts stamp
    [[ -f "${WINEPOINT}/system.reg" ]] || return 0
    wine_root=$(runner_root "$WINE_BINARY")
    inf="${wine_root}/share/wine/wine.inf"
    [[ -f "$inf" ]] || return 0
    ts=$(stat -c %Y "$inf")
    # Wine écrit ce fichier en fin de ligne Windows ("1790165633\r\n") : sans
    # retirer le \r, la comparaison échouait toujours et wineboot -u tournait
    # à CHAQUE lancement (~70 s, ~725 DLL réécrites dans les saves — 25/09).
    stamp=$(head -n1 "${WINEPOINT}/.update-timestamp" 2>/dev/null | tr -d '\r')
    [[ "$stamp" == "disable" || "$stamp" == "$ts" ]] && return 0
    echo "Préfixe       : mise à jour pour $("$WINE_BINARY" --version 2>/dev/null || basename "$wine_root")"
    find "${WINEPOINT}/drive_c/windows/system32" "${WINEPOINT}/drive_c/windows/syswow64" \
        -maxdepth 1 -type l -delete 2>/dev/null || true
    run_wineboot_update "-all" >/dev/null 2>&1 || true
    run_wineserver "$WINEPOINT" -w || true
    # wineboot -u vient d'écrire ~1 600 DLL (~500 Mo) dans l'upperdir : les
    # retirer tout de suite, sync_wine_stubs les remplace par des liens (25/09 :
    # 8 jeux, +4,5 Go après un premier lancement). Prefix packagé seulement :
    # pour un jeu seul, ce system32 EST le prefix.
    # Rechargement obligatoire (27/09) : sans lui, fuse-overlayfs gardait sa
    # vue d'avant l'effacement, sync_wine_stubs croyait absentes les DLL
    # natives du jeu (d3dx9_42, mscoree...) et les remplaçait par des liens
    # Wine — "d3dx9_42.dll not found" au premier lancement après chaque
    # changement de Wine (Virtua Tennis 4).
    if [[ "$MOUNT_MODE" == "overlay" && "$PACKAGED_PREFIX" == "1" ]]; then
        rm -rf "${SAVEPOINT}/drive_c/windows/system32" \
               "${SAVEPOINT}/drive_c/windows/syswow64" 2>/dev/null || true
        reload_overlay "après mise à jour du préfixe"
    fi
}

# Comme sandboxing_prefix() de batocera-wine : les dossiers du profil Wine
# (Documents, Music...) sont packagés en liens vers /userdata/system,
# inexistant ici — un jeu qui sauvegarde dans "Mes documents" échouait.
# Remplacés par de vrais dossiers (dans l'upperdir en overlay : les
# sauvegardes y persistent).
fix_userdata_links() {
    local link
    while IFS= read -r -d '' link; do
        rm -f "$link" && mkdir -p "$link"
    done < <(find "${WINEPOINT}/drive_c/users" -maxdepth 6 -type l -lname '/userdata*' -print0 2>/dev/null)
}

# ── Sauvegardes Batocera (SAVEDIR / SAVEFILES) ─────────────────────────

# SAVEDIR / SAVEFILES de l'autorun.cmd, comme saveFilesToUserdata() de
# batocera-wine : le dossier (ou les fichiers) de sauvegarde du jeu sont
# remplacés par des liens vers <racine>/saves/<système>/<jeu>, à côté du
# dossier roms/ — l'emplacement des sauvegardes Batocera. Différence : la
# copie initiale des sauvegardes packagées n'écrase JAMAIS une sauvegarde
# déjà présente (cp -n), là où Batocera peut les remplacer si le prefix est
# recréé.
batocera_saves_dir() {
    local rom_dir sys root
    if [[ -n "${WSQUASHFS_BATOCERA_SAVES:-}" ]]; then
        echo "${WSQUASHFS_BATOCERA_SAVES}/${GAME_NAME}"
        return
    fi
    rom_dir=$(dirname "$WSQUASHFS_FILE")
    sys=$(basename "$rom_dir")
    root=$(dirname "$(dirname "$rom_dir")")
    [[ "$(basename "$(dirname "$rom_dir")")" == "roms" ]] || return 1
    echo "${root}/saves/${sys}/${GAME_NAME}"
}

apply_savedir() {
    local savedir="${1//\\//}" savefiles="$2" sysdir parent base f files=()
    [[ -n "$savedir$savefiles" ]] || return 0
    if ! sysdir=$(batocera_saves_dir); then
        warn "SAVEDIR/SAVEFILES ignorés (jeu hors d'un dossier roms/<système>/ ;" \
             "  définir WSQUASHFS_BATOCERA_SAVES)"
        return 0
    fi
    mkdir -p "$sysdir"
    if [[ -n "$savedir" ]]; then
        parent="${WINEPOINT}/$(dirname "$savedir")"
        base=$(basename "$savedir")
        mkdir -p "$parent"
        if [[ -d "${parent}/${base}" && ! -L "${parent}/${base}" ]]; then
            cp -an "${parent}/${base}/." "$sysdir/" 2>/dev/null || true
            rm -rf "${parent:?}/${base:?}"
        fi
        [[ -L "${parent}/${base}" ]] || ln -s "$sysdir" "${parent}/${base}"
    else
        IFS=';' read -r -a files <<< "$savefiles"
        for f in "${files[@]}"; do
            f="${f//\\//}"
            [[ -n "$f" ]] || continue
            mkdir -p "$(dirname "${sysdir}/${f}")" "$(dirname "${WINEPOINT}/${f}")"
            if [[ -e "${WINEPOINT}/${f}" && ! -L "${WINEPOINT}/${f}" ]]; then
                [[ -e "${sysdir}/${f}" ]] || mv -f "${WINEPOINT}/${f}" "${sysdir}/${f}"
                rm -f "${WINEPOINT}/${f}"
            fi
            ln -sfn "${sysdir}/${f}" "${WINEPOINT}/${f}"
        done
    fi
    chown_to_target "$sysdir"
    echo "Sauvegardes   : ${sysdir} (SAVEDIR/SAVEFILES)"
}

# ════════════════════════════════════════════════════════════════════════
# 7. MANETTES
# ════════════════════════════════════════════════════════════════════════

# Manettes Sony (DualShock 4, DualSense) utilisables par hidraw : avec
# "DisableHidraw"=0, winebus les réserve à son backend hidraw et SDL les
# ignore — un /dev/hidrawN illisible laisserait le jeu SANS manette. Vrai
# s'il y en a au moins une et que tous leurs nœuds sont lisibles ; raison de
# l'échec dans HIDRAW_REASON.
hidraw_usable() {
    local u n found=0
    for u in "${HIDRAW_SYSFS:-/sys/class/hidraw}"/*/device/uevent; do
        grep -qs '^HID_ID=[0-9A-Fa-f]*:0000054C:' "$u" || continue
        n=$(basename "$(dirname "$(dirname "$u")")")
        found=1
        if [[ ! -r "/dev/${n}" ]]; then
            HIDRAW_REASON="/dev/${n} illisible"
            return 1
        fi
    done
    [[ "$found" == 1 ]] || { HIDRAW_REASON="aucune manette Sony"; return 1; }
}

# dualsense-usb-bridge : dans le PATH, sinon à côté du lanceur (dépôt).
find_dualsense_bridge() {
    local bridge
    bridge=$(command -v dualsense-usb-bridge) \
        || bridge="$(dirname "$(readlink -f "$0")")/tools/dualsense-usb-bridge/dualsense-usb-bridge"
    [[ -x "$bridge" ]] && echo "$bridge"
    return 0
}

# DualSense Bluetooth (Sunshine) présentée en DualSense USB pendant le jeu,
# l'originale masquée à Wine (voir configure_controllers). Faux s'il n'y a
# pas de DualSense Bluetooth (une DualSense USB passe en direct) ou pas de
# pont.
start_dualsense_bridge() {
    local bridge ready i
    grep -qsx 'HID_ID=0005:0000054C:00000CE6' "${HIDRAW_SYSFS:-/sys/class/hidraw}"/*/device/uevent || return 1
    bridge=$(find_dualsense_bridge)
    if [[ -z "$bridge" ]]; then
        warn "dualsense-usb-bridge introuvable, DualSense Bluetooth en direct"
        return 1
    fi
    ready=$(mktemp -u "${TMPDIR:-/tmp}/dualsense-usb-bridge.XXXXXX")
    without_lock "$bridge" --hide --parent $$ --ready-file "$ready" &
    DS_BRIDGE_PID=$!
    for ((i = 0; i < 30; i++)); do
        [[ -e "$ready" ]] && { rm -f "$ready"; return 0; }
        kill -0 "$DS_BRIDGE_PID" 2>/dev/null || break
        sleep 0.1
    done
    stop_dualsense_bridge
    rm -f "$ready"
    return 1
}

stop_dualsense_bridge() {
    [[ -n "$DS_BRIDGE_PID" ]] || return 0
    kill "$DS_BRIDGE_PID" 2>/dev/null
    wait "$DS_BRIDGE_PID" 2>/dev/null
    DS_BRIDGE_PID=""
}

